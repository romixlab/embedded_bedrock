MEMORY
{
  FLASH : ORIGIN = 0x08000000, LENGTH = 256K
  BOOTLOADER_STATE : ORIGIN = 0x08020000, LENGTH = 4K
  BOOTLOADER_DFU : ORIGIN = 0x08021000, LENGTH = 64K
  RAM : ORIGIN = 0x20000000, LENGTH = 144K
}

__bootloader_state_start = ORIGIN(BOOTLOADER_STATE) - ORIGIN(FLASH);
__bootloader_state_end = ORIGIN(BOOTLOADER_STATE) + LENGTH(BOOTLOADER_STATE) - ORIGIN(FLASH);
__bootloader_dfu_start = ORIGIN(BOOTLOADER_DFU);
__bootloader_dfu_end = ORIGIN(BOOTLOADER_DFU) + LENGTH(BOOTLOADER_DFU);
