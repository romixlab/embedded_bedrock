{% set T = s.client_type %}
{% set C = s.client %}
{% set E = s.env %}
{% set d = s.dev %}
{% set decode = d.counters or d.log %}
{% set elf = ww.rtt or decode %}
{% set uses = feats("BootTarget" if d.boot else "", "Brightness" if s.leds else "", "can" if s.can else "", "CounterBuffer" if d.counters else "", "Error", "Mode" if s.leds else "", T,
                    "PROBE_RS_CHIP" if ww.rtt else "", "Probe" if ww.rtt else "", "USB_ID" if ww.usb else "",
                    "Usb" if ww.usb else "", "api_line", "board_line" if d.board else "", "clock_line" if s.clock else "", "firmware_line",
                    "node_lines" if d.dfu else "", "reset_lines" if d.last_reset else "") %}
{% set about = feats("the LED", "the firmware", "the board" if d.board else "", "its label" if d.label else "",
                     ("counters and log" if d.log else "counters") if d.counters else ("its log" if d.log else ""),
                     "settings" if d.settings else "", "the last reset" if d.last_reset else "",
                     "reboots into the ROM bootloader" if d.boot else "", "the CAN channels" if s.can else "") %}
{% filter rewrap("//! ") %}
//! `{{ s.cli }}`: the command line over `{{ C }}`. Argument parsing and printing live here, everything that talks to the board is the library's.
//!
//! Shell completion, with the serials of the {{ "probes" if ww.rtt else "boards" }} attached right now: `source <(COMPLETE=bash {{ s.cli }})` in `~/.bashrc`, `COMPLETE=zsh {{ s.cli }}`, `COMPLETE=fish {{ s.cli }} | source`.
{% endfilter %}

{% if elf %}
use std::ffi::OsStr;
{% endif %}
use std::io::IsTerminal;
{% if elf %}
use std::path::PathBuf;
{% endif %}
use std::process::ExitCode;
use std::time::Duration;

use anstream::println;
use anstyle::{AnsiColor, Color, Style};
use clap::{CommandFactory, Parser, Subcommand};
{% if elf %}
use clap_complete::engine::{ArgValueCandidates, ArgValueCompleter, PathCompleter, ValueCompleter};
{% else %}
use clap_complete::engine::ArgValueCandidates;
{% endif %}
use clap_complete::{CompleteEnv, CompletionCandidate};
use indicatif::{ProgressBar, ProgressStyle};
{{ C | rust_use(uses) }}
{% if ww.usb %}
use nusb::MaybeFuture;
{% endif %}

/// `--version`: `0.1.0 (a1b2c3d-dirty, built 23 Oct 2026 10:20 UTC)`, stamped by `build.rs`.
const VERSION: &str = concat!(
    env!("CARGO_PKG_VERSION"),
    " (",
    env!("{{ E }}_GIT"),
    ", built ",
    env!("{{ E }}_BUILT"),
    ")"
);

const BOLD: Style = Style::new().bold();
const DIM: Style = Style::new().dimmed();
const GREEN: Style = Style::new().fg_color(Some(Color::Ansi(AnsiColor::Green)));
const YELLOW: Style = Style::new().fg_color(Some(Color::Ansi(AnsiColor::Yellow)));
const RED: Style = Style::new().fg_color(Some(Color::Ansi(AnsiColor::Red)));

{% filter rewrap("/// ") %}
/// {{ s.title }} over its {{ "debug probe" if ww.rtt else "USB" }}: {{ about | join(", ") }}.
{% endfilter %}
#[derive(Parser)]
#[command(
    name = "{{ s.cli }}",
    version = VERSION,
    after_help = "Shell completion: source <(COMPLETE=bash {{ s.cli }}), COMPLETE=zsh {{ s.cli }}, COMPLETE=fish {{ s.cli }} | source"
)]
struct Cli {
{% if ww.rtt %}
{% filter rewrap("    /// ") %}
    /// The debug probe: a serial number (or a part of it) of {{ s.probe_kind_a }}, or VID:PID[:SERIAL] as probe-rs takes it (default: the only {{ s.probe_kind }} attached, USB id {{ s.probe }}; never another probe)
{% endfilter %}
    #[arg(short, long, env = "{{ s.probe_env }}", global = true, value_name = "PROBE", add = ArgValueCandidates::new(probe_serials))]
    probe: Option<String>,
    /// probe-rs chip name of the MCU on the board
    #[arg(long, env = "{{ E }}_CHIP", global = true, default_value = PROBE_RS_CHIP)]
    chip: String,
{% filter rewrap("    /// ") %}
    /// The firmware's ELF, for a fast attach (the RTT control block address is read from it instead of scanning the RAM, about 1.5 s through an ST-LINK){{ " and to decode " ~ (feats("counters" if d.counters else "", "the log" if d.log else "") | and_join) ~ " (default for those: the ELF of the board's build id, from target/ or what `ww elf add` keeps)" if decode else "" }}
{% endfilter %}
    #[arg(long, env = "{{ s.elf_env }}", global = true, value_name = "FILE", add = ArgValueCompleter::new(elf_files))]
    elf: Option<PathBuf>,
    /// SWD clock in Hz (default: the probe's)
    #[arg(long, global = true, value_name = "HZ")]
    speed_hz: Option<u32>,
{% else %}
{% filter rewrap("    /// ") %}
    /// The board on USB: a serial number (or a part of it), or VID:PID[:SERIAL] (default: the only board with the firmware's USB id, {{ "%04x:%04x" | format(*s.usb_id) }}, that serves this API)
{% endfilter %}
    #[arg(short, long, env = "{{ E }}_DEVICE", global = true, value_name = "DEVICE", add = ArgValueCandidates::new(usb_serials))]
    device: Option<String>,
{% if decode %}
{% filter rewrap("    /// ") %}
    /// The firmware's ELF, to decode {{ feats("counters" if d.counters else "", "the log" if d.log else "") | and_join }} (default: the ELF of the board's build id, from target/ or what `ww elf add` keeps)
{% endfilter %}
    #[arg(long, env = "{{ s.elf_env }}", global = true, value_name = "FILE", add = ArgValueCompleter::new(elf_files))]
    elf: Option<PathBuf>,
{% endif %}
{% endif %}
    #[command(subcommand)]
    command: Cmd,
}

#[derive(Subcommand)]
enum Cmd {
{% if ww.rtt %}
    /// List the debug probes attached to this PC
    Probes,
{% else %}
    /// List the boards on USB with the firmware's USB id
    Devices,
{% endif %}
    /// {{ feats("Firmware", "API", "board" if d.board else "", "ids" if d.uid else "", "chip" if d.variant else "", "label" if d.label else "", "last reset" if d.last_reset else "") | and_join }} of the board
    Info,
    /// The running firmware: name, version, git commit, build time and profile, build id
    Firmware,
{% if d.board %}
    /// Board name, revision and serial number
    Board,
{% endif %}
{% if d.uid %}
    /// The board's unique ids ({{ s.uid_desc }})
    Uid,
{% endif %}
{% if d.variant %}
{% if s.variant.kind == "rp" %}
    /// The chip on the board: part, silicon revision{{ ", package" if s.variant.package else "" }}
{% else %}
    /// The chip on the board: device id, silicon revision, flash size
{% endif %}
    Variant,
{% endif %}
{% if d.counters %}
    /// The firmware's cnt counters{{ " (RAM and backup registers)" if o.bkp else "" }}, decoded with its ELF
    Counters {
        /// Zero the counters of a buffer afterwards
        #[arg(long, value_name = "BUFFER")]
        reset: Option<Buffer>,
        /// Use --elf although its build id differs from the board's
        #[arg(long)]
        force: bool,
    },
{% endif %}
{% if d.log %}
    /// The defmt log the board keeps (since boot, and from before a crash), decoded with its ELF
    Log {
        /// Keep printing new lines as they are logged (Ctrl-C stops)
        #[arg(short, long)]
        follow: bool,
        /// Use --elf although its build id differs from the board's
        #[arg(long)]
        force: bool,
    },
{% endif %}
{% if d.settings %}
    /// Settings kept in the board's flash
    #[command(subcommand)]
    Settings(SettingsCmd),
{% endif %}
{% if d.boot %}
    /// Boot state, and reboots into the firmware or {{ s.boot.rom }}
    #[command(subcommand)]
    Boot(BootCmd),
{% endif %}
{% if d.dfu %}
    /// The update node: product, profile, boot state, last result
    Dfu,
{% endif %}
{% filter rewrap("    /// ") %}
    /// Everything of the device contract in one text, for a bug report: {{ feats("firmware", "board" if d.board else "", "ids" if d.uid else "", "label" if d.label else "", "last reset with the crash's addresses named" if d.last_reset else "", "counters" if d.counters else "", "the stored log" if d.log else "") | join(", ") }}
{% endfilter %}
{% if decode %}
    Report {
        /// Use --elf although its build id differs from the board's
        #[arg(long)]
        force: bool,
    },
{% else %}
    Report,
{% endif %}
    /// The user LED{{ (" (" ~ s.led_name ~ ")") if s.led_name else "" }}{{ ": solid on, off, blinked from the PC" if s.leds else "" }}
    #[command(subcommand)]
    Led(LedCmd),
{% if s.leds %}
    /// {{ s.led.Name }}'s indication: mode, brightness, identify ({{ s.led.name }} breathes by default)
    #[command(subcommand)]
    Leds(LedsCmd),
{% endif %}
{% if s.clock %}
    /// The board's clock against this PC's UTC: the connection steers it, this waits for the lock and prints the
    /// residual (the board's shared time minus UTC) and the round trip it is known to
    Clock {
        /// Keep checking every second for this many seconds
        #[arg(short, long, value_name = "SECONDS", default_value_t = 0)]
        watch: u64,
        /// Give up waiting for the lock after this many seconds
        #[arg(long, value_name = "SECONDS", default_value_t = 30)]
        timeout: u64,
    },
{% endif %}
{% if s.can %}
    /// The CAN channels ({% for ch in s.can.chans %}{{ ch.index }}: {{ ch.instance }}{{ ", " if not loop.last }}{% endfor %}): configure, status, send frames, dump what comes in
    #[command(subcommand)]
    Can(CanCmd),
{% endif %}
{% if d.label %}
    /// Show the board's label, or store a new one (kept in the board's flash)
    Label {
        /// The new label, at most 32 bytes
        name: Option<String>,
    },
{% endif %}
{% if d.last_reset %}
    /// Why the board last reset, with the crash record after a fault or panic
    LastReset {
        /// Forget the record and zero the boot counter afterwards
        #[arg(long)]
        clear: bool,
    },
{% endif %}
}
{% if d.settings %}

#[derive(Subcommand)]
enum SettingsCmd {
{% if s.led_at_boot %}
    /// Show every setting
    Show,
    /// The LED after boot: on or off
    LedAtBoot { state: OnOff },
{% endif %}
    /// Every setting back to its default{{ ", the label too" if d.label else "" }}
    Reset,
}
{% endif %}
{% if d.boot %}

#[derive(Subcommand)]
enum BootCmd {
    /// The boot state (always confirmed: the firmware is the only image)
    State,
{% if s.boot.kind == "rp" %}
    /// Reset the board into the firmware, or into BOOTSEL with --updater (the boot ROM's PICOBOOT and USB mass
    /// storage; `ww dfu rp flash` or `just flash` brings the firmware back)
{% else %}
    /// Reset the board into the firmware, or into the STM32 ROM bootloader with --updater ({{ s.boot.via }};
    /// `just flash` brings the firmware back through the probe)
{% endif %}
    Reboot {
        #[arg(long)]
        updater: bool,
    },
}
{% endif %}
{% if s.led_at_boot %}

#[derive(Clone, Copy, clap::ValueEnum)]
enum OnOff {
    On,
    Off,
}
{% endif %}
{% if d.counters %}

/// A counter buffer of the firmware
#[derive(Clone, Copy, clap::ValueEnum)]
enum Buffer {
    /// The RAM counters (zeroed by every reset)
    Ram,
{% if o.bkp %}
    /// The counters in the backup registers (kept across resets, not power cuts)
    Bkp,
{% endif %}
}
{% endif %}

#[derive(Subcommand)]
enum LedCmd {
    /// Switch the LED on
    On,
    /// Switch the LED off
    Off,
    /// Blink the LED a few times
    Blink {
        /// How many times
        #[arg(short = 'n', long, default_value_t = 3)]
        count: u32,
        /// One on-off cycle, in milliseconds
        #[arg(long, default_value_t = 500, value_name = "MS")]
        period: u64,
    },
}
{% if s.leds %}

#[derive(Subcommand)]
enum LedsCmd {
    /// Show mode and brightness
    Show,
    /// Global mode: normal shows {{ s.led.name }}, essential and off hide it
    Mode { mode: LedsMode },
    /// Peak brightness
    Brightness { level: Level },
    /// Blink {{ s.led.name }} at full brightness to find the board, then back to its mode
    Identify {
        /// How long, in seconds
        #[arg(default_value_t = 5)]
        seconds: u32,
    },
}

#[derive(Clone, Copy, clap::ValueEnum)]
enum LedsMode {
    Normal,
    Essential,
    Off,
}

#[derive(Clone, Copy, clap::ValueEnum)]
enum Level {
    Lowest,
    Low,
    Normal,
    High,
    Highest,
}
{% endif %}
{% if s.can %}

#[derive(Subcommand)]
enum CanCmd {
    /// Configuration, error state and protocol state of a channel
    Status {
        #[command(flatten)]
        channel: CanChannel,
    },
    /// Configure a channel from bit rates (classic CAN, or CAN FD with --fd-rate)
    Configure {
        #[command(flatten)]
        channel: CanChannel,
        /// Nominal bit rate: 500000, 500k, 1M
        #[arg(long, default_value = "500k")]
        rate: String,
        /// Nominal sample point in percent
        #[arg(long, default_value = "87.5", value_name = "PERCENT")]
        sample_point: String,
        /// CAN FD with this data-phase bit rate (sampled at 75 %): 2M, 5M
        #[arg(long, value_name = "RATE")]
        fd_rate: Option<String>,
        /// internal-loopback: frames sent come back on the receive stream, nothing goes on the bus
        #[arg(long, value_enum, default_value_t = CanMode::Normal)]
        mode: CanMode,
    },
    /// Send frames, in cansend syntax: 123#DEADBEEF, 1F334455#11 (extended), 123#R (remote), 123##1AABB (CAN FD,
    /// flags 1: bit rate switch)
    Send {
        #[command(flatten)]
        channel: CanChannel,
        #[arg(required = true, value_name = "FRAME")]
        frames: Vec<String>,
    },
    /// Print received frames as candump -L lines (device time, channel, frame) until Ctrl-C
    Dump {
        #[command(flatten)]
        channel: CanChannel,
        /// Stop after this many frames
        #[arg(short = 'n', long)]
        count: Option<u64>,
    },
}

#[derive(clap::Args)]
struct CanChannel {
    /// The channel, its index in can[]
    #[arg(short, long, default_value_t = 0, value_parser = clap::value_parser!(u32).range(0..{{ s.can.count }}), add = ArgValueCandidates::new(can_channels))]
    index: u32,
}

#[derive(Clone, Copy, clap::ValueEnum)]
enum CanMode {
    Normal,
    ListenOnly,
    Restricted,
    InternalLoopback,
    ExternalLoopback,
}

impl From<CanMode> for can::Mode {
    fn from(m: CanMode) -> can::Mode {
        match m {
            CanMode::Normal => can::Mode::Normal,
            CanMode::ListenOnly => can::Mode::ListenOnly,
            CanMode::Restricted => can::Mode::Restricted,
            CanMode::InternalLoopback => can::Mode::InternalLoopback,
            CanMode::ExternalLoopback => can::Mode::ExternalLoopback,
        }
    }
}

/// The channels for `--index`, the FDCAN instance as help.
fn can_channels() -> Vec<CompletionCandidate> {
    can::CHANNELS
        .iter()
        .map(|(i, name)| CompletionCandidate::new(i.to_string()).help(Some((*name).into())))
        .collect()
}
{% endif %}
{% if ww.rtt %}

/// Serials of the attached probes for `--probe`, the probe's name as help; empty on any error.
fn probe_serials() -> Vec<CompletionCandidate> {
    probe_rs::probe::list::Lister::new()
        .list_all()
        .into_iter()
        .filter_map(|p| {
            let serial = p.serial_number.clone()?;
            Some(CompletionCandidate::new(serial).help(Some(p.identifier.clone().into())))
        })
        .collect()
}
{% else %}

/// The USB devices with the firmware's USB id ([USB_ID]); empty on any error.
fn usb_devices() -> Vec<nusb::DeviceInfo> {
    nusb::list_devices()
        .wait()
        .map(|list| {
            list.filter(|d| (d.vendor_id(), d.product_id()) == USB_ID)
                .collect()
        })
        .unwrap_or_default()
}

/// Serials of the boards on USB for `--device`, the product name as help.
fn usb_serials() -> Vec<CompletionCandidate> {
    usb_devices()
        .into_iter()
        .filter_map(|d| {
            let serial = d.serial_number()?.to_string();
            let product = d.product_string().unwrap_or("").to_string();
            Some(CompletionCandidate::new(serial).help(Some(product.into())))
        })
        .collect()
}
{% endif %}
{% if elf %}

/// Firmware ELF files for `--elf`: directories to walk into, files without an extension (cargo's output) or `.elf`.
fn elf_files(current: &OsStr) -> Vec<CompletionCandidate> {
    PathCompleter::file()
        .filter(|path| {
            path.is_dir()
                || path
                    .extension()
                    .is_none_or(|ext| ext.eq_ignore_ascii_case("elf"))
        })
        .complete(current)
}
{% endif %}

impl Cli {
{% if ww.rtt %}
    /// The probe of `--probe` (or `{{ s.probe_env }}`, the same the recipes use), else any {{ s.probe_kind }}.
    fn probe(&self) -> anyhow::Result<Probe> {
        let probe = Probe {
            chip: self.chip.clone(),
            speed_hz: self.speed_hz,
            elf: self.elf.clone(),
            ..Probe::default()
        };
        Ok(match self.probe.as_deref().filter(|s| !s.is_empty()) {
            Some(spec) => probe.select(spec)?,
            None => probe,
        })
    }
{% else %}
    /// The board of `--device` (or `{{ E }}_DEVICE`), else any board with the firmware's USB id.
    fn usb(&self) -> anyhow::Result<Usb> {
        Ok(match self.device.as_deref().filter(|s| !s.is_empty()) {
            Some(spec) => Usb::default().select(spec)?,
            None => Usb::default(),
        })
    }
{% endif %}
}

{% if ww.rtt %}
/// Connects, with a spinner on stderr while it takes (a RAM scan for the RTT control block is slow on an ST-LINK).
{% else %}
/// Connects, with a spinner on stderr while it takes.
{% endif %}
async fn connect(cli: &Cli) -> anyhow::Result<{{ T }}> {
    let spinner = if std::io::stderr().is_terminal() {
{% if ww.rtt %}
        let s = ProgressBar::new_spinner().with_message(format!("connecting to {}", cli.chip));
{% else %}
        let s = ProgressBar::new_spinner().with_message("connecting over USB");
{% endif %}
        s.set_style(ProgressStyle::with_template("{spinner} {msg}").expect("template"));
        s.enable_steady_tick(Duration::from_millis(80));
        Some(s)
    } else {
        None
    };
    let result = {{ T }}::connect(&cli.{{ "probe" if ww.rtt else "usb" }}()?).await;
    if let Some(s) = spinner {
        s.finish_and_clear();
    }
    Ok(result?)
}

async fn run(cli: Cli) -> anyhow::Result<()> {
    match &cli.command {
{% if ww.rtt %}
        Cmd::Probes => {
            let probes = probe_rs::probe::list::Lister::new().list_all();
            if probes.is_empty() {
                println!("{YELLOW}no debug probe attached{YELLOW:#}");
            }
            for p in probes {
                let serial = p.serial_number.as_deref().unwrap_or("-");
                println!(
                    "{BOLD}{serial}{BOLD:#}  {}  {DIM}{:04x}:{:04x}{DIM:#}",
                    p.identifier, p.vendor_id, p.product_id
                );
            }
        }
{% else %}
        Cmd::Devices => {
            let devices = usb_devices();
            if devices.is_empty() {
                println!(
                    "{YELLOW}no board on USB with id {:04x}:{:04x}{YELLOW:#}",
                    USB_ID.0, USB_ID.1
                );
            }
            for d in devices {
                let serial = d.serial_number().unwrap_or("-");
                println!(
                    "{BOLD}{serial}{BOLD:#}  {}  {DIM}{:04x}:{:04x}{DIM:#}",
                    d.product_string().unwrap_or(""),
                    d.vendor_id(),
                    d.product_id()
                );
            }
        }
{% endif %}
        Cmd::Info => {
            let board = connect(&cli).await?;
            let info = board.info();
            println!("{BOLD}API{BOLD:#}        {}", api_line(info));
            let fw = board.firmware().await?;
            println!("{BOLD}firmware{BOLD:#}   {}", firmware_line(&fw));
            match board.build_id().await {
                Ok(id) => println!("{BOLD}build id{BOLD:#}   {}", hex(&id)),
                Err(Error::Unimplemented { .. }) => {}
                Err(e) => return Err(e.into()),
            }
{% if d.board %}
            println!(
                "{BOLD}board{BOLD:#}      {}",
                board_line(&board.board().await?)
            );
{% endif %}
{% if d.variant %}
            let v = board.variant().await?;
            println!("{BOLD}chip{BOLD:#}       {}", variant_line(&v));
{% endif %}
{% if d.label %}
            let label = board.label().await?;
            if label.is_empty() {
                println!("{BOLD}label{BOLD:#}      {DIM}(none){DIM:#}");
            } else {
                println!("{BOLD}label{BOLD:#}      {label}");
            }
{% endif %}
{% if d.last_reset %}
            let boots = board.boot_count().await?;
            let reset = board.last_reset().await?;
            for (i, line) in reset_lines(&reset, boots).iter().enumerate() {
                let label = if i == 0 { "last reset" } else { "          " };
                println!("{BOLD}{label}{BOLD:#} {line}");
            }
{% endif %}
            board.disconnect().await;
        }
        Cmd::Led(cmd) => {
            let board = connect(&cli).await?;
            match cmd {
                LedCmd::On => board.led_on().await?,
                LedCmd::Off => board.led_off().await?,
                LedCmd::Blink { count, period } => {
                    board.blink(*count, Duration::from_millis(*period)).await?
                }
            }
            board.disconnect().await;
        }
{% if s.leds %}
        Cmd::Leds(cmd) => {
            let board = connect(&cli).await?;
            match cmd {
                LedsCmd::Show => {
                    println!("mode        {:?}", board.leds_mode().await?);
                    println!("brightness  {:?}", board.brightness().await?);
                }
                LedsCmd::Mode { mode } => {
                    let mode = match mode {
                        LedsMode::Normal => Mode::Normal,
                        LedsMode::Essential => Mode::OnlyEssential,
                        LedsMode::Off => Mode::AllOff,
                    };
                    board.set_leds_mode(mode).await?;
                }
                LedsCmd::Brightness { level } => {
                    let level = match level {
                        Level::Lowest => Brightness::Lowest,
                        Level::Low => Brightness::Low,
                        Level::Normal => Brightness::Normal,
                        Level::High => Brightness::High,
                        Level::Highest => Brightness::Highest,
                    };
                    board.set_brightness(level).await?;
                }
                LedsCmd::Identify { seconds } => {
                    board
                        .identify(Duration::from_secs(u64::from(*seconds)))
                        .await?
                }
            }
            board.disconnect().await;
        }
{% endif %}
{% if s.clock %}
        Cmd::Clock { watch, timeout } => {
            let board = connect(&cli).await?;
            let spinner = std::io::stderr().is_terminal().then(|| {
                let s = ProgressBar::new_spinner().with_message("waiting for the clock to lock");
                s.set_style(ProgressStyle::with_template("{spinner} {msg}").expect("template"));
                s.enable_steady_tick(Duration::from_millis(80));
                s
            });
            let locked = board.wait_clock_locked(Duration::from_secs(*timeout)).await;
            if let Some(s) = spinner {
                s.finish_and_clear();
            }
            locked?;
            let steering = board.clock_steering();
            for i in 0..=*watch {
                if i > 0 {
                    tokio::time::sleep(Duration::from_secs(1)).await;
                }
                let check = board.clock_check().await?;
                let status = steering.as_ref().map(|s| s.status());
                println!("{}", clock_line(&check, status.as_ref()));
            }
            board.disconnect().await;
        }
{% endif %}
{% if s.can %}
        Cmd::Can(cmd) => {
            let board = connect(&cli).await?;
            match cmd {
                CanCmd::Status { channel } => {
                    let i = channel.index;
                    let clock = board.can_capabilities(i).await?.clock.to_f64() as u32;
                    println!("{BOLD}can{i}{BOLD:#}  {}", can::CHANNELS[i as usize].1);
                    let config = board.can_config(i).await?;
                    println!("config    {}", can::config_line(&config, clock));
                    let status = board.can_status(i).await?;
                    println!("status    {}", can::status_line(&status));
                    println!("protocol  {:?}", board.can_protocol_status(i).await?);
                }
                CanCmd::Configure {
                    channel,
                    rate,
                    sample_point,
                    fd_rate,
                    mode,
                } => {
                    let i = channel.index;
                    let rate = can::parse_rate(rate)?;
                    let mut setup = match fd_rate {
                        Some(fd) => can::Setup::fd(rate, can::parse_rate(fd)?),
                        None => can::Setup::classic(rate),
                    };
                    setup.sample_point = can::parse_sample_point(sample_point)?;
                    setup.mode = (*mode).into();
                    let set = board.can_setup(i, &setup).await?;
                    let clock = board.can_capabilities(i).await?.clock.to_f64() as u32;
                    println!("{GREEN}can{i}{GREEN:#}  {}", can::config_line(&set, clock));
                }
                CanCmd::Send { channel, frames } => {
                    let frames = frames
                        .iter()
                        .map(|f| {
                            can::frame_text::parse(f).map_err(|e| anyhow::anyhow!("{f:?}: {e}"))
                        })
                        .collect::<anyhow::Result<Vec<_>>>()?;
                    let mut tx = board.can_tx(channel.index).await?;
                    for f in frames {
                        tx.send(f).await?;
                    }
                    tx.close().await?;
                }
                CanCmd::Dump { channel, count } => {
                    let i = channel.index;
                    let mut rx = board.can_rx(i).await?;
                    let mut seen = 0;
                    // Ctrl-C ends the dump with the stream closed on the board and a clean disconnect
                    while count.is_none_or(|n| seen < n) {
                        tokio::select! {
                            event = rx.recv() => match event? {
                                can::RxEvent::Frame(r) => {
                                    println!("{}", can::rx_line(i, &r));
                                    seen += 1;
                                }
                                can::RxEvent::Lost(n) => println!("{YELLOW}lost {n} frames{YELLOW:#}"),
                            },
                            _ = tokio::signal::ctrl_c() => break,
                        }
                    }
                    rx.close().await?;
                }
            }
            board.disconnect().await;
        }
{% endif %}
{% if d.label %}
        Cmd::Label { name } => {
            let board = connect(&cli).await?;
            match name {
                Some(name) => {
                    board.set_label(name).await?;
                    println!("{GREEN}label stored{GREEN:#}: {name}");
                }
                None => match board.label().await?.as_str() {
                    "" => println!("{DIM}(none){DIM:#}"),
                    label => println!("{label}"),
                },
            }
            board.disconnect().await;
        }
{% endif %}
        Cmd::Firmware => {
            let board = connect(&cli).await?;
            println!("{}", firmware_line(&board.firmware().await?));
            println!("{DIM}build id {}{DIM:#}", hex(&board.build_id().await?));
            board.disconnect().await;
        }
{% if d.board %}
        Cmd::Board => {
            let board = connect(&cli).await?;
            println!("{}", board_line(&board.board().await?));
            board.disconnect().await;
        }
{% endif %}
{% if d.uid %}
        Cmd::Uid => {
            let board = connect(&cli).await?;
            for id in board.uid().await? {
                println!(
                    "{}  {DIM}{:?}, {:?}{DIM:#}",
                    hex(id.value.as_slice()),
                    id.kind,
                    id.source
                );
            }
            board.disconnect().await;
        }
{% endif %}
{% if d.variant %}
        Cmd::Variant => {
            let board = connect(&cli).await?;
            println!("{}", variant_line(&board.variant().await?));
            board.disconnect().await;
        }
{% endif %}
{% if d.counters %}
        Cmd::Counters { reset, force } => {
            let board = connect(&cli).await?;
            let report = board.counters(cli.elf.as_deref(), *force).await?;
            if report.counters.is_empty() {
                println!("{DIM}no counters{DIM:#}");
            }
            for c in &report.counters {
                let style = match c.severity.as_str() {
                    "error" => RED,
                    "warn" => YELLOW,
                    _ => Style::new(),
                };
                println!(
                    "{DIM}{}{DIM:#}  {style}{}{style:#} = {BOLD}{}{BOLD:#} {}",
                    c.buffer, c.name, c.value, c.unit
                );
            }
            println!("{DIM}decoded with {}{DIM:#}", report.elf);
            if let Some(buffer) = reset {
                let (buffer, name) = match buffer {
                    Buffer::Ram => (CounterBuffer::Ram, "RAM"),
{% if o.bkp %}
                    Buffer::Bkp => (CounterBuffer::Backup, "BKP"),
{% endif %}
                };
                board.reset_counters(buffer).await?;
                println!("{GREEN}{name} counters zeroed{GREEN:#}");
            }
            board.disconnect().await;
        }
{% endif %}
{% if d.log %}
        Cmd::Log { follow, force } => {
            let board = connect(&cli).await?;
            if *follow {
                // Ctrl-C ends the follow with a clean disconnect; the board keeps the log for the next reader
                tokio::select! {
                    result = board.follow_log(cli.elf.as_deref(), *force, |line| println!("{line}")) => result?,
                    _ = tokio::signal::ctrl_c() => {}
                }
                board.disconnect().await;
            } else {
                let report = board.log(cli.elf.as_deref(), *force).await?;
                for line in &report.lines {
                    println!("{line}");
                }
                board.disconnect().await;
            }
        }
{% endif %}
{% if d.settings %}
        Cmd::Settings(cmd) => {
            let board = connect(&cli).await?;
            match cmd {
{% if s.led_at_boot %}
                SettingsCmd::Show => {
                    let on = board.led_at_boot().await?;
                    println!("led-at-boot  {}", if on { "on" } else { "off" });
                }
                SettingsCmd::LedAtBoot { state } => {
                    board.set_led_at_boot(matches!(state, OnOff::On)).await?;
                    println!("{GREEN}stored{GREEN:#}");
                }
{% endif %}
                SettingsCmd::Reset => {
                    board.reset_settings().await?;
                    println!("{GREEN}settings back to their defaults{GREEN:#}");
                }
            }
            board.disconnect().await;
        }
{% endif %}
{% if d.boot %}
        Cmd::Boot(cmd) => {
            let board = connect(&cli).await?;
            match cmd {
                BootCmd::State => println!("{:?}", board.boot_state().await?),
                BootCmd::Reboot { updater } => {
                    let into = if *updater {
                        BootTarget::Updater
                    } else {
                        BootTarget::App
                    };
                    board.reboot(into).await?;
                    if *updater {
                        println!(
                            "{GREEN}rebooting into {{ s.boot.rom }}{GREEN:#} {DIM}({{ s.boot.via }}; {{ s.boot.back }}){DIM:#}"
                        );
                    } else {
                        println!("{GREEN}rebooting{GREEN:#}");
                    }
                }
            }
            board.disconnect().await;
        }
{% endif %}
{% if d.dfu %}
        Cmd::Dfu => {
            let board = connect(&cli).await?;
            for line in node_lines(&board.dfu_node().await?) {
                println!("{line}");
            }
            board.disconnect().await;
        }
{% endif %}
{% if decode %}
        Cmd::Report { force } => {
            let board = connect(&cli).await?;
            println!("{}", board.report(cli.elf.clone(), *force).await);
            board.disconnect().await;
        }
{% else %}
        Cmd::Report => {
            let board = connect(&cli).await?;
            println!("{}", board.report({{ "cli.elf.clone()" if elf else "None" }}, false).await);
            board.disconnect().await;
        }
{% endif %}
{% if d.last_reset %}
        Cmd::LastReset { clear } => {
            let board = connect(&cli).await?;
            let boots = board.boot_count().await?;
            let reset = board.last_reset().await?;
            for line in reset_lines(&reset, boots) {
                println!("{line}");
            }
            if *clear {
                board.clear_last_reset().await?;
                println!("{GREEN}cleared{GREEN:#}");
            }
            board.disconnect().await;
        }
{% endif %}
    }
    Ok(())
}
{% if d.variant %}

/// `{{ s.variant_example }}`.
{% if s.variant.kind == "rp" %}
fn variant_line(v: &{{ C }}::Variant) -> String {
    let revision = match v.revision {
{% for r in s.variant.revisions %}
        {{ C }}::SiliconRevision::{{ r[0] }} => "rev {{ r[0] }}",
{% endfor %}
        _ => "unknown revision",
    };
{% if s.variant.package %}
    let package = match v.package {
        {{ C }}::Package::A => "QFN-60 ({{ s.variant.device }}A)",
        {{ C }}::Package::B => "QFN-80 ({{ s.variant.device }}B)",
        _ => "unknown package",
    };
    format!("{{ s.variant.device }} {revision} (bootrom {}), {package}", v.rom_version)
{% else %}
    format!("{{ s.variant.device }} {revision} (bootrom {})", v.rom_version)
{% endif %}
}
{% else %}
fn variant_line(v: &{{ C }}::Variant) -> String {
    let device = match v.dev_id {
        {{ "0x%x" | format(s.variant.dev_id) }} => "{{ s.variant.device }}",
        _ => "unknown device",
    };
    let revision = match v.revision {
{% for r in s.variant.revisions %}
        {{ C }}::SiliconRevision::{{ r[0] }} => "rev {{ r[0] }}".to_string(),
{% endfor %}
        _ => "unknown revision".to_string(),
    };
    format!(
        "{device} ({:#05x}) {revision} ({:#06x}), {} KiB flash",
        v.dev_id, v.rev_id, v.flash_kib
    )
}
{% endif %}
{% endif %}

fn hex(bytes: &[u8]) -> String {
    bytes.iter().map(|b| format!("{b:02x}")).collect()
}

fn main() -> ExitCode {
    CompleteEnv::with_factory(Cli::command).complete();
    let cli = Cli::parse();
    let rt = match tokio::runtime::Runtime::new() {
        Ok(rt) => rt,
        Err(e) => {
            anstream::eprintln!("{RED}error{RED:#}: {e}");
            return ExitCode::FAILURE;
        }
    };
    match rt.block_on(run(cli)) {
        Ok(()) => ExitCode::SUCCESS,
        Err(e) => {
            anstream::eprintln!("{RED}error{RED:#}: {e:#}");
            ExitCode::FAILURE
        }
    }
}
