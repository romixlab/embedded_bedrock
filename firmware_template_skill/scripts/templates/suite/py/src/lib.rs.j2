{% if s.leds %}

{% filter rewrap("    /// ") %}
    /// The global indication mode: "normal" shows {{ s.led.name }}, "essential" and "off" hide it (RAM only, "normal" after a reset).
{% endfilter %}
    #[getter]
    fn leds_mode(&self) -> PyResult<String> {
        let mode = match self.block(self.{{ B }}()?.leds_mode())? {
            Mode::Normal => "normal",
            Mode::OnlyEssential => "essential",
            Mode::AllOff => "off",
            Mode::Unknown(_) => "unknown",
        };
        Ok(mode.to_string())
    }

    #[setter]
    fn set_leds_mode(&self, mode: &str) -> PyResult<()> {
        let mode = match mode {
            "normal" => Mode::Normal,
            "essential" => Mode::OnlyEssential,
            "off" => Mode::AllOff,
            _ => {
                return Err(PyValueError::new_err(
                    "leds_mode is \"normal\", \"essential\" or \"off\"",
                ));
            }
        };
        self.block(self.{{ B }}()?.set_leds_mode(mode))
    }

{% filter rewrap("    /// ") %}
    /// {{ s.led.Name }}'s peak brightness: "lowest", "low", "normal", "high" or "highest" (RAM only, "normal" after a reset).
{% endfilter %}
    #[getter]
    fn brightness(&self) -> PyResult<String> {
        let level = match self.block(self.{{ B }}()?.brightness())? {
            Brightness::Lowest => "lowest",
            Brightness::Low => "low",
            Brightness::Normal => "normal",
            Brightness::High => "high",
            Brightness::Highest => "highest",
            Brightness::Unknown(_) => "unknown",
        };
        Ok(level.to_string())
    }

    #[setter]
    fn set_brightness(&self, level: &str) -> PyResult<()> {
        let level = match level {
            "lowest" => Brightness::Lowest,
            "low" => Brightness::Low,
            "normal" => Brightness::Normal,
            "high" => Brightness::High,
            "highest" => Brightness::Highest,
            _ => {
                return Err(PyValueError::new_err(
                    "brightness is \"lowest\", \"low\", \"normal\", \"high\" or \"highest\"",
                ));
            }
        };
        self.block(self.{{ B }}()?.set_brightness(level))
    }

    /// Blink {{ s.led.name }} at full brightness for `seconds` (up to 600), then show its mode again.
    #[pyo3(signature = (seconds=5.0))]
    fn identify(&self, seconds: f64) -> PyResult<()> {
        let duration = Duration::try_from_secs_f64(seconds)
            .map_err(|e| PyValueError::new_err(format!("identify for {seconds} s: {e}")))?;
        self.block(self.{{ B }}()?.identify(duration))
    }
{% endif %}
{% if s.clock %}

    /// Wait until the connection has steered the board's shared clock onto this PC's UTC (`Locked`), at most
    /// `timeout` seconds; it takes a few seconds after connecting.
    #[pyo3(signature = (timeout=30.0))]
    fn wait_clock_locked(&self, timeout: f64) -> PyResult<()> {
        let timeout = Duration::try_from_secs_f64(timeout)
            .map_err(|e| PyValueError::new_err(format!("timeout {timeout} s: {e}")))?;
        self.block(self.{{ B }}()?.wait_clock_locked(timeout))?;
        Ok(())
    }

    /// One check of the board's shared time against this PC's UTC: `{"state", "source", "residual_us", "rtt_us",
    /// "slew_us", "error_us", "rate_ppm", "fit_rms_us", "line"}`. `residual_us` is the board's shared time minus
    /// UTC at the middle of the round trip, known to within `rtt_us / 2`; `slew_us` the offset the board still
    /// slews in; `rate_ppm` and `fit_rms_us` come from the connection's fit of the board's clock. A value the board
    /// or the connection can't tell yet is `None`.
    fn clock_check<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {
        let board = self.{{ B }}()?;
        let check = self.block(board.clock_check())?;
        let steering = board.clock_steering().map(|s| s.status());
        let fit = steering.as_ref().and_then(|s| s.fit.as_ref());
        let s = &check.status;
        let d = PyDict::new(py);
        d.set_item("state", format!("{:?}", s.state))?;
        d.set_item("source", s.source.as_ref().map(|src| format!("{src:?}")))?;
        d.set_item("residual_us", check.residual_us)?;
        d.set_item("rtt_us", check.rtt_us)?;
        d.set_item("slew_us", s.slew_us)?;
        d.set_item("error_us", s.error.as_ref().map(|e| e.to_f64() * 1e6))?;
        d.set_item("rate_ppm", fit.map(|f| (f.slope - 1.0) * 1e6))?;
        d.set_item("fit_rms_us", fit.map(|f| f.residual_rms / 1e3))?;
        d.set_item("line", clock_line(&check, steering.as_ref()))?;
        Ok(d)
    }
{% endif %}
{% if s.can %}

{% filter rewrap("    /// ") %}
    /// Configure CAN channel `index` ({% for ch in s.can.chans %}{{ ch.index }}: {{ ch.instance }}{{ ", " if not loop.last }}{% endfor %}): nominal `rate` (`500000`, `"500k"`) sampled at `sample_point` percent, CAN FD with `fd_rate` (sampled at 75 %), `mode` "normal", "listen-only", "internal-loopback" (frames sent come back, nothing on the bus) and the others of `ww_can_bus::Mode`. Returns what was set, as text.
{% endfilter %}
    #[pyo3(signature = (rate="500k", index=0, sample_point=87.5, fd_rate=None, mode="normal"))]
    fn can_configure(
        &self,
        rate: &str,
        index: u32,
        sample_point: f64,
        fd_rate: Option<&str>,
        mode: &str,
    ) -> PyResult<String> {
        let rate = can::parse_rate(rate).map_err(to_py)?;
        let mut setup = match fd_rate {
            Some(fd) => can::Setup::fd(rate, can::parse_rate(fd).map_err(to_py)?),
            None => can::Setup::classic(rate),
        };
        setup.sample_point = can::parse_sample_point(&sample_point.to_string()).map_err(to_py)?;
        setup.mode = can::parse_mode(mode).map_err(to_py)?;
        let board = self.{{ B }}()?;
        let set = self.block(board.can_setup(index, &setup))?;
        let caps = self.block(board.can_capabilities(index))?;
        Ok(can::config_line(&set, caps.clock.to_f64() as u32))
    }

    /// CAN channel `index`'s error state and counters, as text.
    #[pyo3(signature = (index=0))]
    fn can_status(&self, index: u32) -> PyResult<String> {
        let status = self.block(self.{{ B }}()?.can_status(index))?;
        Ok(can::status_line(&status))
    }

{% filter rewrap("    /// ") %}
    /// Send frames on CAN channel `index`, each a `cansend` line (`"123#DEADBEEF"`, `"1F334455#11"`, `"123##1AABB"` for CAN FD with bit rate switch); returns when the board has queued them all.
{% endfilter %}
    #[pyo3(signature = (frames, index=0))]
    fn can_send(&self, frames: Vec<String>, index: u32) -> PyResult<()> {
        let frames = parse_frames(&frames)?;
        let board = self.{{ B }}()?;
        self.block(async {
            let mut tx = board.can_tx(index).await?;
            for f in frames {
                tx.send(f).await?;
            }
            tx.close().await
        })
    }

{% filter rewrap("    /// ") %}
    /// Receive on CAN channel `index`: up to `count` frames within `timeout` seconds, as `{"t_us", "id", "extended", "data", "fd", "text", "filter"}` dicts (`text` in `candump -L` syntax); frames the board lost in between come as `{"lost": n}`. `send` (`cansend` lines) is sent once the stream is open, so in internal loopback the frames come back here.
{% endfilter %}
    #[pyo3(signature = (count=1, timeout=1.0, index=0, send=None))]
    fn can_rx<'py>(
        &self,
        py: Python<'py>,
        count: usize,
        timeout: f64,
        index: u32,
        send: Option<Vec<String>>,
    ) -> PyResult<Vec<Bound<'py, PyDict>>> {
        let timeout = Duration::try_from_secs_f64(timeout)
            .map_err(|e| PyValueError::new_err(format!("timeout {timeout} s: {e}")))?;
        let send = parse_frames(&send.unwrap_or_default())?;
        let board = self.{{ B }}()?;
        let events = self.block(async {
            let mut rx = board.can_rx(index).await?;
            if !send.is_empty() {
                let mut tx = board.can_tx(index).await?;
                for f in send {
                    tx.send(f).await?;
                }
                tx.close().await?;
            }
            let mut events = Vec::new();
            let deadline = tokio::time::Instant::now() + timeout;
            while events.len() < count {
                match tokio::time::timeout_at(deadline, rx.recv()).await {
                    Ok(event) => events.push(event?),
                    Err(_) => break,
                }
            }
            rx.close().await?;
            Ok(events)
        })?;
        events
            .into_iter()
            .map(|e| {
                let d = PyDict::new(py);
                match e {
                    can::RxEvent::Frame(r) => {
                        d.set_item("t_us", r.t_us)?;
                        d.set_item("id", r.frame.id.raw())?;
                        d.set_item("extended", r.frame.id.is_extended())?;
                        d.set_item("data", r.frame.data.as_slice().to_vec())?;
                        d.set_item("fd", matches!(r.frame.kind, can::FrameKind::Fd { .. }))?;
                        d.set_item("text", can::frame_text::display(&r.frame).to_string())?;
                        d.set_item("filter", r.filter)?;
                    }
                    can::RxEvent::Lost(n) => d.set_item("lost", n)?,
                }
                Ok(d)
            })
            .collect()
    }
{% endif %}

