{% set T = s.client_type %}
{% set C = s.client %}
{% set M = s.py_module %}
{% set d = s.dev %}
{% set decode = d.counters or d.log %}
{% set elf = ww.rtt or decode %}
{% set uses = feats("BootTarget" if d.boot else "", "CounterBuffer" if d.counters else "", "Error", T,
                    "PROBE_RS_CHIP" if ww.rtt else "", "Probe" if ww.rtt else "", "USB_ID" if ww.usb else "",
                    "Usb" if ww.usb else "", "SiliconRevision" if d.variant else "", "api_line",
                    "firmware_line", "node_lines" if d.dfu else "", "reset_lines" if d.last_reset else "") %}
{% filter rewrap("//! ") %}
//! `{{ M }}` Python module: [Device] wraps `{{ C }}::{{ T }}` with blocking calls on a tokio runtime of its own, so scripts and notebooks need no asyncio. Everything the module does, the library does.
{% endfilter %}

{% if elf %}
use std::path::PathBuf;
{% endif %}
use std::time::Duration;

{{ C | rust_use(uses) }}
use pyo3::exceptions::{PyConnectionError, PyRuntimeError, PyValueError};
use pyo3::prelude::*;
{% if d.board or d.variant or d.counters %}
use pyo3::types::PyDict;
{% endif %}
use tokio::runtime::Runtime;

/// Talk to the {{ s.title }} firmware {{ "through its debug probe" if ww.rtt else "over USB" }}.
#[pymodule]
fn {{ M }}(m: &Bound<'_, PyModule>) -> PyResult<()> {
    m.add_class::<Device>()?;
{% if ww.rtt %}
    m.add("PROBE_RS_CHIP", PROBE_RS_CHIP)?;
{% else %}
    m.add("USB_ID", USB_ID)?;
{% endif %}
    m.add("__version__", env!("CARGO_PKG_VERSION"))?;
    Ok(())
}

fn to_py(e: Error) -> PyErr {
    match e {
        Error::Connect(_) => PyConnectionError::new_err(e.to_string()),
        Error::Invalid(_){{ " | Error::Label(_)" if d.label else "" }} => PyValueError::new_err(e.to_string()),
{% if decode %}
        Error::Link { .. }
        | Error::Unimplemented { .. }
        | Error::Device { .. }
        | Error::Elf(_)
        | Error::Decode(_) => PyRuntimeError::new_err(e.to_string()),
{% else %}
        Error::Link { .. } | Error::Unimplemented { .. } | Error::Device { .. } => {
            PyRuntimeError::new_err(e.to_string())
        }
{% endif %}
    }
}

{% if ww.rtt %}
{% filter rewrap("/// ") %}
/// A board reached through a debug probe (RTT). Connects when created; use it as a context manager or call `disconnect()` to release the probe.
///
/// `Device(probe_serial=None, chip="{{ s.chip }}", elf=None, speed_hz=None)`: `probe_serial` picks {{ s.probe_kind_a }} when several are attached (a serial or a part of it, or VID:PID:SERIAL; no other probe is ever used without it), `elf` (the firmware's ELF) makes attaching fast{{ " and decodes " ~ (feats("counters" if d.counters else "", "the log" if d.log else "") | and_join) ~ " (default for those: the ELF of the board's build id)" if decode else "" }}.
{% endfilter %}
{% else %}
{% filter rewrap("/// ") %}
/// A board reached over USB. Connects when created; use it as a context manager or call `disconnect()` to release the USB device.
///
/// `Device(serial=None{{ ", elf=None" if decode else "" }})`: `serial` picks a board when several are attached (a serial or a part of it, or VID:PID:SERIAL){{ ", `elf` (the firmware's ELF) decodes " ~ (feats("counters" if d.counters else "", "the log" if d.log else "") | and_join) ~ " (default: the ELF of the board's build id)" if decode else "" }}.
{% endfilter %}
{% endif %}
#[pyclass]
struct Device {
    runtime: Runtime,
    board: Option<{{ T }}>,
{% if decode %}
    elf: Option<PathBuf>,
{% endif %}
}

impl Device {
    fn {{ s.py_board }}(&self) -> PyResult<&{{ T }}> {
        self.board
            .as_ref()
            .ok_or_else(|| PyConnectionError::new_err("disconnected"))
    }

    fn block<T>(&self, f: impl Future<Output = {{ C }}::Result<T>>) -> PyResult<T> {
        self.runtime.block_on(f).map_err(to_py)
    }
}

{% set B = s.py_board %}
#[pymethods]
impl Device {
    #[new]
{% if ww.rtt %}
    #[pyo3(signature = (probe_serial=None, chip=None, elf=None, speed_hz=None))]
    fn new(
        probe_serial: Option<String>,
        chip: Option<String>,
        elf: Option<PathBuf>,
        speed_hz: Option<u32>,
    ) -> PyResult<Self> {
        let runtime = tokio::runtime::Builder::new_multi_thread()
            .worker_threads(2)
            .enable_all()
            .build()?;
        let mut probe = Probe {
            chip: chip.unwrap_or_else(|| PROBE_RS_CHIP.to_string()),
            speed_hz,
            elf: elf.clone(),
            ..Probe::default()
        };
        if let Some(spec) = probe_serial {
            probe = probe.select(&spec).map_err(to_py)?;
        }
        let board = runtime.block_on({{ T }}::connect(&probe)).map_err(to_py)?;
        Ok(Self {
            runtime,
            board: Some(board),
{% if decode %}
            elf,
{% endif %}
        })
    }
{% else %}
{% if decode %}
    #[pyo3(signature = (serial=None, elf=None))]
    fn new(serial: Option<String>, elf: Option<PathBuf>) -> PyResult<Self> {
{% else %}
    #[pyo3(signature = (serial=None))]
    fn new(serial: Option<String>) -> PyResult<Self> {
{% endif %}
        let runtime = tokio::runtime::Builder::new_multi_thread()
            .worker_threads(2)
            .enable_all()
            .build()?;
        let usb = match serial {
            Some(spec) => Usb::default().select(&spec).map_err(to_py)?,
            None => Usb::default(),
        };
        let board = runtime.block_on({{ T }}::connect(&usb)).map_err(to_py)?;
        Ok(Self {
            runtime,
            board: Some(board),
{% if decode %}
            elf,
{% endif %}
        })
    }
{% endif %}

    /// API name and version the board reported.
    fn api(&self) -> PyResult<String> {
        Ok(api_line(self.{{ B }}()?.info()))
    }

    /// Switch the user LED{{ (" (" ~ s.led_name ~ ")") if s.led_name else "" }} on.
    fn led_on(&self) -> PyResult<()> {
        self.block(self.{{ B }}()?.led_on())
    }

    /// Switch the user LED off.
    fn led_off(&self) -> PyResult<()> {
        self.block(self.{{ B }}()?.led_off())
    }

    /// Blink the LED `count` times, `period_ms` per on-off cycle.
    #[pyo3(signature = (count=3, period_ms=500))]
    fn blink(&self, count: u32, period_ms: u64) -> PyResult<()> {
        self.block(
            self.{{ B }}()?
                .blink(count, Duration::from_millis(period_ms)),
        )
    }

    /// Name, version, git commit, build time and profile of the running firmware, as text.
    fn firmware(&self) -> PyResult<String> {
        Ok(firmware_line(&self.block(self.{{ B }}()?.firmware())?))
    }

    /// GNU build id of the running firmware, hex.
    fn build_id(&self) -> PyResult<String> {
        Ok(hex(&self.block(self.{{ B }}()?.build_id())?))
    }
{% if d.label %}

    /// The name stored on the board.
    #[getter]
    fn label(&self) -> PyResult<String> {
        self.block(self.{{ B }}()?.label())
    }

    /// Store a name on the board (at most 32 bytes, in flash when the call returns).
    #[setter]
    fn set_label(&self, label: &str) -> PyResult<()> {
        self.block(self.{{ B }}()?.set_label(label))
    }
{% endif %}
{% if d.last_reset %}

    /// Why the board last reset, with the crash record after a fault or panic, as text.
    fn last_reset(&self) -> PyResult<String> {
        let board = self.{{ B }}()?;
        let reset = self.block(board.last_reset())?;
        let boots = self.block(board.boot_count())?;
        Ok(reset_lines(&reset, boots).join("\n"))
    }

    /// Boots since the boot counter was cleared.
    fn boot_count(&self) -> PyResult<u32> {
        self.block(self.{{ B }}()?.boot_count())
    }

    /// Forget the crash record and zero the boot counter.
    fn clear_last_reset(&self) -> PyResult<()> {
        self.block(self.{{ B }}()?.clear_last_reset())
    }
{% endif %}
{% if d.board %}

    /// Board name, revision and serial number: `{"name", "revision", "serial"}`.
    fn board<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {
        let b = self.block(self.{{ B }}()?.board())?;
        let d = PyDict::new(py);
        d.set_item("name", b.name.as_str())?;
        d.set_item("revision", b.revision.as_str())?;
        d.set_item("serial", b.serial.as_str())?;
        Ok(d)
    }
{% endif %}
{% if d.uid %}

    /// The board's unique ids, hex: {{ s.uid_desc }}.
    fn uid(&self) -> PyResult<Vec<String>> {
        let ids = self.block(self.{{ B }}()?.uid())?;
        Ok(ids.iter().map(|id| hex(id.value.as_slice())).collect())
    }
{% endif %}
{% if d.variant %}

{% set revs = s.variant.revisions | map(attribute=0) | list %}
{% filter rewrap("    /// ") %}
    /// The chip on the board: `{"dev_id", "rev_id", "revision", "flash_kib"}`, `revision` is {{ revs | map("tojson") | join(", ") }} or "unknown".
{% endfilter %}
    fn variant<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {
        let v = self.block(self.{{ B }}()?.variant())?;
        let d = PyDict::new(py);
        d.set_item("dev_id", v.dev_id)?;
        d.set_item("rev_id", v.rev_id)?;
        d.set_item(
            "revision",
            match v.revision {
{% for r in revs %}
                SiliconRevision::{{ r }} => "{{ r }}",
{% endfor %}
                _ => "unknown",
            },
        )?;
        d.set_item("flash_kib", v.flash_kib)?;
        Ok(d)
    }
{% endif %}
{% if d.counters %}

    /// Every cnt counter, decoded with the firmware's ELF: `{"BUF/group/name": value}`, BUF is RAM{{ " or BKP" if o.bkp else "" }}.
    #[pyo3(signature = (force=false))]
    fn counters<'py>(&self, py: Python<'py>, force: bool) -> PyResult<Bound<'py, PyDict>> {
        let report = self.block(self.{{ B }}()?.counters(self.elf.as_deref(), force))?;
        let d = PyDict::new(py);
        for c in &report.counters {
            d.set_item(format!("{}/{}", c.buffer, c.name), c.value)?;
        }
        Ok(d)
    }

{% if o.bkp %}
    /// Zero the counters of a buffer: "ram" or "bkp".
{% else %}
    /// Zero the counters of a buffer: "ram".
{% endif %}
    fn reset_counters(&self, buffer: &str) -> PyResult<()> {
        let buffer = match buffer {
            "ram" => CounterBuffer::Ram,
{% if o.bkp %}
            "bkp" => CounterBuffer::Backup,
            _ => return Err(PyValueError::new_err("buffer is \"ram\" or \"bkp\"")),
{% else %}
            _ => return Err(PyValueError::new_err("buffer is \"ram\"")),
{% endif %}
        };
        self.block(self.{{ B }}()?.reset_counters(buffer))
    }
{% endif %}
{% if d.log %}

    /// The defmt log the board keeps (since boot, and from before a crash), decoded: one string per line.
    #[pyo3(signature = (force=false))]
    fn log(&self, force: bool) -> PyResult<Vec<String>> {
        Ok(self
            .block(self.{{ B }}()?.log(self.elf.as_deref(), force))?
            .lines)
    }
{% endif %}
{% if s.led_at_boot %}

    /// The LED after boot, kept in flash: `True` on, `False` off.
    #[getter]
    fn led_at_boot(&self) -> PyResult<bool> {
        self.block(self.{{ B }}()?.led_at_boot())
    }

    #[setter]
    fn set_led_at_boot(&self, on: bool) -> PyResult<()> {
        self.block(self.{{ B }}()?.set_led_at_boot(on))
    }
{% endif %}
{% if d.settings %}

    /// Every setting back to its default{{ ", the label too" if d.label else "" }}.
    fn reset_settings(&self) -> PyResult<()> {
        self.block(self.{{ B }}()?.reset_settings())
    }
{% endif %}
{% if d.boot %}

    /// The boot state: "Confirmed" (the firmware is the only image).
    fn boot_state(&self) -> PyResult<String> {
        Ok(format!("{:?}", self.block(self.{{ B }}()?.boot_state())?))
    }

    /// Reset the board into the firmware, or with `updater=True` into the STM32 ROM bootloader (USB DFU on
    /// PA11/PA12). The connection is gone afterwards: the object is disconnected.
    #[pyo3(signature = (updater=false))]
    fn reboot(&mut self, updater: bool) -> PyResult<()> {
        let into = if updater {
            BootTarget::Updater
        } else {
            BootTarget::App
        };
        self.block(self.{{ B }}()?.reboot(into))?;
        self.disconnect()
    }
{% endif %}
{% if d.dfu %}

    /// The update node (product, profile, boot state, last result), as text.
    fn dfu_node(&self) -> PyResult<String> {
        Ok(node_lines(&self.block(self.{{ B }}()?.dfu_node())?).join("\n"))
    }
{% endif %}
{% if decode %}

    /// Everything of the device contract in one text, for a bug report (counters and log decoded with the ELF).
    #[pyo3(signature = (force=false))]
    fn report(&self, force: bool) -> PyResult<String> {
        Ok(self
            .runtime
            .block_on(self.{{ B }}()?.report(self.elf.clone(), force)))
    }
{% else %}

    /// Everything of the device contract in one text, for a bug report.
    fn report(&self) -> PyResult<String> {
        Ok(self.runtime.block_on(self.{{ B }}()?.report(None, false)))
    }
{% endif %}

    /// Release the {{ "probe" if ww.rtt else "USB device" }}. The object can't be used afterwards.
    fn disconnect(&mut self) -> PyResult<()> {
        if let Some(board) = self.board.take() {
            self.runtime.block_on(board.disconnect());
        }
        Ok(())
    }

    fn __enter__(slf: PyRef<'_, Self>) -> PyRef<'_, Self> {
        slf
    }

    #[pyo3(signature = (*_args))]
    fn __exit__(&mut self, _args: &Bound<'_, pyo3::types::PyTuple>) -> PyResult<()> {
        self.disconnect()
    }

    fn __repr__(&self) -> String {
        match &self.board {
            Some(b) => format!("Device({})", api_line(b.info())),
            None => "Device(disconnected)".to_string(),
        }
    }
}

fn hex(bytes: &[u8]) -> String {
    bytes.iter().map(|b| format!("{b:02x}")).collect()
}
