{% if d.counters %}

    /// Every cnt counter, decoded with the firmware's ELF: `{"BUF/group/name": value}`, BUF is RAM{{ " or BKP" if o.bkp else "" }}.
    #[pyo3(signature = (force=false))]
    fn counters<'py>(&self, py: Python<'py>, force: bool) -> PyResult<Bound<'py, PyDict>> {
        let report = self.block(self.{{ B }}()?.counters(self.elf.as_deref(), force))?;
        let d = PyDict::new(py);
        for c in &report.counters {
            d.set_item(format!("{}/{}", c.buffer, c.name), c.value)?;
        }
        Ok(d)
    }

