use pyo3::types::PyDict;
{% endif %}
use tokio::runtime::Runtime;

/// Talk to the {{ s.title }} firmware {{ "through its debug probe" if ww.rtt else "over USB" }}.
#[pymodule]
fn {{ M }}(m: &Bound<'_, PyModule>) -> PyResult<()> {
    m.add_class::<Device>()?;
{% if ww.rtt %}
    m.add("PROBE_RS_CHIP", PROBE_RS_CHIP)?;
{% else %}
    m.add("USB_ID", USB_ID)?;
{% endif %}
    m.add("__version__", env!("CARGO_PKG_VERSION"))?;
    Ok(())
}

fn to_py(e: Error) -> PyErr {
    match e {
        Error::Connect(_) => PyConnectionError::new_err(e.to_string()),
        Error::Invalid(_){{ " | Error::Label(_)" if d.label else "" }} => PyValueError::new_err(e.to_string()),
{% if decode %}
        Error::Link { .. }
        | Error::Unimplemented { .. }
        | Error::Device { .. }
{% if s.can %}
        | Error::Stream(_)
{% endif %}
        | Error::Elf(_)
        | Error::Decode(_) => PyRuntimeError::new_err(e.to_string()),
{% elif s.can %}
        Error::Link { .. }
        | Error::Unimplemented { .. }
        | Error::Device { .. }
        | Error::Stream(_) => PyRuntimeError::new_err(e.to_string()),
{% else %}
        Error::Link { .. } | Error::Unimplemented { .. } | Error::Device { .. } => {
            PyRuntimeError::new_err(e.to_string())
        }
{% endif %}
    }
}

{% if ww.rtt %}
{% filter rewrap("/// ") %}
/// A board reached through a debug probe (RTT). Connects when created; use it as a context manager or call `disconnect()` to release the probe.
///
/// `Device(probe_serial=None, chip="{{ s.chip }}", elf=None, speed_hz=None)`: `probe_serial` picks {{ s.probe_kind_a }} when several are attached (a serial or a part of it, or VID:PID:SERIAL; no other probe is ever used without it), `elf` (the firmware's ELF) makes attaching fast{{ " and decodes " ~ (feats("counters" if d.counters else "", "the log" if d.log else "") | and_join) ~ " (default for those: the ELF of the board's build id)" if decode else "" }}.
{% endfilter %}
{% else %}
{% filter rewrap("/// ") %}
/// A board reached over USB. Connects when created; use it as a context manager or call `disconnect()` to release the USB device.
///
/// `Device(serial=None{{ ", elf=None" if decode else "" }})`: `serial` picks a board when several are attached (a serial or a part of it, or VID:PID:SERIAL){{ ", `elf` (the firmware's ELF) decodes " ~ (feats("counters" if d.counters else "", "the log" if d.log else "") | and_join) ~ " (default: the ELF of the board's build id)" if decode else "" }}.
{% endfilter %}
{% endif %}
#[pyclass]
struct Device {
    runtime: Runtime,
    board: Option<{{ T }}>,
{% if decode %}
    elf: Option<PathBuf>,
{% endif %}
}

impl Device {
    fn {{ s.py_board }}(&self) -> PyResult<&{{ T }}> {
        self.board
            .as_ref()
            .ok_or_else(|| PyConnectionError::new_err("disconnected"))
    }

    fn block<T>(&self, f: impl Future<Output = {{ C }}::Result<T>>) -> PyResult<T> {
        self.runtime.block_on(f).map_err(to_py)
    }
}

{% set B = s.py_board %}
#[pymethods]
impl Device {
    #[new]
{% if ww.rtt %}
    #[pyo3(signature = (probe_serial=None, chip=None, elf=None, speed_hz=None))]
    fn new(
        probe_serial: Option<String>,
        chip: Option<String>,
        elf: Option<PathBuf>,
        speed_hz: Option<u32>,
    ) -> PyResult<Self> {
        let runtime = tokio::runtime::Builder::new_multi_thread()
            .worker_threads(2)
            .enable_all()
            .build()?;
        let mut probe = Probe {
            chip: chip.unwrap_or_else(|| PROBE_RS_CHIP.to_string()),
            speed_hz,
            elf: elf.clone(),
            ..Probe::default()
        };
        if let Some(spec) = probe_serial {
            probe = probe.select(&spec).map_err(to_py)?;
        }
        let board = runtime.block_on({{ T }}::connect(&probe)).map_err(to_py)?;
        Ok(Self {
            runtime,
            board: Some(board),
{% if decode %}
            elf,
{% endif %}
        })
    }
{% else %}
{% if decode %}
    #[pyo3(signature = (serial=None, elf=None))]
    fn new(serial: Option<String>, elf: Option<PathBuf>) -> PyResult<Self> {
{% else %}
    #[pyo3(signature = (serial=None))]
    fn new(serial: Option<String>) -> PyResult<Self> {
{% endif %}
        let runtime = tokio::runtime::Builder::new_multi_thread()
            .worker_threads(2)
            .enable_all()
            .build()?;
        let usb = match serial {
            Some(spec) => Usb::default().select(&spec).map_err(to_py)?,
            None => Usb::default(),
        };
        let board = runtime.block_on({{ T }}::connect(&usb)).map_err(to_py)?;
        Ok(Self {
            runtime,
            board: Some(board),
{% if decode %}
            elf,
{% endif %}
        })
    }
{% endif %}

