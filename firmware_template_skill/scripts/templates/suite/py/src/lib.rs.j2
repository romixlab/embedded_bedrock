    fn variant<'py>(&self, py: Python<'py>) -> PyResult<Bound<'py, PyDict>> {
        let v = self.block(self.{{ B }}()?.variant())?;
        let d = PyDict::new(py);
{% if s.variant.kind == "rp" %}
        d.set_item("part", v.part)?;
        d.set_item("rev_id", v.rev_id)?;
        d.set_item("rom_version", v.rom_version)?;
{% else %}
        d.set_item("dev_id", v.dev_id)?;
        d.set_item("rev_id", v.rev_id)?;
{% endif %}
        d.set_item(
            "revision",
            match v.revision {
{% for r in revs %}
                SiliconRevision::{{ r }} => "{{ r }}",
{% endfor %}
                _ => "unknown",
