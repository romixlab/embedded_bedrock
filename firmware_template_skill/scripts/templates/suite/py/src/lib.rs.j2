                    "PROBE_RS_CHIP" if ww.rtt else "", "Probe" if ww.rtt else "", "USB_ID" if ww.usb else "",
                    "Usb" if ww.usb else "", "SiliconRevision" if d.variant else "", "Package" if d.variant and s.variant.package else "", "api_line",
                    "clock_line" if s.clock else "", "firmware_line", "node_lines" if d.dfu else "", "reset_lines" if d.last_reset else "") %}
{% filter rewrap("//! ") %}
//! `{{ M }}` Python module: [Device] wraps `{{ C }}::{{ T }}` with blocking calls on a tokio runtime of its own, so scripts and notebooks need no asyncio. Everything the module does, the library does.
{% endfilter %}

