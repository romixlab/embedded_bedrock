{% filter rewrap("    /// ") %}
    /// Reset the board into the firmware, or with `updater=True` into {{ s.boot.rom }} ({{ s.boot.via }}). The connection is gone afterwards: the object is disconnected.
{% endfilter %}
    #[pyo3(signature = (updater=false))]
    fn reboot(&mut self, updater: bool) -> PyResult<()> {
        let into = if updater {
            BootTarget::Updater
        } else {
            BootTarget::App
        };
        self.block(self.{{ B }}()?.reboot(into))?;
        self.disconnect()
    }
{% endif %}
{% if d.dfu %}

    /// The update node (product, profile, boot state, last result), as text.
    fn dfu_node(&self) -> PyResult<String> {
        Ok(node_lines(&self.block(self.{{ B }}()?.dfu_node())?).join("\n"))
    }
{% endif %}
{% if decode %}

    /// Everything of the device contract in one text, for a bug report (counters and log decoded with the ELF).
    #[pyo3(signature = (force=false))]
    fn report(&self, force: bool) -> PyResult<String> {
        Ok(self
            .runtime
            .block_on(self.{{ B }}()?.report(self.elf.clone(), force)))
    }
{% else %}

    /// Everything of the device contract in one text, for a bug report.
    fn report(&self) -> PyResult<String> {
        Ok(self.runtime.block_on(self.{{ B }}()?.report(None, false)))
    }
{% endif %}

    /// Release the {{ "probe" if ww.rtt else "USB device" }}. The object can't be used afterwards.
    fn disconnect(&mut self) -> PyResult<()> {
        if let Some(board) = self.board.take() {
            self.runtime.block_on(board.disconnect());
        }
        Ok(())
    }

    fn __enter__(slf: PyRef<'_, Self>) -> PyRef<'_, Self> {
        slf
    }

    #[pyo3(signature = (*_args))]
    fn __exit__(&mut self, _args: &Bound<'_, pyo3::types::PyTuple>) -> PyResult<()> {
        self.disconnect()
    }

    fn __repr__(&self) -> String {
        match &self.board {
            Some(b) => format!("Device({})", api_line(b.info())),
            None => "Device(disconnected)".to_string(),
        }
    }
}

{% if s.can %}
fn parse_frames(lines: &[String]) -> PyResult<Vec<can::FrameOwned>> {
    lines
        .iter()
        .map(|l| {
            can::frame_text::parse(l).map_err(|e| PyValueError::new_err(format!("{l:?}: {e}")))
        })
        .collect()
}

{% endif %}
fn hex(bytes: &[u8]) -> String {
    bytes.iter().map(|b| format!("{b:02x}")).collect()
}
