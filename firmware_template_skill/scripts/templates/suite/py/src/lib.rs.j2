        let buffer = match buffer {
            "ram" => CounterBuffer::Ram,
{% if o.bkp %}
            "bkp" => CounterBuffer::Backup,
            _ => return Err(PyValueError::new_err("buffer is \"ram\" or \"bkp\"")),
{% else %}
            _ => return Err(PyValueError::new_err("buffer is \"ram\"")),
{% endif %}
