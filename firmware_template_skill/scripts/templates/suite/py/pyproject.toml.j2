[build-system]
requires = ["maturin>={{ V["maturin"] }},<2.0"]
build-backend = "maturin"

[project]
name = "{{ s.py_module }}"
description = "Talk to the {{ s.title }} firmware from Python, {{ "through its debug probe" if ww.rtt else "over USB" }}"
requires-python = ">=3.9"
license = "MIT"
classifiers = [
    "Programming Language :: Rust",
    "Programming Language :: Python :: Implementation :: CPython",
]
dynamic = ["version"]

[dependency-groups]
dev = ["pytest>=8"]

[tool.uv]
# Rebuild the module when any Rust source of the workspace changed
cache-keys = [{ file = "pyproject.toml" }, { file = "Cargo.toml" }, { file = "**/*.rs" }, { file = "../**/*.rs" }]
