[package]
name = "{{ s.py }}"
version.workspace = true
edition.workspace = true
license.workspace = true
{% if s.repository %}
repository.workspace = true
{% endif %}
description = "Python module for the {{ s.title }} firmware, wrapping {{ s.client }}"
publish = false # distributed as a Python wheel, see pyproject.toml

[lib]
name = "{{ s.py_module }}" # the Python module name
crate-type = ["cdylib"]
doc = false
test = false # tested from Python (`just test-py`); a Rust test binary would need libpython at run time

[dependencies]
{{ s.client }}.workspace = true
pyo3.workspace = true
tokio.workspace = true
