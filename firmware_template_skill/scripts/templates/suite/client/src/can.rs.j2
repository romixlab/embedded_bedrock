/// The channels in `can[]` order: index, FDCAN instance{{ ", transceiver" if c.chans | selectattr("transceiver") | list }}.
pub const CHANNELS: [(u32, &str); {{ c.count }}] = [{% for ch in c.chans %}({{ ch.index }}, "{{ ch.instance }}{{ (" (" ~ ch.transceiver ~ ")") if ch.transceiver }}"){{ ", " if not loop.last }}{% endfor %}];

/// A configuration from bit rates: classic or FD, sample points, mode, TDC, recovery.
#[derive(Debug, Clone, PartialEq)]
pub struct Setup {
    /// Nominal (arbitration) bit rate in bit/s.
    pub rate: u32,
    /// Nominal sample point in tenths of a percent (875 = 87.5 %).
    pub sample_point: u16,
    /// CAN FD data phase: bit rate and sample point; `None` for classic CAN.
    pub data: Option<(u32, u16)>,
    pub mode: Mode,
    /// Transceiver delay compensation of the data phase (auto from about 1 Mbit/s up is usual).
    pub tdc: Tdc,
    /// ISO CAN FD (with the stuff count), `false` for Bosch non-ISO.
    pub iso: bool,
    /// Send each frame once, no retransmission.
    pub one_shot: bool,
    /// Leave bus-off by itself after this long (zero: at once); `None`: stay bus-off until `recover`.
    pub recovery: Option<Duration>,
}

impl Setup {
    /// Classic CAN at `rate` bit/s, sampled at 87.5 %, normal mode, recovery after 100 ms.
    pub fn classic(rate: u32) -> Setup {
        Setup {
            rate,
            sample_point: 875,
            data: None,
            mode: Mode::Normal,
            tdc: Tdc::Off,
            iso: true,
            one_shot: false,
            recovery: Some(Duration::from_millis(100)),
        }
    }

    /// CAN FD at `rate` nominal and `data_rate` in the data phase (sampled at 75 %, TDC auto from 1 Mbit/s up).
    pub fn fd(rate: u32, data_rate: u32) -> Setup {
        Setup {
            data: Some((data_rate, 750)),
            tdc: if data_rate >= 1_000_000 {
                Tdc::Auto
            } else {
                Tdc::Off
            },
            ..Setup::classic(rate)
        }
    }

    /// The `CanConfig` to send.
    pub fn to_config(&self) -> CanConfig {
        let timing = |rate: u32, sample_point: u16| Timing::Rate {
            rate: Baud::base(rate),
            sample_point,
        };
        CanConfig {
            mode: self.mode,
            nominal: timing(self.rate, self.sample_point),
            fd: self.data.map(|(rate, sp)| FdConfig {
                data: timing(rate, sp),
                tdc: self.tdc,
                iso: self.iso,
            }),
            options: Options {
                one_shot: self.one_shot,
                presume_ack: false,
                triple_sample: false,
                tx_pause: false,
                tx_order: TxOrder::Fifo,
                rx_overflow: RxOverflow::KeepOldest,
                edge_filtering: false,
                protocol_exception: true,
                wake_on_bus: false,
            },
            bus_off_recovery: self
                .recovery
                .map(|d| Second::milli(u32::try_from(d.as_millis()).unwrap_or(u32::MAX))),
        }
    }
}

/// A received frame.
#[derive(Debug, Clone, PartialEq)]
pub struct Received {
    /// Device time it was received at, in µs (counts on across the device's 32-bit wrap).
    pub t_us: Option<u64>,
    pub frame: FrameOwned,
    /// Index of the filter that accepted it, `None` when it came in as non-matching.
    pub filter: Option<u32>,
}

/// What [CanRx::recv] gives.
#[derive(Debug, Clone, PartialEq)]
pub enum RxEvent {
    Frame(Received),
    /// Frames lost before the next one: on the device (a full controller FIFO or queue) or on the link.
    Lost(u64),
}

/// The received frames of a channel.
pub struct CanRx {
    stream: PositionedStream<ww_can_bus::RxFrameOwned>,
}

impl CanRx {
    /// The next frame or loss; an error when the link went down or the device closed the stream.
    pub async fn recv(&mut self) -> Result<RxEvent> {
        loop {
            match self.stream.recv_event().await? {
                StreamEvent::Item { t, value, .. } => {
                    return Ok(RxEvent::Frame(Received {
                        t_us: t
                            .and_then(|t| t.to_i128_in(ww_si::Prefix::Micro))
                            .and_then(|us| u64::try_from(us).ok()),
                        frame: value.frame,
                        filter: value.filter.map(|f| f.0),
                    }));
                }
                StreamEvent::Gap { units, .. } => return Ok(RxEvent::Lost(units)),
                StreamEvent::Disconnected | StreamEvent::Closed => {
                    return Err(Error::Invalid("the CAN frame stream ended".into()));
                }
                _ => {}
            }
        }
    }

    /// Stops the stream on the device.
    pub async fn close(self) -> Result<()> {
        Ok(self.stream.close().await?)
    }
}

/// Frames to send, flow-controlled: [CanTx::send] waits while the device's queue is full.
pub struct CanTx {
    sink: Sink<TxFrameOwned>,
}

impl CanTx {
    /// Queues a frame. Frames the channel can't send as configured (FD with FD off, any frame in listen-only) are
    /// dropped by the device and counted (`can_tx_rejected`).
    pub async fn send(&mut self, frame: FrameOwned) -> Result<()> {
        Ok(self
            .sink
            .send_owned(TxFrameOwned {
                frame,
                marker: None,
            })
            .await?)
    }

    /// Waits until the device took everything sent so far (into its queue, not yet on the bus).
    pub async fn flush(&mut self) -> Result<()> {
        Ok(self.sink.flush().await?)
    }

    /// Flushes and closes the session.
    pub async fn close(mut self) -> Result<()> {
        Ok(self.sink.close().await?)
    }
}

