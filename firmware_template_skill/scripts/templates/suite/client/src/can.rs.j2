/// A bit rate as people write it: `500000`, `500k`, `2M`, `1.5M`.
pub fn parse_rate(s: &str) -> Result<u32> {
    let bad = || Error::Invalid(format!("'{s}' is no bit rate (500000, 500k, 2M)"));
    let s = s.trim();
    let (num, scale) = match s.char_indices().last() {
        Some((i, 'k' | 'K')) => (&s[..i], 1e3),
        Some((i, 'M' | 'm')) => (&s[..i], 1e6),
        _ => (s, 1.0),
    };
    let rate = num.parse::<f64>().map_err(|_| bad())? * scale;
    if !(1.0..=u32::MAX as f64).contains(&rate) || rate.fract() != 0.0 {
        return Err(bad());
    }
    Ok(rate as u32)
}

/// A sample point in percent (`87.5`) as tenths of a percent (875).
pub fn parse_sample_point(s: &str) -> Result<u16> {
    let pct: f64 = s
        .trim()
        .trim_end_matches('%')
        .parse()
        .map_err(|_| Error::Invalid(format!("'{s}' is no sample point in percent (87.5)")))?;
    if !(0.0..100.0).contains(&pct) || pct == 0.0 {
        return Err(Error::Invalid(format!("sample point {pct} % out of range")));
    }
    Ok((pct * 10.0).round() as u16)
}

/// An ID in the frame syntax of [frame_text]: 3 hex digits standard, 8 extended.
pub fn parse_id(s: &str) -> Result<CanId> {
    let raw = u32::from_str_radix(s, 16).ok();
    match (s.len(), raw) {
        (3, Some(r)) if r <= 0x7FF => CanId::standard(r as u16),
        (8, Some(r)) => CanId::extended(r),
        _ => None,
    }
    .ok_or_else(|| {
        Error::Invalid(format!(
            "'{s}': an ID is 3 (standard) or 8 (extended) hex digits"
        ))
    })
}

/// A filter accepting into FIFO 0: `123` (one ID), `120:7F0` (ID and mask, as candump), `100-1FF` (a range); IDs as
/// in [frame_text].
pub fn parse_filter(s: &str) -> Result<Filter> {
    use ww_can_bus::{FilterAction, FilterMatch};
    let matching = if let Some((id, mask)) = s.split_once(':') {
        let id = parse_id(id)?;
        let mask = u32::from_str_radix(mask, 16)
            .ok()
            .and_then(U29::new)
            .ok_or_else(|| Error::Invalid(format!("'{mask}' is no mask (hex, 29 bits)")))?;
        FilterMatch::Mask { id, mask }
    } else if let Some((from, to)) = s.split_once('-') {
        FilterMatch::Range {
            from: parse_id(from)?,
            to: parse_id(to)?,
        }
    } else {
        FilterMatch::Exact(parse_id(s)?)
    };
    Ok(Filter {
        matching,
        action: FilterAction::Fifo {
            fifo: 0,
            high_priority: false,
        },
    })
}

/// Filters accepting what `filters` match (all frames when empty), and the rest unless `reject_others`.
pub fn filter_config(
    filters: Vec<Filter>,
    reject_others: bool,
    reject_remote: bool,
) -> Result<FilterConfigOwned> {
    use ww_can_bus::NonMatching;
    let non_matching = if reject_others && !filters.is_empty() {
        NonMatching::Reject
    } else {
        NonMatching::Accept { fifo: 0 }
    };
    Ok(FilterConfigOwned {
        filters: MaxLen::new(filters).map_err(|_| Error::Invalid("too many filters".into()))?,
        non_matching_standard: non_matching,
        non_matching_extended: non_matching,
        reject_remote,
    })
}

/// A mode by its name: `normal`, `listen-only`, `restricted`, `internal-loopback` (frames sent come back, nothing on
/// the bus), `external-loopback`, `config`, `sleep`, `off`.
pub fn parse_mode(s: &str) -> Result<Mode> {
    let name = s.trim().to_ascii_lowercase().replace('_', "-");
    Ok(match name.as_str() {
        "normal" => Mode::Normal,
        "listen-only" | "listen" => Mode::ListenOnly,
        "restricted" => Mode::Restricted,
        "internal-loopback" | "loopback" => Mode::InternalLoopback,
        "external-loopback" => Mode::ExternalLoopback,
        "config" => Mode::Config,
        "sleep" => Mode::Sleep,
        "off" => Mode::Off,
        _ => {
            return Err(Error::Invalid(format!(
                "'{s}' is no mode (normal, listen-only, restricted, internal-loopback, \
                 external-loopback, config, sleep, off)"
            )));
        }
    })
}

/// A bit timing as `500 kbit/s at 87.5 %` (segments with the controller clock `clock_hz`).
pub fn timing_text(t: &Timing, clock_hz: u32) -> String {
    let (rate, sp) = match t {
        Timing::Rate { rate, sample_point } => (Some(rate.to_f64() as u32), *sample_point),
        Timing::Segments(bt) => (bt.bit_rate(clock_hz), bt.sample_point()),
        _ => (None, 0),
    };
    let rate = match rate {
        Some(r) if r >= 1_000_000 && r % 1000 == 0 => format!("{} Mbit/s", r as f64 / 1e6),
        Some(r) if r >= 1000 => format!("{} kbit/s", r as f64 / 1e3),
        Some(r) => format!("{r} bit/s"),
        None => "no rate".into(),
    };
    format!("{rate} at {}.{} %", sp / 10, sp % 10)
}

/// A configuration as one line: `Normal, 500 kbit/s at 87.5 %, FD 2 Mbit/s at 75.0 % (TDC Auto, ISO)`.
pub fn config_line(c: &CanConfig, clock_hz: u32) -> String {
    let mut line = format!("{:?}, {}", c.mode, timing_text(&c.nominal, clock_hz));
    if let Some(fd) = &c.fd {
        line.push_str(&format!(
            ", FD {} (TDC {:?}, {})",
            timing_text(&fd.data, clock_hz),
            fd.tdc,
            if fd.iso { "ISO" } else { "non-ISO" }
        ));
    }
    if c.options.one_shot {
        line.push_str(", one shot");
    }
    match &c.bus_off_recovery {
        Some(t) => line.push_str(&format!(
            ", bus-off recovery after {} ms",
            (t.to_f64() * 1e3).round()
        )),
        None => line.push_str(", bus-off until recovered"),
    }
    line
}

/// The error state as one line: `Active, TEC 0, REC 0`, with the last errors.
pub fn status_line(s: &Status) -> String {
    let mut line = format!("{:?}, TEC {}, REC {}", s.state, s.tec, s.rec);
    if let Some(e) = &s.last_error {
        line.push_str(&format!(", last error {e:?}"));
    }
    if let Some(e) = &s.last_data_error {
        line.push_str(&format!(", last data-phase error {e:?}"));
    }
    line
}

/// A received frame as a `candump -L` style line: `(12.345678) can0 123#DEADBEEF`, the time in device seconds.
pub fn rx_line(index: u32, r: &Received) -> String {
    let t = r.t_us.map_or_else(String::new, |us| {
        format!("({}.{:06}) ", us / 1_000_000, us % 1_000_000)
    });
    format!("{t}can{index} {}", frame_text::display(&r.frame))
}

#[cfg(test)]
mod tests {
    use super::*;
    use bedrock_can::{Controller, Recovery};

{% if c.family == "g0" %}
    /// The firmware's controller at the G0's default kernel clock (PCLK, 16 MHz from HSI); the board reports its own
    /// in [{{ T }}::can_capabilities].
    const CONTROLLER: Controller = Controller::g0(16_000_000);
{% else %}
    /// The firmware's controller at {{ "the default kernel clock (PLL2 Q, 80 MHz)" if c.pll2 else "a typical kernel clock (80 MHz)" }}; the board reports its own in
    /// [{{ T }}::can_capabilities].
    const CONTROLLER: Controller = Controller::{{ c.layout }}(80_000_000);
{% endif %}

    #[test]
    fn rates_and_sample_points() {
        assert_eq!(parse_rate("500k").unwrap(), 500_000);
        assert_eq!(parse_rate("2M").unwrap(), 2_000_000);
        assert_eq!(parse_rate("1.5M").unwrap(), 1_500_000);
        assert_eq!(parse_rate("125000").unwrap(), 125_000);
        assert!(parse_rate("fast").is_err());
        assert!(parse_rate("0").is_err());
        assert!(parse_rate("0.5").is_err());
        assert_eq!(parse_sample_point("87.5").unwrap(), 875);
        assert_eq!(parse_sample_point("75%").unwrap(), 750);
        assert!(parse_sample_point("100").is_err());
    }

    #[test]
    fn filters_and_the_device_mapping() {
        let list: Vec<_> = ["123", "120:7F0", "100-1FF", "18FF0000:1FFF0000"]
            .iter()
            .map(|s| parse_filter(s).unwrap())
            .collect();
        assert!(parse_filter("12345").is_err());
        assert!(parse_filter("800").is_err());
        assert!(parse_filter("123:FFFFFFFF").is_err());
        let config = filter_config(list, true, false).unwrap();
        assert_eq!(
            config.non_matching_standard,
            ww_can_bus::NonMatching::Reject
        );
        // what the firmware maps it to
        let slice = config.filters.clone().into_inner();
        let borrowed = ww_can_bus::FilterConfig {
            filters: MaxLen::new_unchecked(RefVec::Slice { slice: &slice }),
            non_matching_standard: config.non_matching_standard,
            non_matching_extended: config.non_matching_extended,
            reject_remote: false,
        };
{% if c.family == "g0" %}
        // no filter elements on the G0 (yet): refused
        assert!(bedrock_can::HwFilters::map(&borrowed, &CONTROLLER).is_err());
{% else %}
        // 3 standard elements, 1 extended
        let hw = bedrock_can::HwFilters::map(&borrowed, &CONTROLLER).unwrap();
        assert!(hw.standard[2].is_some() && hw.standard[3].is_none());
        assert!(hw.extended[0].is_some());
        // "120:7F0" is the second host filter and the second standard element
        assert_eq!(hw.host_index(false, 1), Some(1));
        assert_eq!(hw.host_index(true, 0), Some(3));
{% endif %}
        // no filters: everything, whatever reject_others says
        let all = filter_config(vec![], true, false).unwrap();
        assert_eq!(
            all.non_matching_standard,
            ww_can_bus::NonMatching::Accept { fifo: 0 }
        );
        let slice = all.filters.clone().into_inner();
        let borrowed = ww_can_bus::FilterConfig {
            filters: MaxLen::new_unchecked(RefVec::Slice { slice: &slice }),
            non_matching_standard: all.non_matching_standard,
            non_matching_extended: all.non_matching_extended,
            reject_remote: true,
        };
        assert!(bedrock_can::HwFilters::map(&borrowed, &CONTROLLER).is_ok());
    }

    #[test]
    fn modes_and_lines() {
        assert_eq!(
            parse_mode("internal-loopback").unwrap(),
            Mode::InternalLoopback
        );
        assert_eq!(parse_mode("Listen_Only").unwrap(), Mode::ListenOnly);
        assert!(parse_mode("fast").is_err());
        let line = config_line(
            &Setup::fd(500_000, 2_000_000).to_config(),
            CONTROLLER.clock_hz,
        );
        assert_eq!(
            line,
            "Normal, 500 kbit/s at 87.5 %, FD 2 Mbit/s at 75.0 % (TDC Auto, ISO), bus-off recovery after 100 ms"
        );
        let hw = bedrock_can::resolve(&Setup::classic(250_000).to_config(), &CONTROLLER).unwrap();
        assert_eq!(
            config_line(&hw.to_config(), CONTROLLER.clock_hz),
            "Normal, 250 kbit/s at 87.5 %, bus-off recovery after 100 ms"
        );
        let r = Received {
            t_us: Some(12_345_678),
            frame: frame_text::parse("123#DEADBEEF").unwrap(),
            filter: None,
        };
        assert_eq!(rx_line(0, &r), "(12.345678) can0 123#DEADBEEF");
    }

    #[test]
    fn setups_match_the_device_checks() {
        // what the firmware's checks (bedrock_can::resolve) make of a Setup
        for setup in [
            Setup::classic(250_000),
            Setup::classic(1_000_000),
            Setup::fd(500_000, 2_000_000),
{% if c.family != "g0" %}
            Setup::fd(1_000_000, 8_000_000),
{% endif %}
            Setup::fd(500_000, 500_000),
        ] {
            let hw = bedrock_can::resolve(&setup.to_config(), &CONTROLLER).unwrap();
            let clock = CONTROLLER.clock_hz;
            assert_eq!(hw.nominal.bit_rate(clock), Some(setup.rate));
            assert_eq!(
                hw.data.map(|d| d.timing.bit_rate(clock).unwrap()),
                setup.data.map(|(r, _)| r)
            );
        }
        let hw = bedrock_can::resolve(&Setup::classic(250_000).to_config(), &CONTROLLER).unwrap();
        assert_eq!(hw.recovery, Recovery::AfterMs(100));
        let manual = Setup {
            recovery: None,
            ..Setup::classic(500_000)
        };
        assert_eq!(manual.to_config().bus_off_recovery, None);
    }
}
