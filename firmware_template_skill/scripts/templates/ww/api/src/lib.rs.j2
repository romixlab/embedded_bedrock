//! WireWeaver API of the {{ o.name }} firmware (`../{{ ww.api }}`), served by `../firmware/src/ww.rs`.
//!
//! The crate name and version identify the API on the wire (`{{ ww.gid }}`), so bump the version with every
//! change and follow the WireWeaver evolution rules to stay compatible with deployed devices and hosts:
//! https://github.com/vhrdtech/wire_weaver/blob/master/docs/evolution/rules.md
//! Data types used in the API go here too, with `#[derive_shrink_wrap]`.
#![no_std]

use wire_weaver::prelude::*;

/// {{ o.name }} device
#[ww_api_root]
pub trait {{ ww.trait }} {
{% if s.leds %}
    /// {{ s.led.First }} solid on (`leds` shows it until another mode)
    fn led_on();
    /// {{ s.led.First }} off (`leds` shows it until another mode)
    fn led_off();
{% else %}
    /// Turn the LED on
    fn led_on();
    /// Turn the LED off
    fn led_off();
{% endif %}

    /// Device contract: {{ ["firmware", d.last_reset and "last reset", "board", "ids", d.label and "label", d.counters and "counters", d.log and "log", d.variant and "variant", d.settings and "settings", d.boot and "boot", d.dfu and "update node"] | select | join(", ") }}
    ww_impl!(device: Device);
{% if s.pins %}

{{ ("Raw access to the pins the board leaves free" ~ (" (" ~ s.pins.table ~ ")" if s.pins.table else "") ~ ", for bring-up and pin tests (`ww pins tui`): one program at a time, every pin given back when it lets go or disconnects") | doc(indent="    ", width=118) }}
    ww_impl!(pins: ww_pin_diag::PinDiag);
{% endif %}
{% if s.leds %}

{% if s.clock %}
{% if s.led.pwm.multi %}
    /// {{ s.led.Name }} as one indication: global mode, brightness, identify. Each shows its role's look by default,
    /// in phase with other boards once `clock` is steered.
{% else %}
    /// {{ s.led.Name }} as one indication: global mode, brightness, identify. It breathes by default, in phase with other boards
    /// once `clock` is steered.
{% endif %}
{% elif s.led.pwm.multi %}
    /// {{ s.led.Name }} as one indication: global mode, brightness, identify. Each shows its role's look by default.
{% else %}
    /// {{ s.led.Name }} as one indication: global mode, brightness, identify. It breathes by default.
{% endif %}
    ww_impl!(leds: ww_indication::Indication);
{% endif %}
{% if s.buttons %}

    /// The board's buttons: {{ s.buttons | map(attribute="name") | join(", ") }}
    ww_impl!(buttons: Buttons);
{% endif %}
{% if s.clock %}
{% if not s.leds and not s.buttons %}

{% endif %}
    /// Device clock: local time (U32 µs, wraps every 71.6 minutes), a host's steer points onto UTC (`host_sync`).
    /// No sync line.
    ww_impl!(clock: ww_timebase::Clock);
{% endif %}
{% if s.can %}

    /// CAN FD channels ({% for ch in s.can.chans %}`can[{{ ch.index }}]` {{ ch.instance }}{{ (" through a " ~ ch.transceiver) if ch.transceiver }}{{ ", " if not loop.last }}{% endfor %}): configure, send,
    /// receive, filters, status
    ww_impl!(can[]: ww_can_bus::Can);
{% endif %}
}

/// The device contract: what every WireWeaver device answers, so generic host tools (`ww info`, `ww log`) work.
#[ww_trait]
pub trait Device {
    /// Which firmware runs and its build id
    ww_impl!(firmware: ww_firmware_info::FirmwareInfo);
{% if d.last_reset %}
    /// Why the device last reset, with the crash record after a fault or panic, and the boot count
    ww_impl!(last_reset: ww_firmware_info::LastReset);
{% endif %}
    /// Board name, revision and serial number
    ww_impl!(board: ww_board_info::BoardInfo);
    /// {{ s.uid.doc[:1] | upper }}{{ s.uid.doc[1:] }}
    ww_impl!(uid: ww_uid::Uid);
{% if d.label %}
    /// Name the user gives this unit, kept in flash
    ww_impl!(label: ww_user_info::UserInfo);
{% endif %}
{% if d.counters %}
    /// `cnt` counters: {{ "RAM and backup registers" if bkp_words else "RAM" }}
    ww_impl!(counters: ww_counters::Counters);
{% endif %}
{% if d.log %}
    /// The defmt log, also kept while no host is connected
    ww_impl!(log: ww_log::LogDefmt);
{% endif %}
{% if d.variant %}
{% if v.kind == "rp" %}
    /// The chip on this board, read from the chip itself: part, silicon revision{{ ", package" if v.package else "" }}
{% else %}
    /// The chip on this board, read from the chip itself: device id, silicon revision, flash size
{% endif %}
    property!(ro variant: Variant);
{% endif %}
{% if d.settings %}
    /// Settings kept in flash
    ww_impl!(settings: Settings);
{% endif %}
{% if d.boot %}
    /// Boot state, confirm, revert, reboot: `reboot(Updater)` goes to {{ s.boot.rom }}. The state is always
    /// `Confirmed`, there is no image to revert to.
    ww_impl!(boot: ww_dfu::BootControl);
{% endif %}
{% if d.dfu %}
    /// The update node: the firmware in place, written by the ROM bootloader (`Profile::InPlace`, `device.boot` only)
    ww_impl!(dfu: Dfu);
{% endif %}
}
{% if s.buttons %}

/// The board's buttons, read-only: `true` while pressed.
#[ww_trait]
pub trait Buttons {
{% for b in s.buttons %}
    /// {{ b.name }} ({{ b.pin }})
    property!(ro {{ b.var }}: bool);
{% endfor %}
}
{% endif %}
{% if d.dfu %}

{% filter rewrap("/// ") %}
/// Firmware update over the API (`ww_dfu`): here only who the node is. Updates go through {{ s.boot.rom }} (`device.boot.reboot(Updater)`, then `{{ s.boot.flash }}`, {{ s.boot.via }}), or through the debug probe.
{% endfilter %}
#[ww_trait]
pub trait Dfu {
    /// Who this node is: product, profile, boot state, last result
    ww_impl!(node: ww_dfu::UpdateNode);
}
{% endif %}
{% if d.settings %}

/// Settings kept in flash across power cycles. A write is in flash before the call answers. The label is
/// `device.label`, kept the same way.
#[ww_trait]
pub trait Settings {
    /// The LED after boot: on (`true`) or off, default off
    #[errors(Fault)]
    property!(rw led_at_boot: bool, CommonError<'i>);
    /// Every setting back to its default, the label too
    #[errors(Fault)]
    fn reset() -> Result<(), CommonError<'i>>;
}
{% endif %}
{% if d.variant %}

{% if v.kind == "rp" %}
{{ ("The chip a board carries, see [`Device::variant`]: " ~ v.doc) | doc }}
#[derive_shrink_wrap(
    borrowed,
    owned(feature = "std"),
    derive(Copy, Clone, Debug, PartialEq, Eq)
)]
pub struct Variant {
    /// SYSINFO CHIP_ID.PART
    pub part: u16,
    /// SYSINFO CHIP_ID.REVISION, the raw revision field
    pub rev_id: u8,
    /// The bootrom's version byte (0x00000013), which tells the silicon revisions apart
    pub rom_version: u8,
    /// The silicon revision `rom_version` stands for ({{ v.ref }})
    pub revision: SiliconRevision,
{% if v.package %}
    /// The package, from SYSINFO PACKAGE_SEL{{ "; an RP2354 (stacked flash) reads as its RP2350 package" if v.stacked else "" }}
    pub package: Package,
{% endif %}
}

{{ ("Silicon revision of an " ~ v.device ~ ", told by the bootrom version (" ~ v.ref ~ "), see [`Variant::rom_version`] for the raw value. The revisions keep the datasheet's order and a new one is only ever added at the end, so a firmware that knows it is a compatible API change: an older host reads it as [`Newer`](SiliconRevision::Newer), with the version in `rom_version`.") | doc }}
#[derive_shrink_wrap(borrowed, owned(feature = "std"), derive(Copy, Clone, Debug, PartialEq, Eq), ww_repr = unib32, future_version = Newer)]
pub enum SiliconRevision {
    /// A bootrom version this firmware doesn't know (a revision newer than it), the value is in `rom_version`
    Unknown,
{% for name, rom, rev in v.revisions %}
    /// Revision {{ name }}: bootrom version {{ rom }}{{ ", CHIP_ID.REVISION %d" % rev if rev is not none else "" }}
    {{ name }},
{% endfor %}
}

impl SiliconRevision {
    /// The revision of a bootrom version byte.
    pub const fn from_rom_version(rom_version: u8) -> Self {
        match rom_version {
{% for name, rom, rev in v.revisions %}
            {{ rom }} => SiliconRevision::{{ name }},
{% endfor %}
            _ => SiliconRevision::Unknown,
        }
    }
}
{% if v.package %}

/// The package of an {{ v.device }}: SYSINFO PACKAGE_SEL ({{ v.ref }}).
#[derive_shrink_wrap(borrowed, owned(feature = "std"), derive(Copy, Clone, Debug, PartialEq, Eq), ww_repr = unib32, future_version = Newer)]
pub enum Package {
    /// RP2350A{{ " / RP2354A" if v.stacked else "" }}: QFN-60, 30 GPIOs (PACKAGE_SEL 1)
    A,
    /// RP2350B{{ " / RP2354B" if v.stacked else "" }}: QFN-80, 48 GPIOs (PACKAGE_SEL 0)
    B,
}
{% endif %}
{% else %}
{{ ("The chip a board carries, see [`Device::variant`]: " ~ v.doc) | doc }}
#[derive_shrink_wrap(
    borrowed,
    owned(feature = "std"),
    derive(Copy, Clone, Debug, PartialEq, Eq)
)]
pub struct Variant {
    /// DBGMCU_IDCODE.DEV_ID: {{ "0x%x" % v.dev_id }} for {{ v.device }}
    pub dev_id: u16,
    /// DBGMCU_IDCODE.REV_ID, the raw silicon revision code
    pub rev_id: u16,
    /// The silicon revision `rev_id` stands for ({{ v.errata }})
    pub revision: SiliconRevision,
    /// Flash size in KiB (FLASH_SIZE register): {{ v.flash_kib }} on the {{ v.part }}
    pub flash_kib: u16,
}

{{ ("Silicon revision of an " ~ v.device ~ " as " ~ v.errata ~ " lists them, see [`Variant::rev_id`] for the raw code. The revisions keep the sheet's order and a new one is only ever added at the end, so a firmware that knows it is a compatible API change: an older host reads it as [`Newer`](SiliconRevision::Newer), with the code in `rev_id`.") | doc }}
#[derive_shrink_wrap(borrowed, owned(feature = "std"), derive(Copy, Clone, Debug, PartialEq, Eq), ww_repr = unib32, future_version = Newer)]
pub enum SiliconRevision {
    /// A REV_ID this firmware doesn't know (a revision newer than it), the code is in `rev_id`
    Unknown,
{% for name, rev_id, marking in v.revisions %}
    /// Revision {{ name }}, REV_ID {{ "0x%04X" % rev_id }}{{ ", marked " ~ marking if marking != name else "" }}
    {{ name }},
{% endfor %}
}

impl SiliconRevision {
    /// The revision of a DBGMCU_IDCODE.REV_ID value.
    pub const fn from_rev_id(rev_id: u16) -> Self {
        match rev_id {
{% for name, rev_id, marking in v.revisions %}
            {{ "0x%04X" % rev_id }} => SiliconRevision::{{ name }},
{% endfor %}
            _ => SiliconRevision::Unknown,
        }
    }
}
{% endif %}
{% endif %}
