{#- Shared helpers. Import with: {% from "macros.j2" import dep, bedrock_build %} -#}

{#- `name = { version = "<V[name]>", features = [...] }` (single line, no newline) -#}
{% macro dep(name, features) -%}
{{ name }} = { version = "{{ V[name] }}", features = {{ features | toml_list }} }
{%- endmacro %}

{#- Inline table for the bedrock_build dependency; `prefix` is prepended to a local --bedrock path -#}
{% macro bedrock_build(bedrock, prefix="", flip_link=false) -%}
{% if bedrock == "git" %}{ git = "{{ BEDROCK_GIT }}"{% else %}{ path = "{{ "" if bedrock.startswith("/") else prefix }}{{ bedrock }}/bedrock_build"{% endif %}{{ ', features = ["flip-link"] }' if flip_link else " }" }}
{%- endmacro %}

{#- A crate of embedded_bedrock from git, or from a local checkout (--bedrock, relative to the output directory) -#}
{% macro bedrock_dep(name, bedrock, prefix="", extra="") -%}
{{ name }} = { {% if bedrock == "git" %}git = "{{ BEDROCK_GIT }}"{% else %}path = "{{ "" if bedrock.startswith("/") else prefix }}{{ bedrock }}/{{ name }}"{% endif %}{{ extra }} }
{%- endmacro %}

{#- WireWeaver crate from git, or from a local checkout (--ww-src, relative to the output directory; `prefix` leads there) -#}
{% macro ww_dep(name, subdir, src, prefix, extra="") -%}
{{ name }} = { {% if src == "git" %}git = "{{ WW_GIT }}"{% else %}path = "{{ "" if src.startswith("/") else prefix }}{{ src }}/{{ subdir }}"{% endif %}{{ extra }} }
{%- endmacro %}

{#- [patch.crates-io] taking `crates` from embassy main (--embassy main), or the same block commented out ready to
    switch (--embassy release) -#}
{% macro embassy_patch(main, crates) -%}
{% if main %}
# embassy from upstream main at a pinned rev (--embassy main, TPL-28): double-buffered USB bulk endpoints on USB v4
# (embassy-rs/embassy#7275) and the G0 flash prefetch (#7276) are merged but not released yet. The dependency lines
# above stay the crates.io ones (main still has those versions), this block swaps the source of every embassy crate
# (embassy-stm32's path dependencies would otherwise clash with the crates.io ones). The code uses main's API. Back to
# crates.io: drop this block once the next embassy-stm32 release ships (bump the versions above, check the API).
[patch.crates-io]
{% for c in crates %}
{{ c }} = { git = "{{ EMBASSY_GIT }}", rev = "{{ V["embassy-main"] }}" }
{% endfor %}
{% else %}
# embassy main instead of the crates.io release (--embassy main, TPL-28): uncomment, and take main's API in the code
# as well (regenerate with --embassy main and compare: CamelCase PAC enums, interrupt binding last, ...).
# [patch.crates-io]
{% for c in crates %}
# {{ c }} = { git = "{{ EMBASSY_GIT }}", rev = "{{ V["embassy-main"] }}" }
{% endfor %}
{% endif %}
{%- endmacro %}
