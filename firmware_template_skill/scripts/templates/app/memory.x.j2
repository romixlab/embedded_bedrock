{# regions: all regions (some commented out), sections: extra RAM regions that get a NOLOAD
   output section, consts: regions that get __<name>_start/__<name>_end helper symbols. #}
MEMORY
{
  /* FLASH and RAM are the regions cortex-m-rt / link.x expects */
{% for r in regions %}
  {% set line = "%s : ORIGIN = %s, LENGTH = %s" % (r.name, r.origin | hex8, r.length | fmt_len) %}

  /* {{ r.name }} ({{ r.kind }}){{ ": " ~ r.comment if r.comment else "" }} */
  {% if r.commented_out %}
  /* {{ line }} */
  {% else %}
  {{ line }}
  {% endif %}
  {% if r.is_main_ram and r.name != "RAM" %}
  RAM : ORIGIN = {{ r.origin | hex8 }}, LENGTH = {{ r.length | fmt_len }}
  {% endif %}
{% endfor %}
}
{% if sections %}

/* No symbols or `. = ...` in these sections: lld then drops an empty one. flip-link (0.1.12) counts an empty section
   right at the end of RAM as used RAM and would leave no room for the stack (fix in knurling-rs/flip-link#142, not
   released yet). */
SECTIONS
{
  {% for r in sections %}
    {% set lname = r.name | lower %}
    {% if not loop.first %}

    {% endif %}
  .{{ lname }} (NOLOAD) : ALIGN({{ r.align }})
  {
    *(.{{ lname }} .{{ lname }}.*);
  } > {{ r.name }}
  {% endfor %}
}
{% endif %}
{% if consts %}

/* Helper symbols: additional RAM banks (see init_ram.rs), flash partitions */
  {% for r in consts %}
    {% set lname = r.name | lower %}
    {% set sh = " " ~ r.shift if r.shift else "" %}
    {% if not loop.first %}

    {% endif %}
    {% if r.shift %}
/* {{ r.name }}: offsets relative to the start of flash ({{ r.shift[2:] }}), as embassy-boot / flash drivers expect */
    {% endif %}
__{{ lname }}_start = ORIGIN({{ r.name }}){{ sh }};
__{{ lname }}_end = ORIGIN({{ r.name }}) + LENGTH({{ r.name }}){{ sh }};
  {% endfor %}
{% endif %}
{% if t.rp_variant and t.rp_variant != "rp2040" %}

{% include "linker/rp235x.x" %}
{% endif %}
{% if build_id %}

/* GNU build id (--build-id=sha1 in build.rs): the firmware's identity, a host finds the ELF by it. Kept in flash;
   ww_firmware_info::build_id() reads it through the two symbols. */
SECTIONS
{
  .note.gnu.build-id : ALIGN(4)
  {
    __build_id_start = .;
    KEEP(*(.note.gnu.build-id))
    __build_id_end = .;
  } > FLASH
} INSERT AFTER .rodata;
{% endif %}
{% if es0548_bank2 %}

/* ES0548 2.2.10 (STM32G0B1/G0C1 errata, every silicon revision): a code prefetch can fail on a branch or call into
   the other flash bank and run wrong instructions. Flash prefetch is on (src/main.rs), so all code stays in bank 1.
   When this fails: turn prefetch off in src/main.rs and delete this ASSERT, or make the code smaller (opt-level "s"). */
ASSERT(__etext <= {{ es0548_bank2 | hex8 }}, "code reaches flash bank 2 with prefetch on (ES0548 2.2.10): see memory.x");
{% endif %}
