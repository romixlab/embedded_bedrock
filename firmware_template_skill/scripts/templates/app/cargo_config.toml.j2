{# -> .cargo/config.toml. Shared with the bootloader (rendered with counters/logging/build-std disabled). #}
[target.{{ t.rust_target }}]
{% if t.family == "esp" %}
runner = "espflash flash --monitor --chip {{ t.chip }}{{ " --log-format defmt" if o.log == "defmt" else "" }}"
# runner = "probe-rs run --chip {{ t.probe_chip }}" # alternative, needs rtt-target instead of esp-println
rustflags = [
  {% if t.arch == "xtensa" %}
  "-C", "link-arg=-nostartfiles",
  {% else %}
  "-C", "force-frame-pointers", # needed for esp-backtrace
  {% endif %}
]
{% else %}
# Only {{ s.probe_name }} ({{ s.probe }}), never another probe on the PC: one with someone else's board
# would be flashed. `just {{ 'run' if o.host else 'cnt' }}` adds the serial of {{ s.probe_env }} for a PC with two {{ s.board.get("readme", {}).get("plural", "of them") }}.
runner = "probe-rs run --chip {{ t.probe_chip }} --probe {{ s.probe }}{{ t.runner_extra }}"
# runner = "cnt run --chip {{ t.probe_chip }} --probe {{ s.probe }}" # adds the defmt log plus live counters (cargo install cnt_cli), `just cnt`
  {% if o.flip_link and t.cortex_m %}
# Stack overflow protection: the stack goes below .data/.bss and overflows fault (cargo install flip-link)
linker = "flip-link"
  {% endif %}
{% endif %}

[build]
target = "{{ t.rust_target }}"

[env]
{% if o.log == "defmt" %}
DEFMT_LOG = "{{ o.defmt_log }},{{ o.name | replace("-", "_") }}={{ o.defmt_log }}"
  {% if t.family != "esp" and not (o.ww and o.ww_transport == "rtt") %}
    {% if o.rtt_buffer != 1024 %}
DEFMT_RTT_BUFFER_SIZE = "{{ o.rtt_buffer }}"
    {% else %}
# DEFMT_RTT_BUFFER_SIZE = "4096" # larger buffer avoids losing output in bursts (init)
    {% endif %}
  {% endif %}
{% elif o.log == "esp-println" %}
ESP_LOG = "{{ o.defmt_log }}"
{% endif %}
{% if o.counters %}
CNT_RAM_BUFFER_SIZE_WORDS = "{{ o.ram_counters }}"
  {% if bkp_words %}
CNT_BKP_BUFFER_SIZE_WORDS = "{{ bkp_words }}" # must fit into {{ bkp_region }} in memory.x{{ " (the %s register is the boot word, src/boot.rs)" % ({4: "fifth"}.get(bkp_words, "last")) if lay and lay.boot_word else "" }}
    {% if bkp_region != CNT_BKP_DEFAULT_REGION %}
CNT_BKP_MEMORY_REGION = "{{ bkp_region }}" # cnt.x places the BKP buffer there ({{ CNT_BKP_DEFAULT_REGION }} is the backup SRAM)
    {% endif %}
  {% endif %}
{% endif %}

{% if o.toolchain == "nightly" and t.family != "esp" %}
# Release firmware without panic locations (the file, line and column of every panic site: about 13 KB on a
# WireWeaver firmware): a panic record keeps the return addresses instead, and the host names the site from the ELF
[profile.release]
rustflags = ["-Zlocation-detail=none"]

[unstable]
profile-rustflags = true
  {% if o.build_core %}
# core built with the firmware (opt-level z, inside fat LTO) instead of the prebuilt one, with its size-first code paths
build-std = ["core"]
build-std-features = ["optimize_for_size"]
  {% endif %}
{% elif t.family == "esp" %}
[unstable]
build-std = ["core"]
{% else %}
# With the nightly toolchain (bedrock_gen.py --toolchain nightly, the default) the template sets:
# [profile.release]
# rustflags = ["-Zlocation-detail=none"]           # no panic locations in release
# [unstable]
# profile-rustflags = true
# build-std = ["core"]                             # core built at the firmware's opt-level
# build-std-features = ["optimize_for_size"]
{% endif %}
