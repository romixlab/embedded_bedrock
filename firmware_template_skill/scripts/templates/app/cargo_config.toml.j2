{# -> .cargo/config.toml. Shared with the bootloader (rendered with counters/logging/build-std disabled). #}
[target.{{ t.rust_target }}]
{% if t.family == "esp" %}
runner = "espflash flash --monitor --chip {{ t.chip }}{{ " --log-format defmt" if o.log == "defmt" else "" }}"
# runner = "probe-rs run --chip {{ t.probe_chip }}" # alternative, needs rtt-target instead of esp-println
rustflags = [
  {% if t.arch == "xtensa" %}
  "-C", "link-arg=-nostartfiles",
  {% else %}
  "-C", "force-frame-pointers", # needed for esp-backtrace
  {% endif %}
]
{% else %}
runner = "probe-rs run --chip {{ t.probe_chip }}{{ t.runner_extra }}"
{% endif %}

[build]
target = "{{ t.rust_target }}"

[env]
{% if o.log == "defmt" %}
DEFMT_LOG = "{{ o.defmt_log }},{{ o.name | replace("-", "_") }}={{ o.defmt_log }}"
  {% if t.family != "esp" %}
    {% if o.rtt_buffer != 1024 %}
DEFMT_RTT_BUFFER_SIZE = "{{ o.rtt_buffer }}"
    {% else %}
# DEFMT_RTT_BUFFER_SIZE = "4096" # larger buffer avoids losing output in bursts (init)
    {% endif %}
  {% endif %}
{% elif o.log == "esp-println" %}
ESP_LOG = "{{ o.defmt_log }}"
{% endif %}
{% if o.counters %}
CNT_RAM_BUFFER_SIZE_WORDS = "{{ o.ram_counters }}"
  {% if bkp_words %}
CNT_BKP_BUFFER_SIZE_WORDS = "{{ bkp_words }}" # must fit into {{ bkp_region }} in memory.x
    {% if bkp_region != CNT_BKP_DEFAULT_REGION %}
CNT_BKP_MEMORY_REGION = "{{ bkp_region }}" # cnt.x places the BKP buffer there ({{ CNT_BKP_DEFAULT_REGION }} is the backup SRAM)
    {% endif %}
  {% endif %}
{% endif %}

{% set build_std = o.build_core or t.family == "esp" %}
{% if build_std or o.panic_immediate_abort %}
[unstable]
  {% if build_std %}
build-std = ["core"]{{ " # smaller binaries; needs nightly + rust-src" if t.family != "esp" else "" }}
  {% endif %}
  {% if o.panic_immediate_abort %}
build-std-features = ["panic_immediate_abort"]
  {% endif %}
{% else %}
# [unstable]
# build-std = ["core"]                              # smaller binaries (nightly + rust-src)
# build-std-features = ["panic_immediate_abort"]   # even smaller, panics become aborts
{% endif %}
