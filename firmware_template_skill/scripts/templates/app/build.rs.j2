{# Shared by the application and the bootloader (bootloader=true). #}
{# OUT_DIR is needed for memory.x (not on ESP) and build info; import order as rustfmt sorts it #}
{% set need_out = t.family != "esp" or o.build_info %}
{% if need_out %}
use std::path::PathBuf;
use std::{env, fs};

{% endif %}
fn main() {
{% if need_out %}
    let out = PathBuf::from(env::var_os("OUT_DIR").unwrap());
{% endif %}
{% if t.family != "esp" %}
    // Put memory.x on the linker search path (link.x from cortex-m-rt INCLUDEs it)
    fs::write(out.join("memory.x"), include_bytes!("memory.x")).unwrap();
    println!("cargo:rustc-link-search={}", out.display());
    println!("cargo:rerun-if-changed=memory.x");

{% endif %}
{% if t.cortex_m %}
  {% if o.build_info and not bootloader %}
    bedrock_build::common(); // -Tlink.x, -Tdefmt.x, --nmagic, optional RAM_LINK=1 support
    {% if t.rp_variant == "rp2040" %}
    println!("cargo:rustc-link-arg=-Tlink-rp.x"); // .boot2 section (embassy-rp)
    {% endif %}
  {% else %}
    println!("cargo:rustc-link-arg=--nmagic");
    println!("cargo:rustc-link-arg=-Tlink.x");
    {% if t.rp_variant == "rp2040" %}
    println!("cargo:rustc-link-arg=-Tlink-rp.x"); // .boot2 section (embassy-rp)
    {% endif %}
    {% if bootloader %}
    if env::var("CARGO_FEATURE_DEFMT").is_ok() {
        println!("cargo:rustc-link-arg=-Tdefmt.x");
    }
    {% elif o.log == "defmt" %}
    println!("cargo:rustc-link-arg=-Tdefmt.x");
    {% endif %}
  {% endif %}
  {% if o.counters and not bootloader %}
    println!("cargo:rustc-link-arg=-Tcnt.x"); // counters index allocation (cnt crate)
  {% endif %}
  {% if not bootloader %}
    // GNU build id: the firmware's identity (memory.x keeps it in flash), a host finds the ELF by it
    println!("cargo:rustc-link-arg=--build-id=sha1");
  {% endif %}
{% else %}
  {# ESP #}
  {% if o.log == "defmt" %}
    println!("cargo:rustc-link-arg=-Tdefmt.x");
  {% endif %}
  {% if o.counters and not bootloader %}
    println!("cargo:rustc-link-arg=-Tcnt.x");
  {% endif %}
    // linkall.x must be the last linker script
    println!("cargo:rustc-link-arg=-Tlinkall.x");
{% endif %}
{% if o.ww and not bootloader %}

    // Name, version, git commit and build time for ww_firmware_info::firmware_summary!() (FirmwareInfo in src/ww.rs)
    ww_firmware_info::build::emit();
{% endif %}
{% if o.build_info %}

    // Embed build information (see src/build_info.rs)
    let info = build_info_build::build_script()
        .collect_dependencies(build_info_build::DependencyDepth::Depth(0))
        .build();
    let info = bedrock_build::serialize_build_info(info);
    fs::write(out.join("build_info.rs"), info).unwrap();
{% endif %}
}
