{% from "macros.j2" import dep, bedrock_build, bedrock_dep, ww_dep, bedrock_ww_patch, embassy_patch %}
{% set defmt = o.log == "defmt" %}
{% set ww_rtt = o.ww and ww.rtt %}
{% set d = s.dev %}
[package]
name = "{{ o.name }}"
version = "0.1.0"
edition = "2024"

# standalone crate: keeps an enclosing Cargo workspace from claiming it
[workspace]

[dependencies]
{# --- logging / panic handler --- #}
{% if defmt %}
defmt = "{{ V["defmt"] }}"
  {% if t.family != "esp" %}
    {% if d.log %}
# defmt's global logger: every frame into device.log over WireWeaver, teed to the RTT channel "defmt" that probe-rs /
# cnt run show (src/log.rs)
{{ ww_dep("ww_defmt_logger", "ww_defmt_logger", o.ww_src, root, ', features = ["rtt"]') }}
rtt-target = "{{ V["rtt-target"] }}" # the RTT channels: the log's tee{{ " and WireWeaver's up and down" if ww_rtt else "" }} (src/log.rs)
    {% elif ww_rtt %}
{{ dep("rtt-target", ["defmt"]) }} # defmt shares RTT with WireWeaver, instead of defmt-rtt
    {% elif o.rtt_buffer == 1024 %}
defmt-rtt = "{{ V["defmt-rtt"] }}"
    {% else %}
defmt-rtt = { version = "{{ V["defmt-rtt"] }}" } # buffer size via DEFMT_RTT_BUFFER_SIZE in .cargo/config.toml
    {% endif %}
    {% if not o.crash %}
{{ dep("panic-probe", ["print-defmt"]) }}
    {% endif %}
  {% endif %}
{% elif o.log == "rtt" %}
rtt-target = "{{ V["rtt-target"] }}"
  {% if not o.crash %}
panic-rtt-target = "{{ V["panic-rtt-target"] }}"
  {% endif %}
{% elif o.log == "none" and t.family != "esp" %}
  {% if not o.crash %}
panic-halt = "{{ V["panic-halt"] }}"
  {% endif %}
  {% if ww_rtt %}
rtt-target = "{{ V["rtt-target"] }}"
  {% endif %}
{% endif %}
{# --- Cortex-M runtime --- #}
{% if t.cortex_m %}
{{ dep("cortex-m", ["inline-asm" if t.family == "rp" else "critical-section-single-core"]) }}
cortex-m-rt = "{{ V["cortex-m-rt"] }}"
  {% if t.rust_target.startswith("thumbv6m") and o.framework == "embassy" %}
{{ dep("portable-atomic", ["critical-section"]) }} # atomics for Cortex-M0(+)
  {% endif %}
{% endif %}
{# --- framework --- #}
{% if o.framework == "embassy" %}
  {% if t.family == "stm32" %}
{% set pw = s.led.pwm %}
{{ dep("embassy-stm32", feats(defmt and "defmt", t.chip, "unstable-pac", "exti", "time", "time-driver-" ~ (pw.driver if pw else "any"), o.rtc and "chrono")) }}{{ (" # not \"any\": it may take " ~ pw.timer ~ ", " ~ s.led.name ~ "'s PWM (src/led.rs)") if pw else "" }}
  {% elif t.family == "rp" %}
{{ dep("embassy-rp", feats(defmt and "defmt", t.rp_variant, "unstable-pac", "time-driver", "critical-section-impl", "executor-thread", "executor-interrupt", t.rp_variant != "rp2040" and "binary-info")) }}
  {% elif t.family == "nrf" %}
{{ dep("embassy-nrf", feats(defmt and "defmt", t.hal_feature, "time-driver-rtc1", "gpiote", "unstable-pac", "time")) }}
  {% elif t.family == "esp" %}
{{ dep("esp-hal", feats(t.chip, "unstable", defmt and "defmt")) }}
{{ dep("esp-rtos", feats(t.chip, "embassy", defmt and "defmt")) }}
  {% endif %}
  {# embassy-executor 0.10: task pools are statically allocated on stable, no task-arena / nightly needed.
     embassy-rp provides its own executor (executor-thread/-interrupt features) and __pender. #}
  {% set arch_ex = t.cortex_m and t.family != "rp" %}
{{ dep("embassy-executor", feats(arch_ex and "platform-cortex-m", arch_ex and "executor-thread", arch_ex and "executor-interrupt", defmt and "defmt")) }}
{{ dep("embassy-time", feats(defmt and "defmt", defmt and "defmt-timestamp-uptime")) }}
{{ dep("embassy-sync", feats(defmt and "defmt")) }}
static_cell = "{{ V["static_cell"] }}"
  {% if t.cortex_m %}
assign-resources = "{{ V["assign-resources"] }}"
  {% endif %}
{% elif o.framework == "stm32-hal2" %}
hal = { package = "stm32-hal2", version = "{{ V["stm32-hal2"] }}", features = {{ feats(hal2_feature, hal2_rt, defmt and "defmt") | toml_list }} }
critical-section = "1.2"
{% elif o.framework == "stm32xx-hal" %}
hal = { package = "{{ xxhal_crate }}", version = "{{ V[xxhal_crate] }}", features = {{ xxhal_features | toml_list }} }
{% elif o.framework == "bare" and t.family == "esp" %}
{{ dep("esp-hal", feats(t.chip, "unstable", defmt and "defmt")) }}
{% endif %}
{# --- ESP support crates --- #}
{% if t.family == "esp" %}
esp-bootloader-esp-idf = { version = "{{ V["esp-bootloader-esp-idf"] }}", features = ["{{ t.chip }}"] }
  {% if o.log in ("defmt", "esp-println") %}
{{ dep("esp-println", feats(t.chip, defmt and "defmt-espflash", not defmt and "log-04")) }}
    {% if not defmt %}
log = "0.4"
    {% endif %}
  {% endif %}
{{ dep("esp-backtrace", feats(t.chip, "panic-handler", defmt and "defmt", not defmt and "println")) }}
{% endif %}
{# --- optional features --- #}
{% if o.counters %}
cnt = "{{ V["cnt"] }}"{{ " # 0.5: used words and format version, served as device.counters (ww_counters)" if d.counters else "" }}
{% endif %}
{% if o.crash %}
# crash capture: HardFault / panic record kept across reset, reset cause (src/last_reset.rs); the panic handler
{{ bedrock_dep("bedrock_crash", o.bedrock, root, ", features = " ~ (feats("cortex-m", defmt and "defmt") | toml_list)) }}
{% endif %}
{% if d.boot and s.boot.kind == "rp" %}
# device.boot and device.dfu.node of a firmware updated in place through the RP boot ROM (src/boot.rs resets into
# BOOTSEL): bedrock_rom_boot's ww_dfu answers, no family feature
{{ bedrock_dep("bedrock_rom_boot", o.bedrock, root, ", features = " ~ (feats("ww-dfu", defmt and "defmt") | toml_list)) }}
{% elif d.boot %}
# firmware updates through the STM32 ROM bootloader (src/boot.rs): the early boot, reboot(Updater), boot-loop rescue,
# device.boot and device.dfu.node
{{ bedrock_dep("bedrock_rom_boot", o.bedrock, root, ", features = " ~ (feats(o.rom_boot, "embassy", "ww-dfu", defmt and "defmt") | toml_list)) }}
{% endif %}
{% if s.led.pwm %}
  {% if s.leds %}
# {{ s.led.Name }} breathes, blinks, identifies on {{ s.led.pwm.signal }} PWM (src/led.rs){{ ", aligned to shared time" if s.clock }}; `leds` (src/ww/leds.rs)
  {% else %}
# {{ s.led.Name }} breathes on {{ s.led.pwm.signal }} PWM (src/led.rs)
  {% endif %}
{{ bedrock_dep("bedrock_led", o.bedrock, root, ", features = " ~ (feats("embassy", s.leds and "ww-indication", defmt and "defmt") | toml_list)) }}
{% endif %}
{% if s.clock %}
# the shared clock a host steers onto UTC (src/sync.rs), served as `clock` (src/ww/clock.rs)
{{ bedrock_dep("bedrock_sync", o.bedrock, root, ", features = " ~ (feats("embassy", "ww-timebase", defmt and "defmt") | toml_list)) }}
{% endif %}
{% if s.can %}
# {{ s.can.names }} (src/can.rs): the M_CAN driver, without its `rcc` feature (embassy-stm32 owns RCC)
mcan = { {% if o.mcan_src == "git" %}git = "{{ MCAN_GIT }}"{% else %}path = "{{ "" if o.mcan_src.startswith("/") else root }}{{ o.mcan_src }}"{% endif %}, default-features = false, features = {{ feats(s.can.family, "defmt", "embassy") | toml_list }} }
# `can[]`: bit timing, checks and mappings of a host's input (src/ww/can.rs)
{{ bedrock_dep("bedrock_can", o.bedrock, root, ', features = ["defmt"]') }}
{% endif %}
{% if o.hw.get("bring_up", {}).get("dependencies") %}
# board bring-up (the board preset's [bring_up], src/main.rs)
  {% for k, v in o.hw.bring_up.dependencies.items() %}
{{ k }} = {{ v | toml_value }}
  {% endfor %}
{% endif %}
{% set pins_deps %}
# raw access to the free pins (src/pins.rs)
{{ ww_dep("ww_pin_diag", "ww_stdlib/ww_pin_diag", o.ww_src, root, ", default-features = false" ~ (', features = ["defmt"]' if defmt else "")) }}
{{ ww_dep("ww_gpio", "ww_stdlib/ww_gpio", o.ww_src, root, ", default-features = false" ~ (', features = ["defmt"]' if defmt else "")) }} # its Level, Pull
{% endset %}
{% if o.settings_flash %}
# settings store in the SETTINGS flash region (src/settings.rs)
{{ ww_dep("ww_settings", "ww_settings/ww_settings", o.ww_src, root, (', features = ["defmt"]' if defmt else "")) }}
  {% if o.settings_flash in ("g0", "h7") %}
# flash reads that survive an ECC error left by a power cut
{{ ww_dep("ww_ecc_flash", "mcu/ww_ecc_flash", o.ww_src, root, ', features = ["stm32' ~ o.settings_flash ~ '"]') }}
  {% else %}
embassy-embedded-hal = "{{ V["embassy-embedded-hal"] }}" # BlockingAsync: the flash as an async NorFlash
  {% endif %}
  {% if o.ww %}
{{ ww_dep("ww_user_info", "ww_stdlib/ww_user_info", o.ww_src, root, ", default-features = false") }}
    {% if s.pins %}
{{ pins_deps }}
    {%- endif %}
{{ ww_dep("ww_error", "ww_stdlib/ww_error", o.ww_src, root, ", default-features = false") }}
  {% endif %}
{% endif %}
{% if o.bootloader %}
{{ dep("embassy-boot-" ~ t.family, feats(defmt and "defmt")) }}
embedded-storage = "{{ V["embedded-storage"] }}"
  {% if o.framework != "embassy" %}
embassy-sync = "{{ V["embassy-sync"] }}"
  {% endif %}
{% endif %}
{% if o.ww %}
# WireWeaver: API crate next to the firmware, served by src/ww.rs
{{ ww.api }} = { path = "../{{ ww.api }}"{{ ', features = ["defmt"]' if defmt else "" }} }
{{ ww_dep("wire_weaver", "wire_weaver", o.ww_src, root, ', default-features = false' ~ (', features = ["defmt"]' if defmt else "")) }}
{{ ww_dep("ww_client_server", "ww_stdlib/ww_client_server", o.ww_src, root, ", default-features = false") }}
  {% if o.settings_flash or d.log or s.can %}
embassy-futures = "{{ V["embassy-futures"] }}" # select in the server task (src/ww.rs)
  {% endif %}
{{ ww_dep("ww_firmware_info", "ww_stdlib/ww_firmware_info", o.ww_src, root, ", default-features = false, features = " ~ (feats("build-id", "cortex-m", defmt and "defmt") | toml_list)) }}
# the device contract's stdlib traits (`device` in the API crate): types in the handler signatures (src/ww/device.rs)
{{ ww_dep("ww_board_info", "ww_stdlib/ww_board_info", o.ww_src, root, ", default-features = false") }}
{{ ww_dep("ww_si", "ww_stdlib/ww_si", o.ww_src, root, ", default-features = false, features = " ~ (feats("time", (s.leds or s.clock) and "u32") | toml_list)) }}
  {% if s.leds %}
{{ ww_dep("ww_indication", "ww_stdlib/ww_indication", o.ww_src, root, ", default-features = false") }}
  {% endif %}
  {% if s.can %}
{{ ww_dep("ww_can_bus", "ww_stdlib/ww_can_bus", o.ww_src, root, ", default-features = false") }}
  {% endif %}
  {% if s.clock %}
{{ ww_dep("ww_timebase", "ww_stdlib/ww_timebase", o.ww_src, root, ", default-features = false") }}
{{ ww_dep("ww_date_time", "ww_stdlib/ww_date_time", o.ww_src, root, ", default-features = false") }} # clock.set_time_of_day
  {% endif %}
  {% if (s.leds or s.clock) and not o.settings_flash %}
{{ ww_dep("ww_error", "ww_stdlib/ww_error", o.ww_src, root, ", default-features = false") }}
  {% endif %}
{{ ww_dep("ww_uid", "ww_stdlib/ww_uid", o.ww_src, root, ", default-features = false") }}
  {% if d.counters %}
{{ ww_dep("ww_counters", "ww_stdlib/ww_counters", o.ww_src, root, ", default-features = false") }}
  {% endif %}
  {% if d.log %}
{{ ww_dep("ww_log", "ww_stdlib/ww_log", o.ww_src, root, ", default-features = false") }}
  {% endif %}
  {% if d.dfu %}
{{ ww_dep("ww_dfu", "ww_stdlib/ww_dfu", o.ww_src, root, ", default-features = false" ~ (', features = ["defmt"]' if defmt else "")) }}
  {% endif %}
  {% if s.pins and not o.settings_flash %}
{{ pins_deps }}
  {%- endif %}
  {% if d.log %}
# reliable stream state of device.log; persistent-ram: its store in .uninit RAM, kept across a crash and reset
{{ ww_dep("ww_stream", "ww_stream", o.ww_src, root, ', default-features = false, features = ["persistent-ram"]') }}
  {% endif %}
  {% if ww.usb %}
{{ ww_dep("wire_weaver_usb_embassy", "mcu/wire_weaver_usb_embassy", o.ww_src, root) }}
  {% else %}
{{ ww_dep("ww_device", "ww_device", o.ww_src, root, ", features = " ~ (feats("rtt", "embassy-time", defmt and "defmt") | toml_list)) }}
  {% endif %}
{% endif %}

[build-dependencies]
{% if o.build_info %}
bedrock_build = {{ bedrock_build(o.bedrock, prefix=root, flip_link=o.flip_link and t.cortex_m) }}
build-info-build = "{{ V["build-info-build"] }}"
{% endif %}
{% if o.ww %}
{{ ww_dep("ww_firmware_info", "ww_stdlib/ww_firmware_info", o.ww_src, root, ', features = ["build"]') }} # FirmwareInfo facts (build.rs)
{% endif %}
{% if not (o.build_info or o.ww) %}
# (none)
{% endif %}
{% if (o.build_info or s.dev.boot or s.leds or s.clock or s.can) and o.ww_src != "git" %}
{{ bedrock_ww_patch(o.ww_src, root, s.dev.boot, ([("bedrock_led", "ww_indication", "ww_stdlib/ww_indication")] if s.leds else [])
                   + ([("bedrock_sync", "ww_timebase", "ww_stdlib/ww_timebase"), ("bedrock_sync", "ww_si", "ww_stdlib/ww_si")] if s.clock else [])
                   + ([("bedrock_can", "ww_can_bus", "ww_stdlib/ww_can_bus")] + ([] if s.clock else [("bedrock_can", "ww_si", "ww_stdlib/ww_si")]) if s.can else [])) }}
{% endif %}

# See https://docs.rust-embedded.org/book/unsorted/speed-vs-size.html
[profile.dev]
codegen-units = 1
debug = 2
debug-assertions = true
incremental = false
opt-level = 3           # embedded dev builds are usually unusable at opt-level 0
overflow-checks = true

[profile.release]
codegen-units = 1
debug = 2               # debug info does not end up in flash
debug-assertions = false
incremental = false
lto = "fat"
opt-level = "z"         # 3 = speed, s = size, z = smaller
overflow-checks = false

# Do not optimize build scripts / proc-macros: faster clean builds
[profile.dev.build-override]
codegen-units = 8
debug = false
debug-assertions = false
opt-level = 0
overflow-checks = false

[profile.release.build-override]
codegen-units = 8
debug = false
debug-assertions = false
opt-level = 0
overflow-checks = false
{% if o.framework == "embassy" and t.family == "stm32" %}

{{ embassy_patch(o.embassy == "main", embassy_crates) }}
{% endif %}
