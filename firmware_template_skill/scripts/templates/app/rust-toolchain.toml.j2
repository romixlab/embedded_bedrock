[toolchain]
{% if t.arch == "xtensa" %}
channel = "esp" # install with: cargo install espup && espup install
components = ["rustfmt", "rust-src"]
{% else %}
  {% if o.toolchain == "nightly" %}
# Pinned by the firmware template (versions.toml): move it with the template, not to whatever nightly is newest
channel = "{{ nightly_channel() }}"
components = ["rustfmt", "clippy", "rust-src"]
  {% elif t.family == "esp" %}
channel = "stable"
components = ["rustfmt", "rust-src"]
  {% else %}
channel = "stable"
components = ["rustfmt"]
  {% endif %}
targets = ["{{ t.rust_target }}"]
{% endif %}
