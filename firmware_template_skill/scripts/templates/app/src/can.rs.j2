/// The mcan configuration for `hw`: the ranges were checked against `bedrock_can::NOMINAL` / `DATA`, mcan checks
/// them again.
{% if h7 %}
fn mcan_config(
    hw: &HwConfig,
    filters: &HwFilters,
    layout: MessageRamLayout,
) -> Result<FdCanConfig, mcan::BitTimingError> {
{% else %}
fn mcan_config(hw: &HwConfig, filters: &HwFilters) -> Result<FdCanConfig, mcan::BitTimingError> {
{% endif %}
    let n = &hw.nominal;
    let mut config = FdCanConfig::default()
        .set_nominal_bit_timing(NominalBitTiming::new(n.prescaler, n.seg1, n.seg2, n.sjw)?)
        .set_frame_transmit(FrameTransmissionConfig::ClassicCanOnly)
        .set_non_iso_mode(false);
    if let Some(d) = &hw.data {
        let t = &d.timing;
        // DATA limits: prescaler and seg1 at most 32
        let mut dbtr = DataBitTiming::new(t.prescaler as u8, t.seg1 as u8, t.seg2, t.sjw)?;
        if let Some((offset, window)) = d.tdc {
            dbtr = dbtr.with_tdc(TransceiverDelayCompensation::new(offset, window)?)?;
        }
        config = config
            .set_data_bit_timing(dbtr)
            .set_frame_transmit(FrameTransmissionConfig::AllowFdCanAndBRS)
            .set_non_iso_mode(!d.iso);
    }
    {{ "config = config" if h7 else "Ok(config" }}
{% if h7 %}
        // one_shot is DAR mode. ES0491 2.22.3 "DAR mode transmission failure due to lost arbitration" (A on revisions
        // A, Z): "the transmission may fail due to lost arbitration at the first two identifier bits"; the workaround
        // (clear TRPx, set CFx, send again) is not done here, such a frame is lost like any one-shot frame that loses
        // arbitration
{% endif %}
        .set_automatic_retransmit(!hw.one_shot)
        .set_transmit_pause(hw.tx_pause)
        // off unless the host asks: {{ "ES0491 2.22.1" if h7 else "ES0548 2.15.1" }} "Desynchronization under specific condition with edge
        // filtering enabled" (A on every revision), workaround "Disable edge filtering or wait for frame
        // retransmission"
        .set_edge_filtering(hw.edge_filtering)
        .set_protocol_exception_handling(hw.protocol_exception)
        // received frames are timestamped when the task reads them out (embassy-time, 1 µs): the controller's
        // timestamp counter runs in bit times
        .set_automatic_bus_off_recovery(hw.recovery == Recovery::Immediate)
        .set_interrupts(EVENTS)
        .set_global_filter(GlobalFilter {
            handle_standard_frames: non_matching(filters.non_matching_standard),
            handle_extended_frames: non_matching(filters.non_matching_extended),
            reject_remote_standard_frames: filters.reject_remote,
            reject_remote_extended_frames: filters.reject_remote,
        }){{ ";" if h7 else ")" }}
{% if h7 %}
    config.layout = layout;
    Ok(config)
{% endif %}
}

fn non_matching(n: Option<u8>) -> NonMatchingFilter {
    match n {
        Some(0) => NonMatchingFilter::IntoRxFifo0,
        Some(_) => NonMatchingFilter::IntoRxFifo1,
        None => NonMatchingFilter::Reject,
    }
}
{% if h7 %}

fn action(a: HwAction) -> FilterAction {
    match a {
        HwAction::Fifo {
            fifo: 0,
            priority: false,
        } => FilterAction::StoreInFifo0,
        HwAction::Fifo {
            fifo: _,
            priority: false,
        } => FilterAction::StoreInFifo1,
        HwAction::Fifo {
            fifo: 0,
            priority: true,
        } => FilterAction::SetPriorityAndStoreInFifo0,
        HwAction::Fifo {
            fifo: _,
            priority: true,
        } => FilterAction::SetPriorityAndStoreInFifo1,
        HwAction::Reject => FilterAction::Reject,
    }
}

/// The element for a mapped filter; IDs and masks were checked to be 11 / 29 bits (`None` can't happen).
fn standard_filter(f: &HwFilter) -> Option<StandardFilter> {
    let id = |raw: u32| StandardId::new(u16::try_from(raw).ok()?);
    let matching = match f.matching {
        HwMatch::Range { from, to } => FilterMatch::Range {
            from: id(from)?,
            to: id(to)?,
        },
        HwMatch::Dual(a, b) => FilterMatch::Dual(id(a)?, id(b)?),
        HwMatch::Mask { id: v, mask } => FilterMatch::Mask {
            id: id(v)?,
            mask: id(mask)?,
        },
    };
    Some(StandardFilter {
        matching,
        action: action(f.action),
    })
}

fn extended_filter(f: &HwFilter) -> Option<ExtendedFilter> {
    let matching = match f.matching {
        HwMatch::Range { from, to } => FilterMatch::Range {
            from: ExtendedId::new(from)?,
            to: ExtendedId::new(to)?,
        },
        HwMatch::Dual(a, b) => FilterMatch::Dual(ExtendedId::new(a)?, ExtendedId::new(b)?),
        HwMatch::Mask { id, mask } => FilterMatch::Mask {
            id: ExtendedId::new(id)?,
            mask: ExtendedId::new(mask)?,
        },
    };
    Some(ExtendedFilter {
        matching,
        action: action(f.action),
    })
}
{% endif %}

/// The frame for a checked [bedrock_can::TxPlan] and the host's data (at most the plan's length, zero-padded).
pub fn tx_frame(plan: &bedrock_can::TxPlan, data: &[u8]) -> Option<TxFrame> {
    let id = if plan.extended {
        Id::Extended(ExtendedId::new(plan.id)?)
    } else {
        Id::Standard(StandardId::new(u16::try_from(plan.id).ok()?)?)
    };
    let mut bytes = [0u8; 64];
    let n = data.len().min(bytes.len());
    bytes[..n].copy_from_slice(&data[..n]);
    Some(TxFrame {
        header: TxFrameHeader {
            frame_format: if plan.fd {
                FrameFormat::FD
            } else {
                FrameFormat::Classic
            },
            id,
            bit_rate_switching: plan.brs,
            error_state: Esi::EsiDependsOnErrorPassive,
            remote: plan.rtr,
            marker: None,
        },
        data: bytes,
        len: plan.len,
    })
}

// ---- status, read by the server ----

/// What a read of the status found.
pub struct Snapshot {
    pub state: HwState,
    /// Last errors since the last read (`PSR.LEC` / `DLEC`, kept by mcan across its own reads).
    pub last_error: Option<ww_can_bus::ProtocolError>,
    pub last_data_error: Option<ww_can_bus::ProtocolError>,
    pub activity: ww_can_bus::Activity,
    /// ESI and BRS of the last FD frame received, if one was.
    pub fd_frame: Option<(bool, bool)>,
    pub exception: bool,
    pub tdc_value: u8,
}

/// Reads a channel's status; before its task started, all quiet.
pub fn status(ch: &Chan) -> Snapshot {
    let Some(reader) = ch.status.try_get() else {
        return Snapshot {
            state: HwState::default(),
            last_error: None,
            last_data_error: None,
            activity: ww_can_bus::Activity::Synchronizing,
            fd_frame: None,
            exception: false,
            tdc_value: 0,
        };
    };
    let p = reader.protocol_status();
    let e = reader.error_counters();
    ch.error_log
        .fetch_add(e.error_logging as u32, Ordering::Relaxed);
    Snapshot {
        state: HwState {
            bus_off: p.bus_off,
            passive: p.error_passive,
            warning: p.error_warning,
            tec: e.transmit,
            rec: e.receive,
        },
        last_error: bedrock_can::protocol_error(lec(p.last_error)),
        last_data_error: bedrock_can::protocol_error(lec(p.data_last_error)),
        activity: bedrock_can::activity(match p.activity {
            mcan::Activity::Synchronizing => 0,
            mcan::Activity::Idle => 1,
            mcan::Activity::Receiver => 2,
            mcan::Activity::Transmitter => 3,
        }),
        fd_frame: p.received_fd.then_some((p.received_esi, p.received_brs)),
        exception: p.protocol_exception,
        tdc_value: p.tdc_value,
    }
}

/// Errors counted since the last call (`ECR.CEL`, saturating like the register).
pub fn take_error_log(ch: &Chan) -> u8 {
    ch.error_log.swap(0, Ordering::Relaxed).min(255) as u8
}

/// The raw `PSR.LEC` code bedrock_can maps.
fn lec(code: mcan::LastErrorCode) -> u8 {
    use mcan::LastErrorCode as L;
    match code {
        L::NoError => 0,
        L::Stuff => 1,
        L::Form => 2,
        L::Ack => 3,
        L::Bit1 => 4,
        L::Bit0 => 5,
        L::Crc => 6,
        L::NoChange => 7,
    }
}
