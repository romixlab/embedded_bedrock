/// The FDCAN peripherals, their pins{{ " and the transceivers' standby pins" if c.standby_any }}.
pub struct CanParts {
{% for ch in c.chans %}
    pub {{ ch.lower }}: Peri<'static, {{ ch.instance }}>,
    pub {{ ch.lower }}_tx: Peri<'static, embassy_stm32::peripherals::{{ ch.tx }}>,
    pub {{ ch.lower }}_rx: Peri<'static, embassy_stm32::peripherals::{{ ch.rx }}>,
  {% if ch.standby %}
    /// {{ ch.transceiver ~ "'s" if ch.transceiver else "The transceiver's" }} standby input: {{ ch.standby_active }} puts it in standby
    pub {{ ch.lower }}_standby: Peri<'static, embassy_stm32::peripherals::{{ ch.standby }}>,
  {% endif %}
{% endfor %}
}

/// An FDCAN's pins in their alternate function, kept for good (embassy's `TxPin` / `RxPin` know the AF number).
fn can_pins<T: embassy_stm32::can::Instance>(
    tx: Peri<'static, impl embassy_stm32::can::TxPin<T>>,
    rx: Peri<'static, impl embassy_stm32::can::RxPin<T>>,
) {
    use embassy_stm32::gpio::{AfType, OutputType, Pull{{ "" if c.standby_any else ", Speed" }}};
    let af = tx.af_num();
    let mut pin = Flex::new(tx);
    pin.set_as_af_unchecked(af, AfType::output(OutputType::PushPull, Speed::VeryHigh));
    core::mem::forget(pin);
    let af = rx.af_num();
    let mut pin = Flex::new(rx);
    pin.set_as_af_unchecked(af, AfType::input(Pull::None));
    core::mem::forget(pin);
}

/// Starts the CAN tasks on their interrupt executor (above thread mode, below the FDCAN and USB interrupts), each
/// channel in the default configuration ([bedrock_can::default_config]).
pub fn start(parts: CanParts) {
    // embassy-stm32 owns RCC (mcan without its `rcc` feature): the FDCAN clock (one for all instances) on and reset;
    // the kernel clock is selected in main.rs
{% for ch in c.chans %}
    let _owned = parts.{{ ch.lower }};
{% endfor %}
    embassy_stm32::rcc::enable_and_reset::<{{ c.periphs[0] }}>();
{% for ch in c.chans %}
    can_pins::<{{ ch.instance }}>(parts.{{ ch.lower }}_tx, parts.{{ ch.lower }}_rx);
{% endfor %}
{% if h7 %}
    let (mut instances, builder) = unwrap!(FdCanInstances::new());
{% else %}
    let mut instances = unwrap!(FdCanInstances::new());
{% endif %}
    let controller = controller();
    info!("CAN: kernel clock {} Hz", controller.clock_hz);
{% for irq in c.irqs %}
    interrupt::{{ irq.name }}.set_priority(Priority::{{ c.priority[0] }});
{% endfor %}
    interrupt::{{ c.executor }}.set_priority(Priority::{{ c.priority[1] }});
    let spawner = EXECUTOR.start(interrupt::{{ c.executor }});
{% for ch in c.chans %}

    // {{ ch.instance }}: can[{{ ch.index }}]
  {% if ch.standby %}
    // the transceiver out of standby, for good
    let standby = Output::new(parts.{{ ch.lower }}_standby, Level::{{ "Low" if ch.standby_active == "high" else "High" }}, Speed::Low);
  {% endif %}
    let can = unwrap!(instances.take(FdCanInstance::FdCan{{ ch.n }}));
  {% if h7 %}
    let (layout, builder) = unwrap!(ram_layout(builder, &controller));
  {% endif %}
    let can = match can.into_config_mode() {
        Ok(can) => can,
        Err((e, _)) => defmt::panic!("{{ ch.instance }} doesn't answer: {}", e),
    };
    unwrap!(CHANS[{{ ch.index }}].status.init(can.status_reader()).ok());
    spawner.spawn(unwrap!(can_task(&CHANS[{{ ch.index }}], can, {{ "layout, " if h7 }}{{ "Some(standby)" if ch.standby else "None" }})));
{% endfor %}
{% if h7 %}
    let _ = builder;
{% endif %}
{% for irq in c.irqs %}
    // SAFETY: the handler above only calls mcan's interrupt handler
    unsafe { interrupt::{{ irq.name }}.enable() };
{% endfor %}
}
{% if h7 %}

/// The next part of the message RAM for one instance, sizes in [controller]. A transmit FIFO and no dedicated transmit
/// buffers, so ES0491 2.22.2 "Tx FIFO messages inverted under specific buffer usage and priority setting" (dedicated
/// Tx buffers next to the FIFO) doesn't apply.
fn ram_layout(
    builder: mcan::MessageRamBuilder<mcan::RamBuilderInitialState>,
    c: &Controller,
) -> Result<
    (
        MessageRamLayout,
        mcan::MessageRamBuilder<mcan::RamBuilderInitialState>,
    ),
    mcan::MessageRamBuilderError,
> {
    builder
        .allocate_11bit_filters(c.standard_filters)?
        .allocate_29bit_filters(c.extended_filters)?
        .allocate_rx_fifo0_buffers(c.rx_fifo0, DataFieldSize::_64Bytes)?
        .allocate_rx_fifo1_buffers(c.rx_fifo1, DataFieldSize::_64Bytes)?
        .skip_dedicated_buffers()
        .allocate_tx_event_fifo_buffers(0)?
        .tx_buffer_element_size(DataFieldSize::_64Bytes)
        .allocate_fifo_or_queue(c.tx_fifo)?
        .allocate_triggers(0)
}
{% endif %}

/// The controller on the bus, in the mode the host chose.
enum Running {
    Normal(FdCan<NormalOperationMode>),
    Restricted(FdCan<RestrictedOperationMode>),
    ListenOnly(FdCan<BusMonitoringMode>),
    InternalLoopback(FdCan<InternalLoopbackMode>),
    ExternalLoopback(FdCan<ExternalLoopbackMode>),
}

/// `$body` with `$c` bound to the controller, whatever its mode.
macro_rules! each {
    ($running:expr, $c:ident => $body:expr) => {
        match $running {
            Running::Normal($c) => $body,
            Running::Restricted($c) => $body,
            Running::ListenOnly($c) => $body,
            Running::InternalLoopback($c) => $body,
            Running::ExternalLoopback($c) => $body,
        }
    };
}

/// `$body` with `$c` bound to the controller in a mode that sends, `$otherwise` in the others.
macro_rules! sending {
    ($running:expr, $c:ident => $body:expr, $otherwise:expr) => {
        match $running {
            Running::Normal($c) => $body,
            Running::InternalLoopback($c) => $body,
            Running::ExternalLoopback($c) => $body,
            Running::Restricted(_) | Running::ListenOnly(_) => $otherwise,
        }
    };
}

impl Running {
    /// Out of Config mode into `mode` (one of the modes [bedrock_can::mode_on_bus] accepts).
    fn start(
        can: FdCan<ConfigMode>,
        mode: Mode,
    ) -> Result<Running, (mcan::Error, FdCan<ConfigMode>)> {
        Ok(match mode {
            Mode::Restricted => Running::Restricted(can.into_restricted()?),
            Mode::ListenOnly => Running::ListenOnly(can.into_bus_monitoring()?),
            Mode::InternalLoopback => Running::InternalLoopback(can.into_internal_loopback()?),
            Mode::ExternalLoopback => Running::ExternalLoopback(can.into_external_loopback()?),
            _ => Running::Normal(can.into_normal()?),
        })
    }

    /// Back to Config mode; frames still in the transmit FIFO are dropped.
    fn stop(self) -> Result<FdCan<ConfigMode>, (mcan::Error, Running)> {
        match self {
            Running::Normal(c) => c
                .into_config_mode()
                .map_err(|(e, c)| (e, Running::Normal(c))),
            Running::Restricted(c) => c
                .into_config_mode()
                .map_err(|(e, c)| (e, Running::Restricted(c))),
            Running::ListenOnly(c) => c
                .into_config_mode()
                .map_err(|(e, c)| (e, Running::ListenOnly(c))),
            Running::InternalLoopback(c) => c
                .into_config_mode()
                .map_err(|(e, c)| (e, Running::InternalLoopback(c))),
            Running::ExternalLoopback(c) => c
                .into_config_mode()
                .map_err(|(e, c)| (e, Running::ExternalLoopback(c))),
        }
    }
}

/// One channel: applies the configuration, runs on the bus or waits off it, until the server's next command.
/// `_standby` holds the transceiver's standby pin at its level (a dropped `Output` would let it float).
#[embassy_executor::task(pool_size = COUNT)]
{% if h7 or c.standby_any %}
async fn can_task(
    ch: &'static Chan,
    mut can: FdCan<ConfigMode>,
  {% if h7 %}
    layout: MessageRamLayout,
  {% endif %}
    _standby: Option<{{ "Output<'static>" if c.standby_any else "Flex<'static>" }}>,
) {
{% else %}
{# exactly 100 columns on one line, as rustfmt keeps it #}
async fn can_task(ch: &'static Chan, mut can: FdCan<ConfigMode>, _standby: Option<Flex<'static>>) {
{% endif %}
    let controller = controller();
    let mut hw = unwrap!(
        bedrock_can::default_config(&controller),
        "the FDCAN kernel clock can't make 250 kbit/s"
    );
    let mut filters = HwFilters::accept_all();
    // a frame taken out of `tx` and not in the controller yet: kept across reconfigurations
    let mut pending: Option<TxItem> = None;
    loop {
        apply(&mut can, &hw, &filters{{ ", layout" if h7 }});
        info!(
            "CAN: nominal {} bit/s, FD {}, on bus {}",
            hw.nominal.bit_rate(controller.clock_hz),
            hw.data.map(|d| d.timing.bit_rate(controller.clock_hz)),
            bedrock_can::mode_on_bus(hw.mode)
        );
        let cmd = if bedrock_can::mode_on_bus(hw.mode) {
            match Running::start(can, hw.mode) {
                Ok(mut running) => {
                    let cmd = run(ch, &mut running, &hw, &mut pending).await;
                    drain_tx_hw(&mut running).await;
                    can = stop(running).await;
                    cmd
                }
                Err((e, c)) => {
                    warn!("CAN: can't go on the bus: {}", e);
                    cnt!(can_start_errors: u32);
                    can = c;
                    configured(ch, &mut pending).await
                }
            }
        } else {
            configured(ch, &mut pending).await
        };
        match cmd {
            Command::Configure(new) => hw = new,
            Command::SetFilters(new) => filters = new,
            // handled where they come in
            Command::Recover | Command::TxAbort => {}
        }
        ch.reply.signal(Reply::Done);
    }
}

/// Back to Config mode; setting INIT can't fail on a clocked controller, but if it does, it is tried again.
async fn stop(mut running: Running) -> FdCan<ConfigMode> {
    loop {
        match running.stop() {
            Ok(can) => return can,
            Err((e, r)) => {
                warn!("CAN: can't leave the bus: {}", e);
                cnt!(can_stop_errors: u32);
                running = r;
                Timer::after_millis(1).await;
            }
        }
    }
}

/// On the bus: receives, sends, recovers from bus-off, answers `Recover` and `TxAbort`; returns the first command
/// that needs the controller off the bus.
async fn run(
    ch: &'static Chan,
    can: &mut Running,
    hw: &HwConfig,
    pending: &mut Option<TxItem>,
) -> Command {
    let sends = bedrock_can::mode_sends(hw.mode);
    let mut bus_off_since: Option<Instant> = None;
    loop {
        receive(ch, can);
        if sends {
            send(ch, can, pending);
        } else {
            drop_queued(ch, pending);
        }
        // a frame in hand waits for room in the transmit FIFO (TX_COMPLETED), otherwise for the next one queued
        let next_tx = async {
            if pending.is_some() || !sends {
                core::future::pending().await
            } else {
                ch.tx.receive().await
            }
        };
        let tick = async {
            match hw.recovery {
                Recovery::AfterMs(_) => Timer::after_millis(BUS_OFF_POLL_MS).await,
                _ => core::future::pending().await,
            }
        };
        let r = select4(
            ch.commands.receive(),
            async { each!(&mut *can, c => c.wait_interrupts(EVENTS).await) },
            next_tx,
            tick,
        )
        .await;
        match r {
            Either4::First(Command::Recover) => ch.reply.signal(recover(can)),
            Either4::First(Command::TxAbort) => {
                ch.reply.signal(Reply::Aborted(abort(ch, can, pending)))
            }
            Either4::First(cmd) => return cmd,
            Either4::Second(flags) => count_fifo_overruns(ch, flags),
            Either4::Third(item) => *pending = Some(item),
            Either4::Fourth(()) => {
                if let Recovery::AfterMs(ms) = hw.recovery {
                    recover_after(can, ms, &mut bus_off_since);
                }
            }
        }
    }
}

/// Off the bus (`Off`, `Config`): answers commands, drops what is queued for sending.
async fn configured(ch: &'static Chan, pending: &mut Option<TxItem>) -> Command {
    drop_queued(ch, pending);
    loop {
        match select(ch.commands.receive(), ch.tx.receive()).await {
            Either::First(Command::Recover) => ch.reply.signal(Reply::NotBusOff),
            Either::First(Command::TxAbort) => {
                ch.reply.signal(Reply::Aborted(abort_queued(ch, pending)))
            }
            Either::First(cmd) => return cmd,
            Either::Second(item) => {
                cnt!(can_tx_dropped_off_bus: u32);
                ch.free(item.credit);
            }
        }
    }
}

/// Drops the frame in hand and the queue in a mode that doesn't send.
fn drop_queued(ch: &Chan, pending: &mut Option<TxItem>) {
    let n = abort_queued(ch, pending);
    if n > 0 {
        cnt!(can_tx_dropped_not_sending: u32 += n);
    }
}

/// Moves received frames from both FIFOs into [Chan::rx].
fn receive(ch: &Chan, can: &mut Running) {
    let mut any = false;
    for fifo in [RxFifo::Fifo0, RxFifo::Fifo1] {
        loop {
            let mut data = [0u8; 64];
            let header = match each!(&mut *can, c => c.receive_fifo(fifo, &mut data)) {
                Ok(Some((header, _))) => header,
                Ok(None) => break,
                Err(e) => {
                    // every element is 64 bytes, the buffer too: can't happen
                    warn!("CAN: receive: {}", e);
                    cnt!(can_rx_errors: u32);
                    break;
                }
            };
            let item = RxItem {
                header,
                data,
                t: Instant::now(),
            };
            if ch.rx.try_send(item).is_err() {
                cnt!(can_rx_queue_full: u32);
                ch.rx_lost.fetch_add(1, Ordering::Relaxed);
            }
            any = true;
        }
    }
    if any {
        WAKE.signal(());
    }
}

/// A receive FIFO that was full when a frame came in: at least one frame lost (`IR.RFnL`, M_CAN has no count).
fn count_fifo_overruns(ch: &Chan, flags: Interrupts) {
    for fifo in [RxFifo::Fifo0, RxFifo::Fifo1] {
        if flags.intersects(Interrupts::rx_fifo_message_lost(fifo)) {
            cnt!(can_rx_fifo_overruns: u32);
            ch.rx_lost.fetch_add(1, Ordering::Relaxed);
            WAKE.signal(());
        }
    }
}

/// Puts the frame in hand and what the server queued into the transmit FIFO while it has room; credit goes back for
/// every frame in the controller.
fn send(ch: &Chan, can: &mut Running, pending: &mut Option<TxItem>) {
    while let Some(item) = pending.take().or_else(|| ch.tx.try_receive().ok()) {
        let f = &item.frame;
        let data = &f.data[..(f.len as usize).min(64)];
        match sending!(&mut *can, c => c.transmit(f.header, data), Err(mcan::Error::TxQueueFull)) {
            Ok(_) => ch.free(item.credit),
            Err(mcan::Error::TxQueueFull) => {
                *pending = Some(item);
                return;
            }
            Err(e) => {
                // bedrock_can::tx_plan checked the frame: can't happen
                warn!("CAN: transmit: {}", e);
                cnt!(can_tx_errors: u32);
                ch.free(item.credit);
            }
        }
    }
}

/// Leaves bus-off `ms` after entering it (`Recovery::Immediate` is done by mcan's interrupt handler).
fn recover_after(can: &mut Running, ms: u32, since: &mut Option<Instant>) {
    if !each!(&*can, c => c.is_bus_off()) {
        *since = None;
        return;
    }
    let at = *since.get_or_insert_with(Instant::now);
    if at.elapsed().as_millis() >= ms as u64 {
        info!("CAN: bus-off for {} ms, recovering", ms);
        if sending!(&mut *can, c => c.recover_from_bus_off(), Ok(false)).is_err() {
            cnt!(can_recovery_errors: u32);
        }
        *since = None;
    }
}

fn recover(can: &mut Running) -> Reply {
    // bus-off set INIT: clearing it starts the recovery sequence (129 x 11 recessive bits)
    match sending!(&mut *can, c => c.recover_from_bus_off(), Ok(false)) {
        Ok(true) => Reply::Done,
        Ok(false) => Reply::NotBusOff,
        Err(e) => {
            warn!("CAN: recovery: {}", e);
            cnt!(can_recovery_errors: u32);
            Reply::Done
        }
    }
}

/// Drops the frame in hand and the queue; the number dropped.
fn abort_queued(ch: &Chan, pending: &mut Option<TxItem>) -> u32 {
    let mut n = 0;
    if let Some(item) = pending.take() {
        ch.free(item.credit);
        n += 1;
    }
    while let Ok(item) = ch.tx.try_receive() {
        ch.free(item.credit);
        n += 1;
    }
    n
}

/// Drops the queue, the frame in hand and what the controller hasn't sent yet.
fn abort(ch: &Chan, can: &mut Running, pending: &mut Option<TxItem>) -> u32 {
    abort_queued(ch, pending) + sending!(&mut *can, c => c.cancel_pending(), 0)
}

/// Before leaving the bus: waits a little for the frames in the controller to go out; what is left is cancelled
/// (leaving for Config mode would clear the requests too) and counted.
async fn drain_tx_hw(can: &mut Running) {
    let start = Instant::now();
    // restricted and listen-only never send (TXBRP is held in reset)
    while !sending!(&*can, c => c.is_idle(), true) {
        if start.elapsed().as_millis() >= TX_DRAIN_MS {
            let left = sending!(&mut *can, c => c.cancel_pending(), 0);
            warn!("CAN: {} frames dropped on reconfiguration", left);
            cnt!(can_tx_dropped_reconfigure: u32 += left);
            return;
        }
        Timer::after_micros(200).await;
    }
}

