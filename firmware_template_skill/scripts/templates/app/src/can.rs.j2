/// Channels: `can[i]` is [CHANS]`[i]`.
pub const COUNT: usize = {{ c.count }};
/// Received frames the queue to the server holds per channel.
pub const RX_QUEUE: usize = {{ c.rx_queue }};
/// Frames the transmit queue holds per channel; [TX_CREDIT] bytes of the smallest `TxFrame` fit.
pub const TX_QUEUE: usize = {{ c.tx_queue }};
/// Credit of `can[i].tx` in bytes of serialized `TxFrame`s: the smallest one (a standard ID, no data, no marker)
/// takes 4 bytes, so [TX_QUEUE] frames always hold it.
pub const TX_CREDIT: u32 = {{ c.tx_credit }};
/// How long a reconfiguration waits for frames already in the controller to go out before dropping them.
const TX_DRAIN_MS: u64 = 20;
/// How often the task looks for bus-off with a delayed recovery.
const BUS_OFF_POLL_MS: u64 = 10;
/// What wakes the task on the bus: a frame in a receive FIFO, one lost, room in the transmit FIFO.
const EVENTS: Interrupts = Interrupts::RX_FIFO0_NEW_MESSAGE
    .union(Interrupts::RX_FIFO1_NEW_MESSAGE)
    .union(Interrupts::RX_FIFO0_MESSAGE_LOST)
    .union(Interrupts::RX_FIFO1_MESSAGE_LOST)
    .union(Interrupts::TX_COMPLETED)
    .union(Interrupts::TX_CANCELLATION_FINISHED);

/// What every channel's controller can do: the FDCAN kernel clock (`fdcan_ker_ck`, the same for all instances) and
/// the message RAM layout [start] gives it.
pub fn controller() -> Controller {
    Controller::{{ c.layout }}(embassy_stm32::rcc::frequency::<{{ c.periphs[0] }}>().0)
}

/// A received frame and when it was read out of the controller.
pub struct RxItem {
    pub header: RxFrameHeader,
    /// `header.len` bytes (none for a remote frame).
    pub data: [u8; 64],
    pub t: Instant,
}

impl RxItem {
    pub fn data(&self) -> &[u8] {
        if self.header.rtr {
            return &[];
        }
        &self.data[..(self.header.len as usize).min(64)]
    }
}

/// A frame for the controller: header and `len` bytes (the DLC of a remote frame, which sends no data).
pub struct TxFrame {
    pub header: TxFrameHeader,
    pub data: [u8; 64],
    pub len: u8,
}

/// A frame to send and the credit it took on `tx`, given back when it is in the controller (or dropped).
pub struct TxItem {
    pub frame: TxFrame,
    pub credit: u32,
}

/// What the server asks of a channel's task. The filter list makes it large; it lives in [Chan]'s one command slot,
/// no heap.
#[allow(clippy::large_enum_variant)]
pub enum Command {
    /// Off the bus, apply, back in the configuration's mode; frames queued in `tx` stay queued.
    Configure(HwConfig),
    /// The same with a new filter list.
    SetFilters(HwFilters),
    /// Bus-off recovery now.
    Recover,
    /// Drop every frame queued.
    TxAbort,
}

/// The task's answer to a [Command].
pub enum Reply {
    Done,
    /// `Recover` while not bus-off.
    NotBusOff,
    /// `TxAbort`: frames dropped.
    Aborted(u32),
}

/// One channel's queues and state, shared by its task and the server.
pub struct Chan {
    /// Task -> server: received frames.
    pub rx: Channel<CriticalSectionRawMutex, RxItem, RX_QUEUE>,
    /// Received frames lost before [Chan::rx] (a full receive FIFO in the controller, a full `rx`), for the stream
    /// head.
    pub rx_lost: AtomicU32,
    /// Server -> task: frames to send.
    pub tx: Channel<CriticalSectionRawMutex, TxItem, TX_QUEUE>,
    /// Credit bytes of frames handed to the controller or dropped, for the server to give back.
    pub tx_freed: AtomicU32,
    commands: Channel<CriticalSectionRawMutex, Command, 1>,
    reply: Signal<CriticalSectionRawMutex, Reply>,
    /// The controller's status, readable while its task owns it.
    status: OnceLock<StatusReader>,
    /// `ECR.CEL` is cleared by every read: the errors counted by reads for the status, until `protocol_status` takes
    /// them.
    error_log: AtomicU32,
}

impl Chan {
    const fn new() -> Chan {
        Chan {
            rx: Channel::new(),
            rx_lost: AtomicU32::new(0),
            tx: Channel::new(),
            tx_freed: AtomicU32::new(0),
            commands: Channel::new(),
            reply: Signal::new(),
            status: OnceLock::new(),
            error_log: AtomicU32::new(0),
        }
    }

    /// Runs `cmd` on the channel's task and waits for its answer (a reconfiguration takes up to [TX_DRAIN_MS] and 11
    /// recessive bits). Only the server calls it, one command at a time.
    pub async fn command(&self, cmd: Command) -> Reply {
        self.commands.send(cmd).await;
        self.reply.wait().await
    }

    /// Hands credit back to the server.
    fn free(&self, credit: u32) {
        self.tx_freed.fetch_add(credit, Ordering::Relaxed);
        WAKE.signal(());
    }
}

/// The channels, in `can[]` order: {{ c.names }}.
pub static CHANS: [Chan; COUNT] = [const { Chan::new() }; COUNT];
/// Wakes the server when a channel received frames or freed credit.
pub static WAKE: Signal<CriticalSectionRawMutex, ()> = Signal::new();

static EXECUTOR: embassy_executor::InterruptExecutor = embassy_executor::InterruptExecutor::new();

#[interrupt]
unsafe fn {{ c.executor }}() {
    // {{ c.executor }} is not used by this firmware: its interrupt runs the CAN executor
    unsafe { EXECUTOR.on_interrupt() }
}
{% for irq in c.irqs %}

