{# extra = additional RAM Regions, sram_enable = {region name: [(rcc register, field)]} #}
{% set first = extra[0].name | lower %}
{% if t.family == "stm32" %}
//! Enable (clock) and zero additional RAM banks. The startup code only zeroes .bss in the main RAM region;
//! anything placed into other banks (e.g. `#[unsafe(link_section = ".{{ first }}")] static ...`) must be zeroed here.
//! Generated from stm32-data; verify enable bits against the reference manual.
{% else %}
//! Zero additional RAM banks ({{ extra | map(attribute="name") | join(", ") }}). The startup code only zeroes .bss in the main RAM region;
//! anything placed into other banks (e.g. `#[unsafe(link_section = ".{{ first }}")] static ...`) must be zeroed here.
  {% if t.family == "rp" %}
//! On {{ "RP2040" if t.rp_variant == "rp2040" else "RP235x" }} all SRAM banks are powered and clocked out of reset, so no enable step is needed.
  {% else %}
//! Check the reference manual whether these banks need to be powered or clocked first.
  {% endif %}
{% endif %}

pub(crate) fn init_ram() {
{% for r in extra %}
    init_{{ r.name | lower }}();
{% endfor %}
}
{% for r in extra %}
  {% set name = r.name | lower %}
  {% set bits = sram_enable.get(r.name, []) %}

fn init_{{ name }}() {
    unsafe {
        unsafe extern "C" {
            static mut __{{ name }}_start: u8;
            static mut __{{ name }}_end: u8;
        }
  {% if bits and embassy_stm32 %}
        let rcc = embassy_stm32::pac::RCC;
    {% for reg, fld in bits %}
        rcc.{{ reg }}().modify(|w| w.set_{{ fld }}(true));
    {% endfor %}
  {% elif bits %}
        // TODO: enable clock: {{ bits | map("rcc_bit") | join(", ") }}
  {% elif t.family == "stm32" %}
        // {{ r.name }}: no RCC enable bit found, assumed always on
  {% endif %}
        let count = &raw const __{{ name }}_end as usize - &raw const __{{ name }}_start as usize;
        core::ptr::write_bytes(&raw mut __{{ name }}_start, 0, count);
    }
}
{% endfor %}
