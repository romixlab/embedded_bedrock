{# The shared clock (--clock-sync, TPL-40): bedrock_sync's static, steered through `clock` (src/ww/clock.rs).
   `c` = s.clock (source, rtt, oscillator), s.led.pwm: the LED breathes on it. #}
{% set c = s.clock %}
{% set on = "embassy-time on " ~ c.source if c.source != "embassy-time" else "embassy-time" %}
{% if s.led.pwm %}
//! The shared clock: a host's steer points discipline the local clock ({{ on }}) onto UTC, so {{ s.led.name }}
//! (src/led.rs) breathes in phase with other boards. Served as `clock` (`ww_timebase::Clock`) by src/ww/clock.rs; this
//! module only holds the static, as src/led.rs holds the indication.
{% else %}
//! The shared clock: a host's steer points discipline the local clock ({{ on }}) onto UTC, for actions scheduled in
//! shared time (`bedrock_sync::Sync::wait_until_shared`). Served as `clock` (`ww_timebase::Clock`) by
//! src/ww/clock.rs; this module only holds the static.
{% endif %}
//!
{% if c.oscillator %}
//! No sync line and no oscillator backend: {{ c.oscillator }}, the shared clock is
//! corrected in software only (bedrock_sync slews it).
{% else %}
//! No sync line and no oscillator backend: the shared clock is corrected in software only (bedrock_sync slews it).
{% endif %}

{% if s.led.pwm %}
/// The board's shared clock, read by the LED task every tick and steered from `clock.steer` (src/ww/clock.rs).
{% else %}
/// The board's shared clock, steered from `clock.steer` (src/ww/clock.rs).
{% endif %}
{% if c.rtt %}
pub static SYNC: bedrock_sync::Sync = bedrock_sync::Sync::new(CONFIG);

/// bedrock_sync's defaults with a lock tolerance for RTT: the host polls RTT through the probe, so round trips are
/// 6–13 ms and the error bound the host sends with each steer point (half the shortest round trip plus twice the
/// fit's scatter) is about 4 ms, more than the default 2 ms (sized for a full-speed USB board). 10 ms keeps a
/// slower probe or a busy PC locked; a 3 s breath looks in phase far beyond that.
const CONFIG: bedrock_sync::Config = bedrock_sync::Config {
    lock_within_us: 10_000,
    ..bedrock_sync::Config::DEFAULT
};
{% else %}
/// bedrock_sync's defaults: locked within 2 ms, sized for a full-speed USB board.
pub static SYNC: bedrock_sync::Sync = bedrock_sync::Sync::new(bedrock_sync::Config::DEFAULT);
{% endif %}
