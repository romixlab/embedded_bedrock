{# The framework/family specific part comes from main/<variant>.rs.j2 #}
#![no_std]
#![no_main]

{% if s.dev.boot %}
mod boot;
{% endif %}
{% if o.build_info %}
mod build_info;
{% endif %}
{% if have_init %}
mod init;
{% endif %}
{% if have_init_ram %}
mod init_ram;
{% endif %}
{% if o.crash %}
mod last_reset;
{% endif %}
{% if s.led.pwm %}
mod led;
{% endif %}
{% if s.dev.log %}
mod log;
{% endif %}
{% if o.settings_flash %}
mod settings;
{% endif %}
{% if o.ww %}
mod ww;
{% endif %}
{% set ww_rtt = o.ww and ww.rtt and not s.dev.log %}{# with device.log, src/log.rs sets RTT up #}
{# `use` lines follow the mods (a panic crate, logging, cnt): else the blank line before the include separates them #}
{% set have_uses = o.log != "none" or t.family == "esp" or not o.crash or ww_rtt or o.counters %}
{% if (o.build_info or have_init or have_init_ram or o.ww or o.crash or o.settings_flash or s.led.pwm) and have_uses %}

{% endif %}
{# --- logging / panic handler --- #}
{% if o.log == "defmt" %}
  {% if t.cortex_m and s.led.pwm %}
use defmt::{info, error, unwrap};
  {% elif t.cortex_m %}
use defmt::{info, error};
  {% else %}
use defmt::info;
  {% endif %}
  {% if t.family == "esp" %}
use esp_println as _;
  {% else %}
    {% if not ww_rtt and not s.dev.log %}
use defmt_rtt as _;
    {% endif %}
    {% if not o.crash %}
use panic_probe as _;
    {% endif %}
  {% endif %}
{% elif o.log == "rtt" %}
use rtt_target::{rprintln, {{ "rtt_init" if ww_rtt else "rtt_init_print" }}};
  {% if not o.crash %}
use panic_rtt_target as _;
  {% endif %}
{% elif o.log == "esp-println" %}
use log::info;
{% elif t.family == "esp" %}
use esp_backtrace as _;
{% elif not o.crash %}
use panic_halt as _;
{% endif %}
{% if ww_rtt %}
  {% if o.log == "rtt" %}
use rtt_target::ChannelMode::NoBlockSkip;
  {% else %}
use rtt_target::{ChannelMode::NoBlockSkip, rtt_init};
  {% endif %}
{% endif %}
{% if t.family == "esp" and o.log in ("defmt", "esp-println") %}
use esp_backtrace as _;
{% endif %}
{% if o.counters %}
use cnt::cnt;{{ " // cnt::bkp_cnt! for counters in backup registers" if bkp_words else "" }}
{% endif %}

{% include "app/src/main/" ~ main_variant ~ ".rs.j2" %}
{% if t.cortex_m %}

#[exception]
unsafe fn DefaultHandler(irqn: i16) {
  {% if o.counters %}
    cnt!(unhandled_exceptions: u32, warn);
    {% if bkp_words %}
    cnt::bkp_cnt!(unhandled_exceptions_total: u32, warn);
    {% endif %}
  {% endif %}
  {% if o.log != "none" %}
    {{ err }}("unhandled exception, IRQn = {}", irqn);
  {% else %}
    let _ = irqn;
  {% endif %}
}

{% if o.settings_flash == "g0" %}
#[exception]
unsafe fn NonMaskableInt() {
    // a flash word with an ECC error, read by the settings store (a power cut while it was written): it reads as
    // zeros, the store skips it
    if ww_ecc_flash::on_nmi() {
        return;
    }
    panic!("NMI: not a flash ECC error of a settings read");
}

{% endif %}
#[exception]
unsafe fn HardFault(ef: &cortex_m_rt::ExceptionFrame) -> ! {
  {% if o.crash %}
    let exc_return = bedrock_crash::exc_return!(); // first: lr still holds EXC_RETURN here
    // Saved for the next boot (src/last_reset.rs{{ ", served as LastReset" if o.ww else "" }}). With `probe-rs run` the debugger
    // stops at the fault before this handler runs.
    unsafe { bedrock_crash::capture_fault(ef, exc_return, last_reset::uptime_ms()) };
  {% endif %}
  {% if bkp_words %}
    cnt::bkp_cnt!(hard_faults: u32, error);
  {% endif %}
  {% if o.log == "defmt" %}
    error!("HardFault {}", defmt::Debug2Format(ef));
  {% elif o.log == "rtt" %}
    rprintln!("HardFault {:?}", ef);
  {% elif not o.crash %}
    let _ = ef;
  {% endif %}
  {% if o.crash %}
    bedrock_crash::reset()
  {% else %}
    // TODO: consider cortex_m::peripheral::SCB::sys_reset() in production
    loop {}
  {% endif %}
}
{% endif %}
