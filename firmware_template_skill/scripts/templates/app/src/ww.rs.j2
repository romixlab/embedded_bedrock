pub type UsbDriver = Driver<'static, peripherals::USB>;
  {% elif t.family == "nrf" %}
bind_interrupts!(struct Irqs {
    USBD => usb::InterruptHandler<peripherals::USBD>;
    CLOCK_POWER => usb::vbus_detect::InterruptHandler;
});

pub type UsbDriver = Driver<'static, HardwareVbusDetect>;
  {% endif %}

const MAX_USB_PACKET_LEN: usize = 64; // Full Speed
static USB_BUFFERS: StaticCell<UsbBuffers<MAX_USB_PACKET_LEN, MAX_MESSAGE_LEN>> = StaticCell::new();
  {% if t.family == "stm32" and u.otg %}
static EP_OUT_BUFFER: StaticCell<[u8; 256]> = StaticCell::new();
  {% endif %}

  {% if t.family == "stm32" %}
pub fn usb_driver(
    usb: Peri<'static, peripherals::{{ u.periph }}>,
    dp: Peri<'static, peripherals::{{ u.dp }}>,
    dm: Peri<'static, peripherals::{{ u.dm }}>,
) -> UsbDriver {
    {% if u.otg %}
    let mut config = usb::Config::default();
    // TODO: true if VBUS is wired to the VBUS sense pin, lets the device detect unplugging
    config.vbus_detection = false;
      {% if o.embassy == "main" %}
    usb::Driver::new_fs(usb, dp, dm, Irqs, EP_OUT_BUFFER.init([0; 256]), config)
      {% else %}
    usb::Driver::new_fs(usb, Irqs, dp, dm, EP_OUT_BUFFER.init([0; 256]), config)
      {% endif %}
    {% elif o.embassy == "main" %}
    usb::Driver::new(usb, dp, dm, Irqs)
    {% else %}
    usb::Driver::new(usb, Irqs, dp, dm)
    {% endif %}
}
  {% elif t.family == "rp" %}
pub fn usb_driver(usb: Peri<'static, peripherals::USB>) -> UsbDriver {
    Driver::new(usb, Irqs)
}
  {% elif t.family == "nrf" %}
pub fn usb_driver(usbd: Peri<'static, peripherals::USBD>) -> UsbDriver {
    // USB needs the external high frequency crystal
    pac::CLOCK.tasks_hfclkstart().write_value(1);
    while pac::CLOCK.events_hfclkstarted().read() != 1 {}
    Driver::new(usbd, Irqs, HardwareVbusDetect::new(Irqs))
}
  {% endif %}

pub fn start(spawner: Spawner, driver: UsbDriver, state: ServerState) {
    // server_impl::API_ID is reported in a USB string descriptor, `ww list` shows it without opening the device.
    // A user label (e.g. loaded from flash) can be added with wire_weaver::api_id::with_label().
{% set db = t.family == "stm32" and o.embassy == "main" and u.double_buffer %}
  {% if db %}
    // Double-buffered bulk endpoints (embassy-rs/embassy#7275): {{ u.periph }} takes the next packet while the last one
    // is processed instead of making the host retry, ~2x the throughput behind a USB hub (Donguru FW-24).
  {% endif %}
    let (usb, server) = {{ "usb_init_with_endpoints" if db else "usb_init" }}(
        driver,
        USB_BUFFERS.init(UsbBuffers::default()),
        UsbTimings::fs_higher_speed(),
        link_config(),
        server_impl::API_ID,
        |config| {
            // VID:PID is c0de:cafe unless set here
            config.product = Some("{{ o.name }}");
  {% if t.family == "stm32" %}
            config.serial_number = Some(embassy_stm32::uid::uid_hex());
  {% endif %}
        },
  {% if db %}
        |alt| {
            (
                alt.endpoint_bulk_out_double_buffered(None, MAX_USB_PACKET_LEN as u16),
                alt.endpoint_bulk_in_double_buffered(None, MAX_USB_PACKET_LEN as u16),
            )
        },
  {% endif %}
    );
    spawner.spawn(unwrap!(usb_task(usb)));
    spawner.spawn(unwrap!(server_task(server, state)));
}

#[embassy_executor::task]
async fn usb_task(mut usb: UsbDevice<'static, UsbDriver>) {
    usb.run().await;
}
  {% set server_ty = "UsbServer<'static, UsbDriver>" %}
{% else %}

static RTT_BUFFERS: StaticCell<RttBuffers<MAX_MESSAGE_LEN>> = StaticCell::new();

pub fn start(spawner: Spawner, up: UpChannel, down: DownChannel, state: ServerState) {
    let server = rtt_server(
        link_config(),
        up,
        down,
        EmbassyClock,
        RttConfig::default(),
        RTT_BUFFERS.init(RttBuffers::new()),
    );
  {% if defmt %}
    spawner.spawn(unwrap!(server_task(server, state)));
  {% else %}
    spawner.spawn(server_task(server, state).unwrap());
  {% endif %}
}
  {% set server_ty = "RttServer<'static, EmbassyClock>" %}
{% endif %}

{% if streams and settings %}
/// Serves requests; every [PUMP_PERIOD](crate::log::PUMP_PERIOD) moves the defmt log into its store (src/log.rs) and
/// sends what the log stream has to a host that opened it; writes the settings once they settle, also while no host
/// is connected (a change made just before it left still reaches the flash). The log stays in its store while no
/// host is connected, a host that comes back resumes it.
{% elif streams %}
/// Serves requests; every [PUMP_PERIOD](crate::log::PUMP_PERIOD) moves the defmt log into its store (src/log.rs) and
/// sends what the log stream has to a host that opened it. The log stays in its store while no host is connected, a
/// host that comes back resumes it.
{% endif %}
#[embassy_executor::task]
async fn server_task(mut server: {{ server_ty }}, mut state: ServerState) {
{% if streams %}
    let mut stream_buf = [0u8; STREAM_BUF_LEN];
    let mut next_pump = Instant::now() + crate::log::PUMP_PERIOD;
    loop {
  {% if settings %}
        match select3(
            server.wait(),
            Timer::at(next_pump),
            Timer::at(state.settings.due_at()),
        )
        .await
        {
            Either3::First(ready) => {
                if let Some(event) = server.handle(ready, &mut state).await {
                    info!("{:?}", event);
                    if matches!(event, LinkEvent::Down(_)) {
                        state.log_frames.detach();
                    }
                }
            }
            Either3::Second(()) => next_pump += crate::log::PUMP_PERIOD,
            Either3::Third(()) => state.settings.persist_if_due().await,
        }
  {% else %}
        match select(server.wait(), Timer::at(next_pump)).await {
            Either::First(ready) => {
                if let Some(event) = server.handle(ready, &mut state).await {
                    info!("{:?}", event);
                    if matches!(event, LinkEvent::Down(_)) {
                        state.log_frames.detach();
                    }
                }
            }
            Either::Second(()) => next_pump += crate::log::PUMP_PERIOD,
        }
  {% endif %}
        crate::log::pump(&mut state.log_frames).await;
        if server.is_up()
            && state
                .poll_streams(
                    &mut server.sink(),
                    Instant::now().as_millis(),
                    &mut stream_buf,
                    STREAM_BUDGET,
                )
                .await
                .is_err()
        {
  {% if o.counters %}
            cnt!(stream_send_errors: u32);
  {% else %}
            // a send that failed: the stream sends it again
  {% endif %}
        }
    }
{% elif settings %}
    loop {
        // also while no host is connected: a change made just before it left still reaches the flash
        match select(server.wait(), Timer::at(state.settings.due_at())).await {
            Either::First(ready) => {
                server.handle(ready, &mut state).await;
            }
            Either::Second(()) => state.settings.persist_if_due().await,
        }
    }
{% else %}
    // Nothing else to wait for: the prepared loop. Use server.wait() / server.handle() to also react to other events.
    server.run(&mut state).await;
{% endif %}
}
