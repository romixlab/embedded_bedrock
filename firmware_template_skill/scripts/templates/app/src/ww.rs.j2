{% if ww.usb %}
/// Longest WireWeaver message the device accepts and can reply with (reported to the host)
{% else %}
/// Longest WireWeaver message the device accepts and can reply with (reported to the host). The RTT up channel
/// (`ww_up` in {{ "log.rs" if d.log else "main.rs" }}) must be at least `MAX_MESSAGE_LEN + 5` bytes, better twice that.
{% endif %}
const MAX_MESSAGE_LEN: usize = 1024;
{% if streams %}

/// Biggest item of a reliable stream: `device.log.frames`' `DefmtFrames` (512 B of frames and its length).
const STREAM_BUF_LEN: usize = ww_log::MAX_FRAMES_LEN + 16;
/// Bytes of stream items sent per turn of the server task (at least one event), so requests keep being served.
const STREAM_BUDGET: usize = 2048;
{% endif %}

/// Everything the API implementation needs: peripherals, drivers, state.
pub struct ServerState {
{% if not leds %}
    pub led: Output<'static>,
{% endif %}
{% if o.crash %}
    /// Reset cause and crash record read at boot (src/last_reset.rs)
    last_reset: bedrock_crash::Snapshot,
{% endif %}
{% if settings %}
    /// Settings in flash (src/settings.rs): `device.label`, `device.settings`
    settings: crate::settings::SettingsStore,
{% endif %}
{% if streams %}
    /// `device.log.frames`: the defmt log (src/log.rs)
    log_frames: crate::log::Stream,
{% endif %}
    /// `device.uid.IDS`: the {{ u_id.doc }}
    uid: [UniqueId<'static>; 1],
{% if t.family != "stm32" %}
    /// `device.board`'s serial: the unique id in hex
    serial: &'static str,
{% endif %}
{% if d.counters %}
    /// `device.counters.read`: one page of counter words, copied at once
    counters_page: [UVlq32; ww_counters::MAX_WORDS],
{% endif %}
{% if streams %}
    /// Sessions of reliable streams opened so far, see [Self::new_stream_session]
    stream_sessions: u32,
{% endif %}
{% if leds %}
    /// `leds`: mode, brightness and the end of a running identify (src/led.rs shows them)
    leds: leds::LedsState,
{% endif %}
}
{% if not u_id.ref %}

/// The chip's unique id, read once
static UID: StaticCell<[u8; {{ u_id.len }}]> = StaticCell::new();
{% endif %}
{% if t.family != "stm32" %}
/// [UID] in hex, `device.board`'s serial
static SERIAL: StaticCell<[u8; {{ 2 * u_id.len }}]> = StaticCell::new();
{% endif %}

impl ServerState {
{% set params = ([] if leds else ["led: Output<'static>"]) + (["last_reset: bedrock_crash::Snapshot"] if o.crash else [])
     + (["settings: crate::settings::SettingsStore"] if settings else []) + (["uid: [u8; " ~ u_id.len ~ "]"] if u_id.arg else []) %}
{% set sig = "    pub " ~ ("async " if streams else "") ~ "fn new(" %}
{% if (sig ~ params | join(", ") ~ ") -> Self {") | length <= 100 %}
{{ sig }}{{ params | join(", ") }}) -> Self {
{% else %}
{{ sig }}
  {% for p in params %}
        {{ p }},
  {% endfor %}
    ) -> Self {
{% endif %}
{% if streams %}
  {% if o.crash %}
        // the boot count in the high half: a session of this boot never takes a host's cursor of an earlier boot
        // for its own (the boot count restarts at a power-on, the log store is lost with it then)
        let stream_sessions = last_reset.view().boot_count << 16 | 1;
  {% else %}
        // no boot count without crash capture: every boot starts at session 1, a host may take its cursor of an
        // earlier boot for this one's
        let stream_sessions = 1;
  {% endif %}
{% endif %}
{% if t.family != "stm32" %}
        let uid = UID.init({{ u_id.expr }});
{% endif %}
        ServerState {
{% if not leds %}
            led,
{% endif %}
{% if o.crash %}
            last_reset,
{% endif %}
{% if settings %}
            settings,
{% endif %}
{% if streams %}
            log_frames: crate::log::stream(stream_sessions).await,
{% endif %}
            uid: [UniqueId {
                kind: UidKind::{{ u_id.kind }},
                source: UidSource::{{ u_id.source }},
{% if t.family == "stm32" %}
  {% if u_id.ref %}
                value: MaxLen::new_unchecked(RefVec::new_bytes({{ u_id.expr }})),
  {% else %}
                value: MaxLen::new_unchecked(RefVec::new_bytes(
                    UID.init({{ u_id.expr }}),
                )),
  {% endif %}
{% else %}
                value: MaxLen::new_unchecked(RefVec::new_bytes(uid)),
{% endif %}
            }],
{% if t.family != "stm32" %}
            serial: hex(uid, SERIAL.init([0; {{ 2 * u_id.len }}])),
{% endif %}
{% if d.counters %}
            counters_page: [UVlq32(0); ww_counters::MAX_WORDS],
{% endif %}
{% if streams %}
            stream_sessions,
{% endif %}
{% if leds %}
            leds: leds::LedsState::new(),
{% endif %}
        }
    }
{% if streams %}

    /// Number of a new session of a reliable stream, when a host opens one anew.
    fn new_stream_session(&mut self) -> u32 {
        // the first one went to the log at boot (`ServerState::new`)
        self.stream_sessions = self.stream_sessions.wrapping_add(1);
        self.stream_sessions
    }
{% endif %}
}
{% if t.rp_variant and t.rp_variant != "rp2040" %}

/// The RP2350's 64-bit chip id (OTP CHIPID0..3), zeros when the OTP read fails
fn chip_id() -> [u8; 8] {
    embassy_rp::otp::get_chipid().unwrap_or(0).to_be_bytes()
}
{% elif t.family == "nrf" %}

/// The 64-bit device id ({{ u_id.reg }}[1] the high word)
fn device_id() -> [u8; 8] {
    let ficr = {{ hal }}::pac::FICR;
    let id = (ficr.{{ u_id.reg | replace("FICR.", "") }}(1).read() as u64) << 32 | ficr.{{ u_id.reg | replace("FICR.", "") }}(0).read() as u64;
    id.to_be_bytes()
}
{% endif %}
{% if t.family != "stm32" %}

/// `bytes` in upper-case hex, in `buf` (twice their length)
fn hex(bytes: &[u8], buf: &'static mut [u8]) -> &'static str {
    const DIGITS: &[u8; 16] = b"0123456789ABCDEF";
    for (i, b) in bytes.iter().enumerate() {
        buf[2 * i] = DIGITS[(b >> 4) as usize];
        buf[2 * i + 1] = DIGITS[(b & 0xF) as usize];
    }
    core::str::from_utf8(buf).unwrap_or("")
}
{% endif %}

// Implementations of the {{ ww.trait }} methods. `method_model = "_=immediate"`: they return a result right away
// (`RpcResult` can also defer the reply, see wire_weaver::RpcResult). Plain `fn`s unless they await
// (`handler_model` below).
impl ServerState {
    fn led_on(&mut self, _cx: &mut Context<'_, impl EventOut>) -> RpcResult<()> {
{% if o.log != "none" %}
        {{ info }}("led on");
{% endif %}
{% if o.counters %}
        cnt!(led_on_calls: u32);
{% endif %}
{% if leds %}
        crate::led::set(crate::led::Mode::On);
{% else %}
        self.led.set_high();
{% endif %}
        Ready(())
    }

    fn led_off(&mut self, _cx: &mut Context<'_, impl EventOut>) -> RpcResult<()> {
{% if o.log != "none" %}
        {{ info }}("led off");
{% endif %}
{% if o.counters %}
        cnt!(led_off_calls: u32);
{% endif %}
{% if leds %}
        crate::led::set(crate::led::Mode::Off);
{% else %}
        self.led.set_low();
{% endif %}
        Ready(())
    }
}

mod server_impl {
    // Re-parses the API trait and generates request dispatch + serdes for ServerState.
    // To see the generated code, add: debug_to_file = "./target/ww_server.rs"
    wire_weaver::ww_codegen!(
        {{ ww.krate }} :: {{ ww.trait }} for super::ServerState,
        server = true, no_alloc = true, use_async = true,
{% if settings %}
        // handlers that await (flash writes) are async, all others plain `fn`s: an `async fn` that never awaits
        // still costs flash as a state of the dispatcher
        handler_model = "device.label.*|device.settings.*=async, _=sync",
{% else %}
        // plain `fn` handlers: none awaits (an `async fn` that never awaits still costs flash as a state of the
        // dispatcher)
        handler_model = "_=sync",
{% endif %}
        method_model = "_=immediate",
        property_model = "_=get_set",
        introspect = "with_docs",
{{ ("the board record and the chip ids are read at run time, the build id" ~ (" and the counter buffers are" if d.counters else " is") ~ " known at link time" ~ (", the defmt encoding at run time" if d.log else "") ~ " (ww/device.rs)") | doc(indent="        ", marker="//") }}
        const_model = "{{ feats("BOARD", "IDS", d.counters and "INFO", "BUILD_ID", d.log and "DEFMT") | join("|") }}=fn",
{{ ("left out: the optional build record, the board's reworks list" ~ (", label notes (no room in the settings)" if d.label else "") ~ (", counters.watch (a host polls `read` over " ~ ("USB" if ww.usb else "RTT") ~ ")" if d.counters else "")) | doc(indent="        ", marker="//") }}
        omit = [
            "device.firmware.BUILD_RECORD",
            "device.board.REWORKS",
{% if d.label %}
            "device.label.notes",
{% endif %}
{% if d.counters %}
            "device.counters.watch",
{% endif %}
        ],
    );
}

impl WireWeaverAsyncApiBackend for ServerState {
    type Medium = ();

    async fn process_bytes<'a>(
        &mut self,
        out: &mut EventWriter<'_, impl MessageSink>,
        medium: (),
        data: &[u8],
        scratch: &'a mut [u8],
    ) -> Result<&'a [u8], shrink_wrap::Error> {
        self.process_request_bytes(data, scratch, out, medium).await
    }

    fn version(&self) -> FullVersion<'_> {
        {{ ww.krate }}::{{ ww.gid }}
    }
}

