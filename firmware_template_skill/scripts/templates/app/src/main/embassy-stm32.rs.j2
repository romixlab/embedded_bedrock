{% set pw = s.led.pwm %}
{% if not pw %}
use embassy_stm32::gpio::{Level, Output, Speed};
{% endif %}
use embassy_time::Timer;
use cortex_m_rt::exception;
{% if o.supply_config %}
use embassy_stm32::rcc::SupplyConfig;
  {% if o.smps_voltage %}
use embassy_stm32::rcc::SMPSSupplyVoltage;
  {% endif %}
{% endif %}
{% if o.ww and ww.usb and ww.stm32_usb.hsi48 %}
use embassy_stm32::rcc::{Hsi48Config, mux};
{% endif %}
{% set clock = o.board.clock if o.board and o.board.clock else None %}
{% if clock %}
use {{ clock.use }};
{% endif %}
{% if o.bootloader %}
use core::cell::RefCell;
use embassy_boot_stm32::{AlignedBuffer, BlockingFirmwareUpdater, FirmwareUpdaterConfig};
use embassy_stm32::flash::{Flash, WRITE_SIZE};
use embassy_sync::blocking_mutex::Mutex;
{% endif %}

#[embassy_executor::main]
async fn main({{ "spawner" if o.ww or pw else "_spawner" }}: embassy_executor::Spawner) {
{% if s.dev.boot %}
    // First: may reset once (after the ROM bootloader's jump) or jump into the ROM bootloader (src/boot.rs)
    let early = boot::early();
{% endif %}
{% if have_init_ram %}
    init_ram::init_ram(); // enable + zero additional SRAM banks before anything is placed there
{% endif %}
{% include "app/src/main/_rtt_init.rs.j2" %}
    {{ info }}("{{ o.name }} starting...");
{% if s.dev.boot %}
    boot::log(&early);
{% endif %}
{% include "app/src/main/_last_reset_boot.rs.j2" %}
    let {{ "mut " if o.supply_config or clock or (o.ww and ww.usb and ww.stm32_usb.hsi48) else "" }}config = embassy_stm32::Config::default();
{% if o.supply_config %}
    config.rcc.supply_config = SupplyConfig::{{ o.supply_config }}{{ "(SMPSSupplyVoltage::%s)" % o.smps_voltage if o.smps_voltage else "" }}; // from schematic: how VCORE is supplied
{% endif %}
{% if clock %}
{{ clock.code }}
{%- else %}
    // TODO: configure config.rcc (clock tree) for your board
{% endif %}
{% if o.ww and ww.usb %}
  {% set u = ww.stm32_usb %}
  {% if u.hsi48 %}
    // USB clock: HSI48, trimmed by CRS from USB start-of-frame packets
    config.rcc.hsi48 = Some(Hsi48Config {
        sync_from_usb: true,
    });
    config.rcc.mux.{{ u.mux }} = mux::{{ u.mux_enum }}::{{ "Hsi48" if o.embassy == "main" else "HSI48" }};
  {% else %}
    // TODO: {{ u.periph }} needs an accurate 48 MHz clock (no HSI48 + CRS on this chip): HSE + PLL{{ ", config.rcc.mux." ~ u.mux if u.mux else "" }}
  {% endif %}
{% endif %}
    let p = embassy_stm32::init(config);
{% if t.series == "G0" %}
  {% if o.embassy == "release" %}
    // Flash prefetch: embassy-stm32 0.6 sets the flash wait states on the G0 but leaves PRFTEN off, so sequential
    // fetches stall with wait states (8-16% slower code at 64 MHz); embassy main turns it on itself (#7276).
    {% if es0548_bank2 %}
    // ES0548 2.2.10: on this dual-bank part prefetch can fail on a branch into the other flash bank, so all code has
    // to stay in bank 1 (memory.x stops the link otherwise); clear PRFTEN instead when the code outgrows it.
    {% endif %}
    embassy_stm32::pac::FLASH
        .acr()
        .modify(|w| w.set_prften(true));
  {% elif es0548_bank2 %}
    // embassy main turns flash prefetch on (#7276). ES0548 2.2.10: on this dual-bank part prefetch can fail on a
    // branch into the other flash bank, so all code has to stay in bank 1 (memory.x stops the link otherwise); clear
    // PRFTEN here (`embassy_stm32::pac::FLASH.acr().modify(|w| w.set_prften(false))`) when the code outgrows it.
  {% endif %}
{% endif %}
{% if have_init %}
    init::init();
{% endif %}
{% if t.series == "H7" %}

    let mut cp = cortex_m::Peripherals::take().unwrap();
    cp.SCB.enable_icache();
    // Enable D-cache only once DMA coherency is handled (cache clean/invalidate around DMA buffers)
    // cp.SCB.enable_dcache(&mut cp.CPUID);
{% endif %}
{% if s.dev.boot %}
    boot::after_init(spawner, &early); // the boot word again, the rescue after a boot loop, the reboot task
{% endif %}
{% if o.bootloader %}

    let flash = Mutex::new(RefCell::new(Flash::new_blocking(p.FLASH)));
    let config = FirmwareUpdaterConfig::from_linkerfile_blocking(&flash, &flash);
    let mut magic = AlignedBuffer([0; WRITE_SIZE]);
    let mut updater = BlockingFirmwareUpdater::new(config, &mut magic.0);
    {{ info }}("bootloader state: {{ "{}" if o.log == "defmt" else "{:?}" }}", updater.get_state());
    // TODO: call mark_booted() only after self-test; otherwise the bootloader reverts on next reset
    updater.mark_booted().unwrap();
{% endif %}
{% if o.settings_flash %}

    let {{ "" if o.ww else "mut " }}settings = settings::SettingsStore::load(p.FLASH).await;
  {% if o.log == "defmt" %}
    info!("label: {}", settings.get().label);
  {% elif o.log == "rtt" %}
    rprintln!("label: {}", settings.get().label);
  {% endif %}
{% endif %}

{% set spawn = "spawner.spawn(" ~ ("unwrap!(%s)" if o.log == "defmt" else "%s.unwrap()") ~ ");" %}
{% if pw %}
  {% set task = "led::led_task(p." ~ pw.timer ~ ", p." ~ o.led ~ ", " ~ ("led_mode" if s.led_at_boot else "led::DEFAULT_MODE") ~ ")" %}
  {% if s.led_at_boot %}
    // {{ s.led.Name }} breathes, or shines solid with led_at_boot (src/led.rs)
    let led_mode = if settings.get().led_at_boot {
        led::Mode::On
    } else {
        led::DEFAULT_MODE
    };
  {% else %}
    // {{ s.led.Name }} breathes (src/led.rs)
  {% endif %}
    {{ spawn | format(task) }}
{% elif s.led_at_boot %}
    let led_level = if settings.get().led_at_boot {
        Level::High
    } else {
        Level::Low
    };
    let led = Output::new(p.{{ o.led }}, led_level, Speed::Low);
{% else %}
    let {{ "" if o.ww else "mut " }}led = Output::new(p.{{ o.led }}, Level::Low, Speed::Low);
{% endif %}
{% include "app/src/main/_embassy_loop.rs.j2" %}
