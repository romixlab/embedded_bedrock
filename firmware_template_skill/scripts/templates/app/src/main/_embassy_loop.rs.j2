{# Common tail of the embassy main() bodies; `led` is an Output created by the caller (none when it breathes,
   s.led.pwm: src/led.rs owns it), `p` the peripherals. #}
{% if o.ww %}
  {% set args = feats(not s.led.pwm and "led", o.crash and "last_reset", o.settings_flash and "settings", s.uid.arg and "uid", s.pins and "pins") %}
  {% if s.pins %}
    // every free pin, for `pins` (src/pins.rs): take a pin out of its list there to use it here
    let pins = pins::Pins::new(pins::take!(p));
  {% endif %}

  {% if s.can %}
    // {{ s.can.names }}: `can[]` (src/can.rs, src/ww/can.rs)
    can::start(can::CanParts {
    {% for ch in s.can.chans %}
        {{ ch.lower }}: p.{{ ch.instance }},
        {{ ch.lower }}_tx: p.{{ ch.tx }},
        {{ ch.lower }}_rx: p.{{ ch.rx }},
      {% if ch.standby %}
        {{ ch.lower }}_standby: p.{{ ch.standby }},
      {% endif %}
    {% endfor %}
    });

  {% endif %}
    let state = ww::ServerState::new({{ args | join(", ") }}){{ ".await" if s.dev.log else "" }};
  {% if ww.usb %}
    let driver = ww::usb_driver({{ ww.usb_args }});
    ww::start(spawner, driver, state);
  {% elif s.dev.log %}
    ww::start(spawner, ww_up, ww_down, state);
  {% else %}
    ww::start(spawner, channels.up.{{ ww.rtt_up }}, channels.down.0, state);
  {% endif %}
{% endif %}
{% if o.build_info %}

    // Reference build info so it is retained in flash / ELF
    _ = core::hint::black_box(build_info::compact());
    _ = core::hint::black_box(build_info::full());
{% endif %}

    {{ info }}("init done");
    loop {
{% if o.settings_flash and not o.ww %}
        settings.persist_if_due().await; // changes made with settings.set(..) are written once they settle
{% endif %}
{% if o.ww or s.led.pwm %}
  {% if not s.led.pwm %}
        // the LED is switched over WireWeaver, see src/ww.rs
  {% elif not o.ww %}
        // {{ s.led.name }} breathes on its own (src/led.rs)
  {% endif %}
  {% if o.counters %}
        cnt!(loop_iterations: u32);
  {% endif %}
{% else %}
        led.toggle();
  {% if o.counters %}
        cnt!(led_toggles: u32);
  {% endif %}
{% endif %}
        Timer::after_millis(1000).await;
    }
}
