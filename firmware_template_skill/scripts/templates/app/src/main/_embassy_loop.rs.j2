{# Common tail of the embassy main() bodies; `led` is an Output created by the caller, `p` the peripherals. #}
{% if o.ww %}
  {% set fields = feats("led", o.crash and "last_reset", o.settings_flash and "settings") %}

  {% if o.settings_flash %}
    let state = ww::ServerState {
    {% for f in fields %}
        {{ f }},
    {% endfor %}
    };
    {% set state = "state" %}
  {% else %}
    {% set state = "ww::ServerState { " ~ (fields | join(", ")) ~ " }" %}
  {% endif %}
  {% if ww.usb %}
    let driver = ww::usb_driver({{ ww.usb_args }});
    ww::start(spawner, driver, {{ state }});
  {% elif o.settings_flash %}
    ww::start(spawner, channels.up.{{ ww.rtt_up }}, channels.down.0, state);
  {% else %}
    ww::start(
        spawner,
        channels.up.{{ ww.rtt_up }},
        channels.down.0,
        {{ state }},
    );
  {% endif %}
{% endif %}
{% if o.build_info %}

    // Reference build info so it is retained in flash / ELF
    _ = core::hint::black_box(build_info::compact());
    _ = core::hint::black_box(build_info::full());
{% endif %}

    {{ info }}("init done");
    loop {
{% if o.settings_flash and not o.ww %}
        settings.persist_if_due().await; // changes made with settings.set(..) are written once they settle
{% endif %}
{% if o.ww %}
        // the LED is switched over WireWeaver, see src/ww.rs
  {% if o.counters %}
        cnt!(loop_iterations: u32);
  {% endif %}
{% else %}
        led.toggle();
  {% if o.counters %}
        cnt!(led_toggles: u32);
  {% endif %}
{% endif %}
        Timer::after_millis(1000).await;
    }
}
