{% set pw = s.led.pwm %}
{% if not pw %}
use embassy_rp::gpio::{Level, Output};
{% endif %}
use embassy_time::Timer;
use cortex_m_rt::exception;
{% if o.bootloader %}
use core::cell::RefCell;
use embassy_boot_rp::{AlignedBuffer, BlockingFirmwareUpdater, FirmwareUpdaterConfig};
use embassy_rp::flash::{Flash, WRITE_SIZE};
use embassy_sync::blocking_mutex::Mutex;
const FLASH_SIZE: usize = {{ flash_size | hex }};
{% endif %}
{% if t.rp_variant != "rp2040" %}
// RP235x IMAGE_DEF block and boot2 (RP2040) are provided by embassy-rp (features imagedef-*/boot2-*)
{% endif %}

// embassy-rp ships its own executor (with multicore support), hence the explicit executor/entry
#[embassy_executor::main(
    executor = "embassy_rp::executor::Executor",
    entry = "cortex_m_rt::entry"
)]
async fn main({{ "spawner" if o.ww or pw else "_spawner" }}: embassy_executor::Spawner) {
{% if have_init_ram %}
    init_ram::init_ram();
{% endif %}
{% include "app/src/main/_rtt_init.rs.j2" %}
    {{ info }}("{{ o.name }} starting...");
{% include "app/src/main/_last_reset_boot.rs.j2" %}
{% if o.ww and s.uid.arg %}
    let mut p = embassy_rp::init(Default::default());
    // device.uid: the flash chip's unique id (the RP2040 has none), zeros when the read fails
    let mut uid = [0; {{ s.uid.len }}];
    let _ = embassy_rp::flash::Flash::<_, embassy_rp::flash::Blocking, {{ flash_size | hex }}>::new_blocking(
        p.FLASH.reborrow(),
    )
    .blocking_unique_id(&mut uid);
{% else %}
    let p = embassy_rp::init(Default::default());
{% endif %}
{% if s.dev.boot %}
    boot::after_init(spawner); // the reset into BOOTSEL device.boot.reboot asks for (src/boot.rs)
{% endif %}
{% if o.bootloader %}

    let flash = Flash::<_, embassy_rp::flash::Blocking, FLASH_SIZE>::new_blocking(p.FLASH);
    let flash = Mutex::new(RefCell::new(flash));
    let config = FirmwareUpdaterConfig::from_linkerfile_blocking(&flash, &flash);
    let mut magic = AlignedBuffer([0; WRITE_SIZE]);
    let mut updater = BlockingFirmwareUpdater::new(config, &mut magic.0);
    // TODO: call mark_booted() only after self-test
    updater.mark_booted().unwrap();
{% endif %}
{% if o.settings_flash %}

    let {{ "" if o.ww else "mut " }}settings = settings::SettingsStore::load(p.FLASH).await;
  {% if o.log == "defmt" %}
    info!("label: {}", settings.get().label);
  {% elif o.log == "rtt" %}
    rprintln!("label: {}", settings.get().label);
  {% endif %}
{% endif %}

{% set spawn = "spawner.spawn(" ~ ("unwrap!(%s)" if o.log == "defmt" else "%s.unwrap()") ~ ");" %}
{% if pw %}
  {% set task = "led::led_task(p." ~ pw.slice ~ ", p." ~ o.led ~ ", " ~ ("led_mode" if s.led_at_boot else "led::DEFAULT_MODE") ~ ")" %}
  {% if s.led_at_boot %}
    // {{ s.led.Name }} breathes, or shines solid with led_at_boot (src/led.rs)
    let led_mode = if settings.get().led_at_boot {
        led::Mode::On
    } else {
        led::DEFAULT_MODE
    };
  {% else %}
    // {{ s.led.Name }} breathes (src/led.rs)
  {% endif %}
  {% if ("unwrap!(" ~ task ~ ")") | length > 60 and o.log == "defmt" %}
    {# as rustfmt breaks it (spawn's argument past fn_call_width): one argument a line #}
    spawner.spawn(unwrap!(led::led_task(
        p.{{ pw.slice }},
        p.{{ o.led }},
        {{ "led_mode" if s.led_at_boot else "led::DEFAULT_MODE" }}
    )));
  {% else %}
    {{ spawn | format(task) }}
  {% endif %}
{% elif s.led_at_boot %}
    let led_level = if settings.get().led_at_boot {
        Level::{{ s.led.on }}
    } else {
        Level::{{ s.led.off }}
    };
    let led = Output::new(p.{{ o.led }}, led_level);
{% else %}
    let {{ "" if o.ww else "mut " }}led = Output::new(p.{{ o.led }}, Level::{{ s.led.off }});{{ " // active low: dark while high" if s.led.low else "" }}
{% endif %}
{% include "app/src/main/_embassy_loop.rs.j2" %}
