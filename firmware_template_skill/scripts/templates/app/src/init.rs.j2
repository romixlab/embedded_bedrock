/// Reset the backup (RTC) domain when the RTC is not used.
///
/// Contents of the backup domain survive resets but can be corrupted after a VBAT/VDD brown-out, leading to
/// hard to debug problems (LSE enabling itself, PC13/PC14/PC15 changing mode, ...).
/// See http://efton.sk/STM32/gotcha/g133.html and http://efton.sk/STM32/gotcha/g62.html
pub(crate) fn reset_backup_domain() {
    let rcc = pac::RCC;
    let pwr = pac::PWR;
{% include "app/src/_pwr_clock_on.rs.j2" %}
  {% if dbp and bdcr %}
    pwr.{{ dbp }}().modify(|w| w.set_dbp(true));
    let mut saved = pwr.{{ dbp }}().read(); // read back: write must pass the synchronizer first
    rcc.{{ bdcr }}().modify(|w| w.set_bdrst(true));
    rcc.{{ bdcr }}().modify(|w| w.set_bdrst(false));
    saved.set_dbp(false);
    pwr.{{ dbp }}().write_value(saved);
  {% else %}
    // TODO: set PWR.DBP, pulse RCC.BDCR.BDRST, clear DBP (register names not found in stm32-data)
    let _ = (rcc, pwr);
  {% endif %}
}
{% endif %}
