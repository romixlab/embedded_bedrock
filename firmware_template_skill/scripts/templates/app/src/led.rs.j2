{# The LED breathing on its timer channel (--led-mode breath, TPL-39): bedrock_led's Indication on embassy-stm32 PWM.
   `l` = s.led (name, pin, pwm: timer, ch, n, signal, driver), `s.leds`: served as `leds` (src/ww/leds.rs). #}
{% set l = s.led %}
{% set pw = l.pwm %}
{% set tim = pw.timer %}
{% if s.leds %}
//! {{ l.Name }} ({{ l.pin }}, {{ pw.signal }} PWM): breathes by default, solid on or off through `led_on` / `led_off`, shown through one
//! indication (`leds` in the API, src/ww/leds.rs): visible or not, a peak brightness, and [`identify`], which
//! blinks it for a while and then returns to the mode. The animation, its math and the task loop are embedded_bedrock's
{% if s.clock %}
//! `bedrock_led` (host-tested there); this module sets up the timer. While `crate::sync::SYNC` has shared time (a
//! host steers it, src/ww/clock.rs), breath and blink are aligned to it, so two boards on hosts with NTP breathe in
//! phase; free-running from the last mode change otherwise.
{% else %}
//! `bedrock_led` (host-tested there); this module sets up the timer.
{% endif %}
{% else %}
//! {{ l.Name }} ({{ l.pin }}, {{ pw.signal }} PWM) breathes. The animation, its math and the task loop are embedded_bedrock's
//! `bedrock_led` (host-tested there); this module sets up the timer. `LEDS.set(0, mode)` changes what it shows
//! (`bedrock_led::Mode`: breath, blink, solid on or off).
{% endif %}
//!
//! The time driver is {{ pw.driver | upper }} (`time-driver-{{ pw.driver }}` in Cargo.toml), named explicitly: `time-driver-any` picks one by
//! embassy's own order and may take {{ tim }}.

{# rustfmt orders the two by their braces ({Channel / {DEFAULT_PEAK / {Indication / {Mode) #}
{% set uses = [("{DEFAULT_PEAK, Mode, look};" if s.leds else "{Mode, look};", "pub "),
               (("{Channel, Indication" if pw.n else "{Indication, Pwm") ~ (", SharedTime" if s.clock) ~ "};", "")] %}
{% for items, vis in uses | sort(attribute=0) %}
{{ vis }}use bedrock_led::{{ items }}
{% endfor %}
use embassy_stm32::Peri;
use embassy_stm32::gpio::OutputType;
use embassy_stm32::peripherals::{{ "{" }}{{ l.pin }}, {{ tim }}{{ "}" }};
use embassy_stm32::time::{Hertz, khz};
{% if pw.n %}
use embassy_stm32::timer::complementary_pwm::{ComplementaryPwm, ComplementaryPwmPin};
{% endif %}
use embassy_stm32::timer::low_level::CountingMode;
{% if not pw.n %}
use embassy_stm32::timer::simple_pwm::{PwmPin, SimplePwm};
{% endif %}

{% if l.timer_mhz %}
/// 1 kHz: no flicker, {{ l.timer_mhz * 1000 }} steps of duty at {{ l.timer_mhz }} MHz
{% else %}
/// 1 kHz: no flicker; the duty has (timer clock / 1 kHz) steps
{% endif %}
const PWM_FREQ: Hertz = khz(1);

{% if s.led_at_boot %}
/// What {{ l.name }} shows after boot unless `device.settings.led_at_boot` says solid on.
{% else %}
/// What {{ l.name }} shows after boot.
{% endif %}
pub const DEFAULT_MODE: Mode = look::OK.mode;

static LEDS: Indication<1> = Indication::new();
{% if s.leds %}

{% if s.clock %}
/// Change {{ l.name }}'s mode. Takes effect on the next animation tick; breath and blink restart from dark (or at their
/// place in shared time).
{% else %}
/// Change {{ l.name }}'s mode. Takes effect on the next animation tick; breath and blink restart from dark.
{% endif %}
pub fn set(mode: Mode) {
    LEDS.set(0, mode);
}

/// Show or hide {{ l.name }} (default shown); its animation keeps running hidden.
pub fn set_visible(visible: bool) {
    LEDS.set_visible(0, visible);
}

/// Peak brightness (default [`DEFAULT_PEAK`]), without restarting the animation.
pub fn set_peak(peak: u8) {
    LEDS.set_peak(peak);
}

/// Blink {{ l.name }} at full brightness for `ms` (restarts a running identify, 0 ends it), then show the mode again.
pub fn identify(ms: u32) {
    LEDS.identify(ms);
}
{% endif %}
{% if pw.n %}

/// {{ pw.signal }}: the inverse of OC{{ pw.ch }}REF, so the compare value is inverted (CCR{{ pw.ch }} = max means off).
/// ComplementaryPwm has no embedded-hal `SetDutyCycle`.
struct Led {
    pwm: ComplementaryPwm<'static, {{ tim }}>,
    max: u32,
}

impl Channel for Led {
    fn max_duty(&self) -> u32 {
        self.max
    }

    fn set_duty(&mut self, duty: u32) {
        self.pwm
            .set_duty(embassy_stm32::timer::Channel::Ch{{ pw.ch }}, self.max - duty);
    }
}
{% endif %}

#[embassy_executor::task]
pub async fn led_task({{ tim | lower }}: Peri<'static, {{ tim }}>, {{ l.pin | lower }}: Peri<'static, {{ l.pin }}>, mode: Mode) {
{% if pw.n %}
    let mut pwm = ComplementaryPwm::new(
        {{ tim | lower }},
  {% for c in range(1, 5) %}
        None,
        {{ ("Some(ComplementaryPwmPin::new(" ~ (l.pin | lower) ~ ", OutputType::PushPull))") if c == pw.ch else "None" }},
  {% endfor %}
        PWM_FREQ,
        CountingMode::EdgeAlignedUp,
    );
    let max = pwm.get_max_duty();
    pwm.set_duty(embassy_stm32::timer::Channel::Ch{{ pw.ch }}, max);
    pwm.enable(embassy_stm32::timer::Channel::Ch{{ pw.ch }});
    let mut {{ l.var }} = Led { pwm, max };

{% if s.clock %}
    LEDS.run_with(
        [mode],
        || {
            crate::sync::SYNC.shared_now().map(|s| SharedTime {
                us: s.us,
                generation: s.generation,
            })
        },
        |leds| {{ l.var }}.set_level(leds.level(0)),
    )
    .await
{% else %}
    LEDS.run([mode], |leds| {{ l.var }}.set_level(leds.level(0))).await
{% endif %}
{% else %}
    let mut pwm = SimplePwm::new(
        {{ tim | lower }},
  {% for c in range(1, 5) %}
        {{ ("Some(PwmPin::new(" ~ (l.pin | lower) ~ ", OutputType::PushPull))") if c == pw.ch else "None" }},
  {% endfor %}
        PWM_FREQ,
        CountingMode::EdgeAlignedUp,
    );
    let mut ch = pwm.ch{{ pw.ch }}();
    ch.set_duty_cycle_fully_off();
    ch.enable();
    let mut {{ l.var }} = Pwm::new(ch);

{% if s.clock %}
    LEDS.run_with(
        [mode],
        || {
            crate::sync::SYNC.shared_now().map(|s| SharedTime {
                us: s.us,
                generation: s.generation,
            })
        },
        |leds| bedrock_led::Channel::set_level(&mut {{ l.var }}, leds.level(0)),
    )
    .await
{% else %}
    LEDS.run([mode], |leds| {
        bedrock_led::Channel::set_level(&mut {{ l.var }}, leds.level(0))
    })
    .await
{% endif %}
{% endif %}
}
