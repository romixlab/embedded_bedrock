{# ROM bootloader updates of a --wire-weaver firmware (bedrock_rom_boot, device.boot / device.dfu.node); s.boot #}
{% set b = s.boot %}
{% if b.kind == "rp" %}
//! Firmware updates through the RP boot ROM: `device.boot.reboot(Updater)` (src/ww/device.rs) resets into BOOTSEL,
//! where the ROM's PICOBOOT interface takes the new firmware (`ww dfu rp flash`, `just flash-bootsel`) and its USB
//! mass storage a UF2 file. The ROM reports the same USB serial number as this firmware, so a host follows the board
//! into BOOTSEL and back. The firmware sits alone in flash: the boot state is always `Confirmed`, there is nothing to
//! revert to (`bedrock_rom_boot::dfu`).

use bedrock_rom_boot::Reboot;
use defmt::{info, unwrap};
use embassy_executor::Spawner;
use embassy_sync::blocking_mutex::raw::CriticalSectionRawMutex;
use embassy_sync::signal::Signal;
use embassy_time::Timer;

/// A `device.boot.reboot` request, for [reboot_task]
static REBOOT: Signal<CriticalSectionRawMutex, Reboot> = Signal::new();
/// Time for the reply to reach the host before the reset (the USB stack sends it from its own task)
const REPLY_MS: u64 = 50;

/// Asks [reboot_task] to reset into `into`, [REPLY_MS] from now, so the reply goes out first.
pub fn request_reboot(into: Reboot) {
    REBOOT.signal(into);
}

/// After embassy's init: the reboot task.
pub fn after_init(spawner: Spawner) {
    spawner.spawn(unwrap!(reboot_task()));
}

/// Resets when `device.boot.reboot` asked for it, once its reply has left.
#[embassy_executor::task]
async fn reboot_task() {
    let into = REBOOT.wait().await;
    Timer::after_millis(REPLY_MS).await;
    if into == Reboot::Rom {
        info!("boot: reset into BOOTSEL");
  {% if t.rp_variant == "rp2040" %}
        // both interfaces (mass storage and PICOBOOT), no activity LED
  {% else %}
        // both interfaces (mass storage and PICOBOOT), no activity LED. The ROM's reboot() with a 10 ms delay: with
        // 0 it doesn't reboot (RP2350-E30, A2 to A4); nothing here sets FRCE_OFF bits (RP2350-E19, A2: the reboot
        // hangs with bits other than PROC1 set)
  {% endif %}
        embassy_rp::rom_data::reset_to_usb_boot(0, 0);
    }
    info!("boot: reset");
    cortex_m::peripheral::SCB::sys_reset();
}
{% else %}
//! Firmware updates through the STM32 ROM bootloader (`bedrock_rom_boot`): the early boot that runs first thing in
//! main, before clocks and embassy, the reboots `device.boot.reboot` asks for (src/ww/device.rs), and the boot-loop
//! rescue.
//!
{{ ("- `reboot(Updater)` writes the ROM request into the boot word (" ~ b.word ~ ", kept out of cnt's backup counters by memory.x) and resets; [early] finds it and jumps into the ROM bootloader. The ROM listens on USB DFU (" ~ b.usb ~ ") and on its other interfaces (AN2606); the probe reaches the chip whatever runs, so `just flash` works from the ROM too.") | doc(marker="//!", hang="  ") }}
{{ ("- A boot loop: every boot counts in the boot word, [healthy_task] clears the count once the firmware has run [HEALTHY_AFTER]" ~ (" (" ~ b.healthy ~ ")" if b.healthy else "") ~ ". After `bedrock_rom_boot::BOOT_LOOP_LIMIT` boots without that, [early] says `Start::Rescue` and main resets into the ROM bootloader; the next firmware reports it in `device.dfu.node` as `Outcome::Recovery`. Flashing four times within 10 s of each other counts the same way: the fourth boot lands in the ROM, the next flash comes back.") | doc(marker="//!", hang="  ") }}

use bedrock_rom_boot::{Early, Start};
use defmt::{error, info, unwrap, warn};
use embassy_executor::Spawner;
use embassy_time::Duration;

/// Up this long without a crash: the boot is healthy, the boot-loop count starts over.
pub const HEALTHY_AFTER: Duration = Duration::from_secs(10);

/// First thing in main, before embassy's init: resets once when the ROM bootloader jumped here, goes to the ROM
/// bootloader when asked to (never returns then), counts the boot otherwise.
pub fn early() -> Early {
    bedrock_rom_boot::early()
}

/// Logs what [early] found; once RTT is up.
pub fn log(early: &Early) {
    if let Some(entered) = early.jumped_before {
        info!(
            "boot: reset once after the ROM bootloader's jump ({})",
            entered
        );
    }
    if early.jumped_twice {
{% if bkp_words %}
        cnt::bkp_cnt!(rom_jumped_twice: u32, warn);
{% elif o.counters %}
        cnt::cnt!(rom_jumped_twice: u32, warn);
{% endif %}
        warn!("boot: entered by a jump twice in a row, going on");
    }
    if early.found.fell_back {
        warn!("boot: the ROM bootloader took over after a boot loop");
    }
    info!(
        "boot: {}, {} boots not yet healthy",
        early.start, early.word.unhealthy_boots
    );
}

/// After embassy's init: the boot word written again, the rescue when [early] said so, the boot's tasks.
pub fn after_init(spawner: Spawner, early: &Early) {
    bedrock_rom_boot::after_init();
    if early.start == Start::Rescue {
{% if b.rescue %}
        // {{ b.rescue }}
{% else %}
        // TODO: bring up what the ROM's USB needs on this board first (a USB switch, a hub), if anything
{% endif %}
        error!("boot: boot loop, resetting into the ROM bootloader");
        bedrock_rom_boot::rescue();
    }
    spawner.spawn(unwrap!(reboot_task()));
    spawner.spawn(unwrap!(healthy_task()));
}

/// Resets when `device.boot.reboot` asked for it, once its reply has left.
#[embassy_executor::task]
async fn reboot_task() {
    bedrock_rom_boot::reboot_when_asked().await
}

/// Marks the boot healthy after [HEALTHY_AFTER].
#[embassy_executor::task]
async fn healthy_task() {
    let why = bedrock_rom_boot::healthy_watch(HEALTHY_AFTER).await;
    info!("boot: healthy ({})", why);
}
{% endif %}
